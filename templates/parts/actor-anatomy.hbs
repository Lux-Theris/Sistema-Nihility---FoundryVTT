<section class="tab sheet-body {{tabs.anatomy.cssClass}}" data-group="primary" data-tab="anatomy">
    {{#if anatomy.banner.length}}
    <div class="anat-banner"><b>Vindo do corpo:</b> {{#each anatomy.banner as |b|}}{{b}}{{#unless @last}} · {{/unless}}{{/each}}</div>
    {{/if}}
    <ol class="item-list body-parts-list anat-list">
      {{#each anatomy.parts as |part|}}
      <li class="anat-part {{#if part.destroyed}}is-lost{{/if}} state-{{part.state}}" data-part-id="{{part.id}}" data-slot="{{part.slot}}">
        <div class="item-row" data-item-id="{{part.id}}">
          <span class="anat-name"><b>{{part.name}}</b> <span class="anat-slot">{{part.slot}}</span></span>
          {{#if part.isLost}}
          <span class="anat-hp"><span class="anat-state lost" title="A parte não existe mais: só Regeneração a traz de volta (ou uma prótese ocupa o lugar).">PERDIDA</span><span class="anat-num">só Regeneração</span></span>
          {{else}}
          <span class="anat-hp"><span class="anat-bar {{#if part.prosthetic}}pro{{/if}}"><i style="width:{{part.hpPct}}%"></i></span><span class="anat-num">{{part.hpValue}}/{{part.hpMax}}{{#if part.hpPercent}} · {{part.hpPercent}}%{{/if}}{{#if part.showState}} <span class="anat-state {{part.state}}">{{part.stateLabel}}</span>{{/if}}{{#if part.fixHint}} <span class="anat-fix">{{part.fixHint}}</span>{{/if}}</span></span>
          {{/if}}
          <span class="anat-fns">
            {{#each part.implants as |m|}}<span class="anat-imp {{#if m.prosthesis}}pro{{/if}}" title="{{#if m.prosthesis}}Prótese{{else}}Implante{{/if}}{{#if m.location}} · {{m.location}}{{/if}}">{{#if m.prosthesis}}⚙{{else}}◆{{/if}} {{m.name}}{{#if m.removable}}<a class="anat-imp-x" data-action="uninstallImplant" data-index="{{m.index}}" title="Remover (volta ao inventário)"><i class="fas fa-times"></i></a>{{/if}}</span>{{/each}}
            {{#each part.functions as |f|}}<span class="anat-fn {{#if f.off}}off{{/if}}">{{f.label}}</span>{{/each}}
          </span>
          {{#if (and @root.isGM @root.anatomy.injury)}}<a class="anat-lose" data-action="toggleBodyPartLost" title="{{#if part.isLost}}Desmarcar Perdida (a parte volta inutilizada){{else}}Marcar como Perdida (decepada){{/if}}"><i class="fas {{#if part.isLost}}fa-seedling{{else}}fa-bone{{/if}}"></i></a>{{else}}<span></span>{{/if}}
          <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
          <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{/each}}
    </ol>
    <p class="hint-inline">Arraste um Item com <b>Implante</b> ligado para uma parte para instalar. Implante soma Funções à parte natural; prótese substitui a parte.{{#unless anatomy.injury}} As Funções só têm efeito com "Ferimentos por parte" ligado em Módulos do Sistema.{{/unless}}</p>
    <a class="item-create" data-action="createItem" data-type="body_part">+ Nova Parte do Corpo</a>
</section>
