<div class="nihility-sheet item-sheet type-{{itemType}}">
  {{!--
    Layout do redesenho aprovado (artifact "Redesenho da Ficha de Item"): cabeçalho-resumo com
    chips, uma aba por pergunta, seções com título e grade de 2-3 colunas, rótulo sempre acima do
    campo, ajuda no (?) e controle segmentado pras escolhas de 2 a 5 opções. As peças de CSS
    (.sec, .fld, .seg, .strip, .toggle…) ficam no fim do stylesheet, sob `.item-sheet`.
  --}}

  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}"/>
    <div class="item-header-fields">
      <input name="name" type="text" value="{{item.name}}" placeholder="Nome" aria-label="Nome"/>
      {{#if headerChips.length}}
      <div class="item-header-chips">
        {{#each headerChips as |chip|}}<span class="item-chip {{chip.tone}}" title="{{chip.title}}">{{chip.label}}</span>{{/each}}
      </div>
      {{/if}}
    </div>
  </header>

  <nav class="sheet-tabs tabs item-tabs">
    {{#each tabs as |tab|}}
    <a class="item {{#if (eq tab.id ../activeTab)}}active{{/if}}" data-action="selectTab" data-tab="{{tab.id}}">
      {{#if tab.led}}<span class="tab-led {{#if tab.ledOn}}on{{/if}}"></span>{{/if}}{{tab.label}}{{#if tab.count}}<span class="tab-count">{{tab.count}}</span>{{/if}}
    </a>
    {{/each}}
  </nav>

  <section class="sheet-body">

    {{!-- Um único <prose-mirror name="system.description"> na ficha inteira: dois com o mesmo name no form duplicariam o texto a cada salvamento. --}}
    <div class="tab tab-description {{#unless (eq activeTab "description")}}hidden{{/unless}}">
      {{#if owner}}
      <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
      {{else}}
      <div class="rich-text-readonly">{{{system.description}}}</div>
      {{/if}}
    </div>

    {{!-- ============================== SKILL ============================== --}}
    {{#if (eq itemType "skill")}}

    {{!-- Geral --}}
    <div class="tab {{#unless (eq activeTab "general")}}hidden{{/unless}}">
      {{#if system.isItemGranted}}
      <div class="strip info"><i class="fas fa-link"></i><span>Concedida por um Item/Módulo e fixa: não ganha XP, não sobe de nível, não funde nem evolui. Para mudá-la, edite a Habilidade Concedida na fonte. Some se a fonte sair.</span></div>
      {{/if}}
      {{#if system.evolvedFrom}}
      <div class="strip gold"><i class="fas fa-level-up-alt"></i><span>Evoluiu de: {{system.evolvedFrom}}</span></div>
      {{/if}}

      <div class="sec">
        <div class="sec-head">Progressão</div>
        <div class="sec-body g2">
          <div class="fld">
            <span class="fld-label">Tier {{#unless isRacialSkill}}<span class="help" title="Ultimate só aparece para o jogador se o Ator já possuir uma Skill Ultimate. O Mestre sempre vê.">?</span>{{/unless}}</span>
            {{#if isRacialSkill}}
            <span class="locked-chip" title="Tier travado: Skill Racial vem da Espécie"><i class="fas fa-lock"></i> {{lookup config.SKILL_TIER_LABELS system.tier}}</span>
            {{else}}
            <select name="system.tier" aria-label="Tier">
              {{#each skillTierOptions as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
            </select>
            {{/if}}
          </div>
          <div class="fld">
            <span class="fld-label">Nível</span>
            <span class="fld-row">
              <input class="num narrow" type="number" name="system.level" value="{{system.level}}" min="1" aria-label="Nível" {{#unless isGM}}readonly{{/unless}}{{#if system.isItemGranted}} readonly{{/if}}/>
              {{#unless system.isItemGranted}}
              {{#if isGM}}<button type="button" class="btn gm" data-action="levelUpSkill" title="Level Up (Voz do Mundo avisa)">+ Nível</button>{{/if}}
              {{#if isGM}}{{#if item.parent}}<button type="button" class="btn gm" data-action="evolveSkill" title="Vira uma Skill nova; fica só o registro histórico">Evoluir</button>{{/if}}{{/if}}
              {{#if canSpendPointLevel}}<button type="button" class="btn" data-action="spendPointLevelUp" title="Gasta 1 Ponto de Habilidade do tier desta Skill ({{levelPointBalance}} disponível)">Subir nível (1 Ponto)</button>{{/if}}
              {{/unless}}
            </span>
          </div>
        </div>
      </div>

      <div class="sec">
        <div class="sec-head">Custo e ativação</div>
        <div class="sec-body g3">
          <label class="fld"><span class="fld-label">Custo de {{energyLabel}}</span><input class="num" type="number" name="system.cost" value="{{system.cost}}" min="0"/></label>
          <div class="fld">
            <span class="fld-label">Habilidade Ativa <span class="help" title="Liga/desliga. O Custo é pago ao ligar e o Custo por Rodada drena enquanto ela estiver ligada.">?</span></span>
            <label class="toggle"><input type="checkbox" name="system.hasUpkeep" {{#if system.hasUpkeep}}checked{{/if}}/><span class="toggle-track"></span><span>{{#if system.hasUpkeep}}Sim{{else}}Não{{/if}}</span></label>
          </div>
          {{#if system.hasUpkeep}}
          <label class="fld"><span class="fld-label">{{energyLabel}} por Rodada</span><input class="num" type="number" name="system.upkeepCost" value="{{system.upkeepCost}}" min="0"/></label>
          {{/if}}
          <div class="fld span-all">
            <label class="toggle"><input type="checkbox" name="system.variableMana" {{#if system.variableMana}}checked{{/if}}/><span class="toggle-track"></span><span>Aceita variar a {{energyLabel}}</span><span class="help" title="Ao usar, escolhe quanta {{energyLabel}} investir. Menos que o Custo enfraquece na mesma proporção; mais fortalece sem teto, mas cada {{energyLabel}} a mais rende menos que a anterior (curva e mínimo em Regras da Mesa). Numa Habilidade Ativa, o custo por rodada acompanha o investimento.">?</span></label>
          </div>
          <label class="fld"><span class="fld-label">Mágica <span class="help" title="Para a Antimagia. Automático: é mágica quando custa {{energyLabel}} (ou tem Dano Mágico). Magia que atravessa um campo antimagia (ou é usada sob um Selo) paga {{energyLabel}} extra ou é anulada.">?</span></span>
            <select name="system.magicTag">{{#each magicTagOptions as |opt|}}<option value="{{opt.id}}" {{#if (eq opt.id ../system.magicTag)}}selected{{/if}}>{{opt.label}}</option>{{/each}}</select></label>
        </div>
      </div>

      <div class="sec">
        <div class="sec-head">Apresentação</div>
        <div class="sec-body">
          <label class="fld"><span class="fld-label">Animação (Sequencer) <span class="help" title="Caminho opcional de um efeito do Sequencer. Sem o módulo Sequencer, o campo é ignorado.">?</span></span>
            <input class="mono" type="text" name="system.animationPath" value="{{system.animationPath}}" placeholder="modules/jb2a_patreon/Library/.../explosion.webm"/></label>
          <label class="fld"><span class="fld-label">Gatilho Emocional</span><input type="text" name="system.emotionTrigger" value="{{system.emotionTrigger}}"/></label>
        </div>
      </div>
    </div>

    {{!-- Mecânica --}}
    <div class="tab {{#unless (eq activeTab "mechanic")}}hidden{{/unless}}">
      <div class="fld">
        <span class="fld-label">Mecânica ao Usar</span>
        <div class="seg" role="radiogroup" aria-label="Mecânica ao Usar">
          {{#each skillEffectTypeSeg as |opt|}}
          <label class="seg-opt {{#if opt.checked}}on{{/if}}"><input type="radio" name="system.effectType" value="{{opt.value}}" {{#if opt.checked}}checked{{/if}}/>{{opt.label}}</label>
          {{/each}}
        </div>
      </div>

      {{#if (eq skillMechanicType "none")}}
      <div class="strip dim">Descritiva: usar a Skill não rola nem aplica nada. Ela ainda pode ter Passivos (Resistência, bônus…).</div>
      {{/if}}

      {{#if skillShowsTarget}}
      <div class="sec">
        <div class="sec-head">Alvo<span class="sp"></span><span class="depends">some se Descritiva ou Estrutura</span></div>
        <div class="sec-body">
          <div class="seg" role="radiogroup" aria-label="Tipo de Alvo">
            {{#each skillTargetTypeSeg as |opt|}}
            <label class="seg-opt {{#if opt.checked}}on{{/if}}" title="{{opt.title}}"><input type="radio" name="system.targetType" value="{{opt.value}}" {{#if opt.checked}}checked{{/if}}/>{{opt.label}}</label>
            {{/each}}
          </div>
          {{#if skillIsArea}}
          <div class="area-box">
            <div class="fld area-shape">
              <span class="fld-label">Formato de Área</span>
              <div class="seg" role="radiogroup" aria-label="Formato de Área">
                {{#each skillAreaShapeSeg as |opt|}}
                <label class="seg-opt {{#if opt.checked}}on{{/if}}"><input type="radio" name="system.areaShape" value="{{opt.value}}" {{#if opt.checked}}checked{{/if}}/>{{opt.label}}</label>
                {{/each}}
              </div>
            </div>
            <label class="fld"><span class="fld-label">Distância <span class="help" title="Raio do Círculo, ou alcance do Cone/Linha, em unidades de grid.">?</span></span><input class="num" type="number" name="system.areaDistance" value="{{system.areaDistance}}" min="0"/></label>
            {{#if (eq system.areaShape "cone")}}
            <label class="fld"><span class="fld-label">Ângulo (°)</span><input class="num" type="number" name="system.areaAngle" value="{{system.areaAngle}}" min="1" max="360"/></label>
            {{/if}}
            {{#if (eq system.targetType "zone")}}
            <label class="fld"><span class="fld-label">Duração da Zona <span class="help" title="Rodadas de combate: só avança em combate. O Mestre pode apagar a área antes.">?</span></span><span class="suffix"><input type="number" name="system.zoneRounds" value="{{system.zoneRounds}}" min="1" aria-label="Duração da Zona"/><span>rod.</span></span></label>
            {{/if}}
          </div>
          {{/if}}
        </div>
      </div>
      {{/if}}

      {{#if (eq skillMechanicType "structure")}}
      <div class="sec">
        <div class="sec-head">Estrutura<span class="sp"></span><span class="depends">Mecânica = Estrutura</span></div>
        <div class="sec-body">
          <label class="fld"><span class="fld-label">Qual Estrutura <span class="help" title="O formato, o tamanho e a Vida vêm do catálogo (Configurações Gerais › Estruturas). Skill Ativa com Estrutura sem prazo: ela fica até a Skill ser desligada.">?</span></span>
            <select name="system.structureId">
              <option value="">— escolha —</option>
              {{#each skillStructureOptions as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
            </select>
          </label>
          {{#if skillStructureSummary}}<div class="strip dim">{{skillStructureSummary}}</div>{{/if}}
        </div>
      </div>
      {{/if}}

      {{#if (eq skillMechanicType "damage")}}
      <div class="sec">
        <div class="sec-head">Dano<span class="sp"></span><span class="depends">Mecânica = Dano</span></div>
        <div class="sec-body g2">
          <label class="fld"><span class="fld-label">Fórmula de Dano</span><input class="mono" type="text" name="system.damageFormula" value="{{system.damageFormula}}" placeholder="2d6+3"/></label>
          <label class="fld"><span class="fld-label">Atributo de Escala <span class="help" title="Multiplica o dano por (Atributo.Total)² ÷ divisor. Sem escala, a fórmula vale como escrita.">?</span></span>
            <select name="system.scalingAttribute">
              {{#each skillScalingOptions as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
            </select>
          </label>
          <label class="toggle span-all"><input type="checkbox" name="system.isMagicDamage" {{#if system.isMagicDamage}}checked{{/if}}/><span class="toggle-track"></span><span>Dano Mágico</span><span class="help" title="Só esta opção decide se a Defesa Mágica reduz o dano. Os elementos são independentes dela.">?</span></label>
          <label class="toggle span-all"><input type="checkbox" name="system.isAbsoluteDamage" {{#if system.isAbsoluteDamage}}checked{{/if}}/><span class="toggle-track"></span><span>Dano Absoluto</span><span class="help" title="Não pode ser resistido (Defesa Mágica, Resistências, Imunidade, Escudo pessoal). Contra Nave, a Evasão ainda vale e o resto vai direto na Integridade Estrutural.">?</span></label>
          {{#if scaleEnabled}}
          <label class="fld"><span class="fld-label">Escala do golpe</span>
            <select name="system.damageScale">
              {{#each damageScaleOptions as |opt|}}<option value="{{opt.id}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
            </select>
          </label>
          {{/if}}
          <div class="fld span-all"><span class="fld-label">Elemento(s)</span>{{> nihility.elementChips field=skillElementField path="system.damageElements" editable=editable}}</div>
        </div>
      </div>
      {{/if}}

      {{#if (eq skillMechanicType "temporary")}}
      {{> nihility.effectCards effects=skillEffects hasUpkeep=system.hasUpkeep}}
      {{/if}}
    </div>

    {{!-- Passivos --}}
    <div class="tab {{#unless (eq activeTab "passive")}}hidden{{/unless}}">
      <div class="strip dim">Tudo nesta aba vale enquanto a Skill estiver na ficha, sem usar e sem escolher alvo (Habilidade Ativa: enquanto ligada).</div>

      {{#if inventoryEnabled}}
      <div class="sec">
        <div class="sec-head">Contêiner</div>
        <div class="sec-body g3">
          <label class="toggle span-all"><input type="checkbox" name="system.grantsContainer.enabled" {{#if system.grantsContainer.enabled}}checked{{/if}}/><span class="toggle-track"></span><span>Dá um contêiner (bolsa dimensional, estômago)</span><span class="help" title="Aparece na aba Inventário do dono, com slots próprios. Não ocupa slot.">?</span></label>
          {{#if system.grantsContainer.enabled}}
          <label class="fld"><span class="fld-label">Slots</span><input class="num" type="number" name="system.grantsContainer.slots" value="{{system.grantsContainer.slots}}" min="0"/></label>
          <label class="fld"><span class="fld-label">Redução de peso</span><span class="suffix"><input type="number" name="system.grantsContainer.weightReduction" value="{{system.grantsContainer.weightReduction}}" min="0" max="100" aria-label="Redução de peso"/><span>%</span></span></label>
          <label class="toggle"><input type="checkbox" name="system.grantsContainer.unlimited" {{#if system.grantsContainer.unlimited}}checked{{/if}}/><span class="toggle-track"></span><span>Ilimitado</span></label>
          {{/if}}
        </div>
      </div>
      {{/if}}

      {{#if resistancesEnabled}}
      <div class="sec">
        <div class="sec-head">Resistência / Imunidade</div>
        <div class="sec-body">
          <label class="fld"><span class="fld-label">Alvo <span class="help" title="Independente da Mecânica ao Usar: a Skill pode ter as duas coisas. Geral chega a 50% (nível 5); um Elemento chega a 100% (Imunidade) no nível 10.">?</span></span>
            <select name="system.resistanceTarget">
              {{#each skillResistanceOptions as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
            </select>
          </label>
          {{#if isResistanceSkill}}
          <div class="strip gold split"><span>{{skillResistanceName}} — {{resistancePercent}}%</span><span class="mono">nível {{system.level}} / {{resistanceMaxLevel}}</span></div>
          {{/if}}
        </div>
      </div>
      {{/if}}

      <div class="sec">
        <div class="sec-head">Modificador permanente</div>
        <div class="sec-body g2">
          <label class="fld"><span class="fld-label">HP Máximo</span><input class="num" type="number" name="system.statModifiers.hp" value="{{system.statModifiers.hp}}"/></label>
          <label class="fld"><span class="fld-label">{{energyLabel}} Máxima</span><input class="num" type="number" name="system.statModifiers.energy" value="{{system.statModifiers.energy}}"/></label>
        </div>
      </div>
      {{> nihility.regenBlock regen=system.regen energyLabel=energyLabel note="sempre; escala com o nível"}}

      <div class="sec">
        <div class="sec-head">Bônus de atributo<span class="sp"></span><span class="sec-head-note">rolagem, nunca HP/{{energyLabel}}</span></div>
        <div class="sec-body tight">
          {{#if system.attributeBonuses.length}}<div class="col-head pair-cols"><span>Atributo</span><span>Valor</span><span></span></div>{{/if}}
          {{#each system.attributeBonuses as |bonus index|}}
          <div class="pair-row" data-index="{{index}}">
            <select name="system.attributeBonuses.{{index}}.attribute" aria-label="Atributo">
              {{#each ../visibleAttributes as |attr|}}<option value="{{attr.key}}" {{#if (eq attr.key bonus.attribute)}}selected{{/if}}>{{attr.label}}</option>{{/each}}
            </select>
            <input class="num" type="number" name="system.attributeBonuses.{{index}}.amount" value="{{bonus.amount}}" aria-label="Valor"/>
            <a class="row-delete" data-action="deleteItemAttrBonus" title="Remover" aria-label="Remover"><i class="fas fa-trash"></i></a>
          </div>
          {{/each}}
          {{#if editable}}<a class="link-add" data-action="addItemAttrBonus">+ Bônus de Atributo</a>{{/if}}
        </div>
      </div>

      <div class="sec">
        <div class="sec-head">Bônus condicionais<span class="sp"></span><span class="sec-head-note">Quando → Então</span></div>
        <div class="sec-body">{{> nihility.conditionalModifiers rows=conditionalRows editable=editable}}</div>
      </div>
    </div>

    {{!-- Sub-Skills --}}
    <div class="tab {{#unless (eq activeTab "subskills")}}hidden{{/unless}}">
      <div class="sec">
        <div class="sec-head">Componentes<span class="sp"></span><span class="sec-head-note">o jogador escolhe um ao usar</span></div>
        <div class="sec-body tight">
          {{#each subSkillRows as |sub|}}
          <div class="subskill-row" data-index="{{sub.index}}">
            <span class="tier-chip tier-{{sub.tier}}">{{sub.tierLabel}}</span>
            <input type="text" name="system.subSkills.{{sub.index}}.name" value="{{sub.name}}" aria-label="Nome da Sub-Skill"/>
            <span class="subskill-mechanic">{{sub.mechanic}}</span>
            {{#if ../isGM}}<a data-action="editSubSkill" title="Editar mecânica e descrição" aria-label="Editar Sub-Skill"><i class="fas fa-edit"></i></a>{{/if}}
            <a class="row-delete" data-action="deleteSubSkill" title="Remover" aria-label="Remover Sub-Skill"><i class="fas fa-trash"></i></a>
          </div>
          {{else}}
          <p class="empty-note">Sem componentes. Uma Fusão preenche esta lista sozinha; também dá pra criar à mão.</p>
          {{/each}}
          {{#if editable}}<a class="link-add" data-action="addSubSkill">+ Sub-Skill</a>{{/if}}
        </div>
      </div>
      {{#if system.fusionSources.length}}
      <div class="sec">
        <div class="sec-head">Linhagem de fusão<span class="sp"></span><span class="sec-head-note">só leitura</span></div>
        <div class="sec-body"><div class="chip-row">{{#each system.fusionSources}}<span class="item-chip">{{this}}</span>{{/each}}</div></div>
      </div>
      {{/if}}
    </div>
    {{/if}}

    {{!-- ============================== TÍTULO ============================== --}}
    {{#if (eq itemType "title")}}
    <div class="tab {{#unless (eq activeTab "details")}}hidden{{/unless}}">
      <div class="sec">
        <div class="sec-head">Origem</div>
        <div class="sec-body g2">
          <label class="fld"><span class="fld-label">Concedido por</span><input type="text" name="system.grantedBy" value="{{system.grantedBy}}"/></label>
          <label class="fld"><span class="fld-label">Raridade</span><input type="text" name="system.rarity" value="{{system.rarity}}"/></label>
        </div>
      </div>

      {{> nihility.regenBlock regen=system.regen energyLabel=energyLabel note="sempre ativo"}}
      <div class="sec">
        <div class="sec-head">Bônus permanentes<span class="sp"></span><span class="sec-head-note">sempre ativos</span></div>
        <div class="sec-body tight">
          {{#if titleBonusRows.length}}<div class="col-head pair-cols"><span>Alvo</span><span>Valor</span><span></span></div>{{/if}}
          {{#each titleBonusRows as |row|}}
          <div class="pair-row" data-index="{{row.index}}">
            <select name="system.bonuses.{{row.index}}.attribute" aria-label="Alvo">
              {{#each row.groups as |group|}}
              <optgroup label="{{group.label}}">
                {{#each group.options as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
              </optgroup>
              {{/each}}
            </select>
            <input class="num" type="number" name="system.bonuses.{{row.index}}.amount" value="{{row.amount}}" aria-label="Valor"/>
            <a class="row-delete" data-action="deleteTitleBonus" title="Remover" aria-label="Remover"><i class="fas fa-trash"></i></a>
          </div>
          {{/each}}
          {{#if editable}}<a class="link-add" data-action="addTitleBonus">+ Bônus</a>{{/if}}
        </div>
      </div>

      {{#if resistancesEnabled}}
      <div class="sec">
        <div class="sec-head">Resistência a dano<span class="sp"></span><span class="sec-head-note">% fixo, sem nível</span></div>
        <div class="sec-body tight">
          {{#each titleResistances as |res index|}}
          <div class="pair-row" data-index="{{index}}">
            <select name="system.resistances.{{index}}.target" aria-label="Alvo">
              {{#each res.targetOptions as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
            </select>
            <span class="suffix"><input type="number" name="system.resistances.{{index}}.amount" value="{{res.amount}}" min="0" max="100" aria-label="Percentual"/><span>%</span></span>
            <a class="row-delete" data-action="deleteTitleResistance" title="Remover" aria-label="Remover"><i class="fas fa-trash"></i></a>
          </div>
          {{/each}}
          {{#if editable}}<a class="link-add" data-action="addTitleResistance">+ Resistência</a>{{/if}}
        </div>
      </div>
      {{/if}}

      <div class="sec">
        <div class="sec-head">Bônus condicionais<span class="sp"></span><span class="sec-head-note">Quando → Então</span></div>
        <div class="sec-body">{{> nihility.conditionalModifiers rows=conditionalRows editable=editable}}</div>
      </div>
    </div>
    {{/if}}

    {{!-- ============================== MÓDULO DE NAVE ============================== --}}
    {{#if (eq itemType "starship_module")}}
    <div class="tab {{#unless (eq activeTab "spec")}}hidden{{/unless}}">
      <div class="sec">
        <div class="sec-head">Identidade</div>
        <div class="sec-body">
          <div class="fld">
            <span class="fld-label">Categoria <span class="help" title="O número no bloco é quantas cabem por Nave (vagas). Categorias e Funções ficam em Configurações Gerais › Categorias de Módulo.">?</span></span>
            <div class="tiles" role="radiogroup" aria-label="Categoria">
              {{#each moduleCategoryOptions as |cat|}}
              <label class="tile {{#if cat.selected}}on{{/if}}" title="Função: {{cat.roleLabel}}"><input type="radio" name="system.category" value="{{cat.id}}" {{#if cat.selected}}checked{{/if}}/>{{cat.label}}{{#if cat.slots}}<span class="tile-slots">{{cat.slots}}</span>{{/if}}</label>
              {{/each}}
            </div>
          </div>
          <div class="fld">
            <span class="fld-label">Porte do Módulo</span>
            <div class="seg" role="radiogroup" aria-label="Porte do Módulo">
              {{#each moduleSizeSeg as |opt|}}
              <label class="seg-opt {{#if opt.checked}}on{{/if}}"><input type="radio" name="system.moduleSize" value="{{opt.value}}" {{#if opt.checked}}checked{{/if}}/>{{opt.label}}</label>
              {{/each}}
            </div>
          </div>
          <div class="strip info"><i class="fas fa-sync-alt"></i><span>Trocar a Categoria ou o Porte sugere de novo os valores que ainda estão no padrão. Valor editado à mão não muda.</span></div>
        </div>
      </div>

      <div class="strip dim">Especificação de fábrica. Vida atual, throttle, ligado/desligado, prioridade de energia e recarga são estado e se editam na ficha da Nave.</div>

      <div class="sec">
        <div class="sec-head">Energia e estrutura</div>
        <div class="sec-body g2">
          <label class="fld"><span class="fld-label">Consumo de Energia</span><span class="suffix"><input type="number" name="system.powerConsumption" value="{{system.powerConsumption}}" aria-label="Consumo"/><span>{{energyAbbr}}</span></span></label>
          <label class="fld"><span class="fld-label">Vida Máx.</span><input class="num" type="number" name="system.hp.max" value="{{system.hp.max}}" min="0"/></label>
          <label class="fld"><span class="fld-label">Slot</span><input type="text" name="system.slot" value="{{system.slot}}"/></label>
          <label class="fld"><span class="fld-label">Endurecimento <span class="help" title="Reduz a chance de efeitos de sistema de elemento pegarem neste Módulo (derrubar, drenar energia, baixar resistência). A Classe da Nave soma o dela. 30% transforma 20% de chance em 14%.">?</span></span><span class="suffix"><input type="number" name="system.hardening" value="{{system.hardening}}" min="0" max="100" aria-label="Endurecimento"/><span>%</span></span></label>
        </div>
      </div>

      <div class="sec var">
        <div class="sec-head">Parâmetros · {{moduleRoleLabel}}<span class="sp"></span><span class="depends">muda com a Categoria</span></div>
        {{#if (eq moduleRole "power")}}
        <div class="sec-body g2">
          <label class="fld"><span class="fld-label">Output (a 100% de clock)</span><span class="suffix"><input type="number" name="system.reactorOutput" value="{{system.reactorOutput}}" min="0" aria-label="Output"/><span>{{energyAbbr}}</span></span></label>
        </div>
        {{/if}}
        {{#if (eq moduleRole "storage")}}
        <div class="sec-body g2">
          <label class="fld"><span class="fld-label">Capacidade de Armazenamento</span><span class="suffix"><input type="number" name="system.batteryCapacity" value="{{system.batteryCapacity}}" min="0" aria-label="Capacidade"/><span>{{energyAbbr}}</span></span></label>
        </div>
        {{/if}}
        {{#if (eq moduleRole "distribution")}}
        <div class="sec-body">
          <label class="fld narrow-fld"><span class="fld-label">Fator de Distribuição <span class="help" title="Multiplica o baseline do Porte da Nave.">?</span></span><span class="suffix prefix"><span>×</span><input type="number" name="system.transferFactor" value="{{system.transferFactor}}" min="0" step="0.1" aria-label="Fator"/></span></label>
          {{#if distributorPreview}}
          <div class="factor-preview">
            <p class="factor-preview-title">Capacidade de Transferência que este Fator entrega</p>
            <table>
              <thead><tr><th>Porte da Nave</th><th>Baseline</th><th>Resultado</th></tr></thead>
              <tbody>
                {{#each distributorPreview.rows as |row|}}
                <tr class="{{#if row.current}}is-current{{/if}}">
                  <td>{{row.label}}{{#if row.current}} <span class="factor-here">instalado aqui</span>{{/if}}</td>
                  <td class="num">{{row.baseline}}</td>
                  <td class="num strong">{{row.result}} {{../distributorPreview.abbr}}/rodada</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
            <p class="empty-note">É o teto da Nave inteira por rodada, não de cada Módulo.</p>
          </div>
          {{/if}}
        </div>
        {{/if}}
        {{#if (eq moduleRole "shield")}}
        <div class="sec-body g3">
          <label class="fld"><span class="fld-label">Vida Máxima <span class="help" title="A 100% de throttle.">?</span></span><input class="num" type="number" name="system.shieldCapacity" value="{{system.shieldCapacity}}" min="0"/></label>
          <label class="fld"><span class="fld-label">Regen por Rodada <span class="help" title="A 100% de throttle.">?</span></span><input class="num" type="number" name="system.shieldRegen" value="{{system.shieldRegen}}" min="0"/></label>
          <label class="fld"><span class="fld-label">Recarga <span class="help" title="Rodadas sem proteção depois que o Escudo zera.">?</span></span><span class="suffix"><input type="number" name="system.shieldRechargeRounds" value="{{system.shieldRechargeRounds}}" min="0" aria-label="Recarga"/><span>rod.</span></span></label>
          <label class="fld"><span class="fld-label">Resistência à Penetração <span class="help" title="Tirada da Penetração da arma no estágio do Escudo (Penetração 40% contra 15% = 25%). Com vários Escudos, vale a maior entre os ligados. A Classe soma a dela.">?</span></span><span class="suffix"><input type="number" name="system.penetrationResist" value="{{system.penetrationResist}}" min="0" max="100" aria-label="Resistência à Penetração"/><span>%</span></span></label>
          <div class="fld span-all"><span class="fld-label">Elemento do escudo <span class="help" title="Escudo de plasma, de antiprótons…: a vantagem entre elementos vale contra a camada de Escudo. Vários Escudos ligados somam os elementos.">?</span></span>{{> nihility.elementChips field=shieldElementField path="system.shieldElements" editable=editable}}</div>
          <label class="toggle span-all"><input type="checkbox" name="system.adaptive" {{#if system.adaptive}}checked{{/if}}/><span class="toggle-track"></span><span>Adaptativo</span><span class="help" title="Cada golpe que chega no Escudo de pé ensina o Escudo: +X% de resistência àquele elemento, na frequência das armas de quem atacou, até o teto. Perde tudo quando o Escudo cai ou o Módulo desliga. Quem atacou pode Modular frequência para recomeçar do zero.">?</span></label>
          {{#if system.adaptive}}
          <label class="fld"><span class="fld-label">Adapta por golpe</span><span class="suffix"><input type="number" name="system.adaptStep" value="{{system.adaptStep}}" min="0" max="95" aria-label="Adapta por golpe"/><span>%</span></span></label>
          <label class="fld"><span class="fld-label">Teto <span class="help" title="Nunca acima de 95%: sempre passa algo.">?</span></span><span class="suffix"><input type="number" name="system.adaptCap" value="{{system.adaptCap}}" min="0" max="95" aria-label="Teto da adaptação"/><span>%</span></span></label>
          <p class="hint-inline span-all">{{#if adaptationRows.length}}Adaptado agora: {{#each adaptationRows as |row|}}{{row.label}} {{row.percent}}%{{#unless @last}} · {{/unless}}{{/each}}{{else}}Ainda sem adaptação.{{/if}}</p>
          {{/if}}
        </div>
        {{/if}}
        {{#if (eq moduleRole "propulsion")}}
        <div class="sec-body g2">
          <label class="fld"><span class="fld-label">Aceleração <span class="help" title="A 100% de throttle. Vários Motores somam.">?</span></span><input class="num" type="number" name="system.acceleration" value="{{system.acceleration}}" min="0"/></label>
          <label class="fld"><span class="fld-label">Rotação <span class="help" title="A 100% de throttle. Vários Motores somam.">?</span></span><input class="num" type="number" name="system.rotation" value="{{system.rotation}}" min="0"/></label>
        </div>
        {{/if}}
        {{#if (eq moduleRole "armor")}}
        <div class="sec-body g2">
          <label class="fld"><span class="fld-label">Redução de Dano <span class="help" title="Reduz esse percentual do dano que passa pelo Casco enquanto ele tiver Vida.">?</span></span><span class="suffix"><input type="number" name="system.armorReduction" value="{{system.armorReduction}}" min="0" max="100" aria-label="Redução de Dano"/><span>%</span></span></label>
          <label class="fld"><span class="fld-label">Resistência à Penetração <span class="help" title="Tirada da Penetração da arma no estágio do Casco. A Classe soma a dela.">?</span></span><span class="suffix"><input type="number" name="system.penetrationResist" value="{{system.penetrationResist}}" min="0" max="100" aria-label="Resistência à Penetração"/><span>%</span></span></label>
        </div>
        {{/if}}
        {{#if (eq moduleRole "weapon")}}
        <div class="sec-body g3">
          <label class="fld"><span class="fld-label">Fórmula de Dano</span><input class="mono" type="text" name="system.damageFormula" value="{{system.damageFormula}}" placeholder="3d10"/></label>
          <label class="fld"><span class="fld-label">Penetração <span class="help" title="Valor a 100% de throttle.">?</span></span><span class="suffix"><input type="number" name="system.penetration" value="{{system.penetration}}" min="0" max="100" aria-label="Penetração"/><span>%</span></span></label>
          <label class="fld"><span class="fld-label">Recarga <span class="help" title="Rodadas, a 100% de throttle. 0 = sempre disponível para disparar.">?</span></span><span class="suffix"><input type="number" name="system.cooldownRounds" value="{{system.cooldownRounds}}" min="0" aria-label="Recarga"/><span>rod.</span></span></label>
          <label class="toggle span-all"><input type="checkbox" name="system.isAbsoluteDamage" {{#if system.isAbsoluteDamage}}checked{{/if}}/><span class="toggle-track"></span><span>Dano Absoluto</span><span class="help" title="Passa por Escudo e Casco direto pra Integridade Estrutural. A Evasão do alvo ainda vale.">?</span></label>
          <div class="fld span-all"><span class="fld-label">Elemento(s)</span>{{> nihility.elementChips field=moduleElementField path="system.damageElements" editable=editable}}</div>
          <label class="toggle span-all"><input type="checkbox" name="system.usesAmmo" {{#if system.usesAmmo}}checked{{/if}}/><span class="toggle-track"></span><span>Usa munição (lançador)</span><span class="help" title="Dispara Munição do Porão: a fórmula, os elementos e o Absoluto vêm da munição; a Penetração soma. Sem munição compatível, não dispara.">?</span></label>
          {{#if system.usesAmmo}}
          <div class="fld span-all"><span class="fld-label">Aceita</span>
            <span class="element-field">{{#each launcherAmmoChips as |chip|}}<a class="element-chip {{#if chip.checked}}checked{{/if}}" data-action="toggleAmmoType" data-ammo-type="{{chip.id}}">{{chip.label}}</a>{{/each}}</span></div>
          {{/if}}
        </div>
        {{/if}}
        {{#if (eq moduleRole "cargo")}}
        <div class="sec-body g2">
          <label class="fld"><span class="fld-label">Multiplicador de slots <span class="help" title="Porão compactado 1,5; carga frágil 0,75. Slots = tabela do Porte × isto.">?</span></span><input class="num" type="number" step="0.05" min="0" name="system.cargoMultiplier" value="{{system.cargoMultiplier}}"/></label>
          <p class="empty-note">Slots deste Porão: <strong>{{cargoSlotsPreview}}</strong> (Compacto 10 · Standard 20 · Robusto 40 · Industrial 80 · Colossal 160, × o multiplicador). Vários Porões somam.</p>
        </div>
        {{/if}}
        {{#if (eq moduleRole "tractor")}}
        <div class="sec-body"><p class="empty-note">Ligado, ganha o botão 🧲 na ficha da Nave para prender outra Nave/Veículo (força pela diferença de Porte; throttle acima de 100% segura mais).</p></div>
        {{/if}}
        {{#if (eq moduleRole "ftl")}}
        <div class="sec-body">
          <div class="seg" role="radiogroup" aria-label="Sub-tipo de FTL">
            <label class="seg-opt {{#if (eq system.ftlType "warp")}}on{{/if}}"><input type="radio" name="system.ftlType" value="warp" {{#if (eq system.ftlType "warp")}}checked{{/if}}/>Dobra Espacial</label>
            <label class="seg-opt {{#if (eq system.ftlType "jump")}}on{{/if}}"><input type="radio" name="system.ftlType" value="jump" {{#if (eq system.ftlType "jump")}}checked{{/if}}/>Salto</label>
          </div>
          {{#if (eq system.ftlType "jump")}}
          <div class="g2 inner-grid">
            <label class="fld"><span class="fld-label">Alcance de Salto</span><input class="num" type="number" name="system.jumpRange" value="{{system.jumpRange}}" min="0"/></label>
            <label class="fld"><span class="fld-label">Tempo de Carga</span><span class="suffix"><input type="number" name="system.chargeTime" value="{{system.chargeTime}}" min="0" aria-label="Tempo de Carga"/><span>rod.</span></span></label>
          </div>
          {{else}}
          <label class="fld narrow-fld"><span class="fld-label">Fator de Dobra <span class="help" title="A 100% de throttle.">?</span></span><input class="num" type="number" name="system.warpFactor" value="{{system.warpFactor}}" min="0" step="0.1"/></label>
          {{/if}}
        </div>
        {{/if}}
        {{#if (eq moduleRole "utility")}}
        <div class="sec-body"><p class="empty-note">Sem parâmetros próprios: Vida, consumo e a <a data-action="selectTab" data-tab="grant">Habilidade Concedida</a>.</p></div>
        {{/if}}
      </div>
    </div>

    <div class="tab {{#unless (eq activeTab "grant")}}hidden{{/unless}}">
      <div class="strip dim">Concedida à Nave enquanto o Módulo estiver online. Ligar/desligar o Módulo na ficha da Nave concede/remove.</div>
      <div class="sec">
        <div class="sec-head">Habilidade Concedida</div>
        <div class="sec-body">{{> nihility.grantedSkill grant=grantSummary editable=editable}}</div>
      </div>
    </div>
    {{/if}}

    {{!-- ============================== ITEM GERAL ============================== --}}
    {{#if (eq itemType "item")}}
    <div class="tab {{#unless (eq activeTab "general")}}hidden{{/unless}}">
      <div class="sec">
        <div class="sec-head">Inventário</div>
        <div class="sec-body inventory-grid">
          <label class="fld"><span class="fld-label">Quantidade</span><input class="num" type="number" name="system.quantity" value="{{system.quantity}}"/></label>
          <label class="fld"><span class="fld-label">Peso</span><input class="num" type="number" name="system.weight" value="{{system.weight}}" step="any"/></label>
          <label class="fld"><span class="fld-label">Empilha até <span class="help" title="Quantos cabem num slot do inventário. Quantidade acima disso ocupa mais slots.">?</span></span><input class="num" type="number" name="system.stackSize" value="{{system.stackSize}}" min="1"/></label>
          <div class="fld">
            <span class="fld-label">Valor</span>
            <span class="joined">
              <input class="num" type="number" name="system.value.amount" value="{{system.value.amount}}" aria-label="Valor"/>
              <select name="system.value.currency" aria-label="Moeda">
                {{#each currencies as |currency|}}<option value="{{currency.id}}" {{#if (eq currency.id ../system.value.currency)}}selected{{/if}}>{{currency.label}}</option>{{/each}}
              </select>
            </span>
          </div>
        </div>
      </div>

      <div class="sec">
        <div class="sec-head">Uso</div>
        <div class="sec-body">
          <label class="toggle"><input type="checkbox" class="item-equip-toggle" name="system.equipped" {{#if system.equipped}}checked{{/if}}/><span class="toggle-track"></span><span>Equipado</span></label>
          <p class="empty-note">Ligado: concede a Habilidade, ativa os bônus da aba <a data-action="selectTab" data-tab="equipped">Enquanto equipado</a> e, se for arma, libera o Atacar. Desligado: remove a Habilidade.</p>
          <label class="toggle"><input type="checkbox" name="system.magic" {{#if system.magic}}checked{{/if}}/><span class="toggle-track"></span><span>Mágico</span><span class="help" title="A Antimagia (Condição Suprimido) desliga os bônus deste Item enquanto durar — e os do implante feito dele. Sem a marca, o Item é mundano: a Antimagia não o alcança.">?</span></label>
        </div>
      </div>

      <div class="sec">
        <div class="sec-head">Contêiner</div>
        <div class="sec-body g3">
          <label class="toggle span-all"><input type="checkbox" name="system.container.enabled" {{#if system.container.enabled}}checked{{/if}}/><span class="toggle-track"></span><span>Este item guarda outros (mochila, bolsa, cinto)</span><span class="help" title="Ocupa sempre 1 slot de quem o carrega, vestido ou não. O que está dentro usa os slots dele e pesa menos.">?</span></label>
          {{#if system.container.enabled}}
          <label class="fld"><span class="fld-label">Slots</span><input class="num" type="number" name="system.container.slots" value="{{system.container.slots}}" min="0"/></label>
          <label class="fld"><span class="fld-label">Redução de peso</span><span class="suffix"><input type="number" name="system.container.weightReduction" value="{{system.container.weightReduction}}" min="0" max="100" aria-label="Redução de peso"/><span>%</span></span></label>
          {{/if}}
        </div>
      </div>

      <div class="sec">
        <div class="sec-head">Munição</div>
        <div class="sec-body g3">
          <label class="toggle span-all"><input type="checkbox" name="system.ammo.enabled" {{#if system.ammo.enabled}}checked{{/if}}/><span class="toggle-track"></span><span>Este item é munição</span><span class="help" title="Nave: fica no Porão; um lançador que aceita o tipo dela rola a fórmula DELA, soma a Penetração dela e gasta 1 da pilha. Arma pessoal com Carregador: o Recarregar gasta 1 desta pilha se o Tipo estiver entre os aceitos pela arma; fórmula, elementos e Dano Absoluto preenchidos aqui substituem os da arma até a próxima recarga.">?</span></label>
          {{#if system.ammo.enabled}}
          <label class="fld"><span class="fld-label">Disparos (aberta) <span class="help" title="0 = cheia (enche o carregador). Maior que 0 = unidade aberta, tirada de uma arma numa troca: dá só esses disparos e não empilha com as cheias.">?</span></span><input class="num" type="number" min="0" name="system.ammo.rounds" value="{{system.ammo.rounds}}"/></label>
          <label class="fld"><span class="fld-label">Tipo</span>
            <select name="system.ammo.type">{{#each ammoTypeOptions as |opt|}}<option value="{{opt.id}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}</select></label>
          <label class="fld"><span class="fld-label">Fórmula de Dano</span><input class="mono" type="text" name="system.ammo.damageFormula" value="{{system.ammo.damageFormula}}" placeholder="4d10"/></label>
          <label class="fld"><span class="fld-label">Penetração extra</span><span class="suffix"><input type="number" name="system.ammo.penetrationBonus" value="{{system.ammo.penetrationBonus}}" min="0" max="100" aria-label="Penetração extra"/><span>%</span></span></label>
          <label class="fld"><span class="fld-label">Lançador mínimo <span class="help" title="Torpedo pesado só em lançador Robusto ou maior.">?</span></span>
            <select name="system.ammo.minLauncherSize">{{#each ammoSizeOptions as |opt|}}<option value="{{opt.id}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}</select></label>
          <label class="toggle"><input type="checkbox" name="system.ammo.isAbsoluteDamage" {{#if system.ammo.isAbsoluteDamage}}checked{{/if}}/><span class="toggle-track"></span><span>Dano Absoluto</span></label>
          <div class="fld span-all"><span class="fld-label">Elemento(s) <span class="help" title="Os efeitos por camada (Escudo, Casco, Integridade) vêm dos elementos. Vazio = os do lançador.">?</span></span>{{> nihility.elementChips field=ammoElementField path="system.ammo.damageElements" editable=editable}}</div>
          {{/if}}
        </div>
      </div>

      {{#if isGM}}
      <div class="sec gm-sec">
        <div class="sec-head"><i class="fas fa-lock"></i> Mestre<span class="sp"></span><span class="sec-head-note">só o Mestre vê</span></div>
        <div class="sec-body">
          <label class="toggle"><input type="checkbox" name="system.isPadDevice" {{#if system.isPadDevice}}checked{{/if}}/><span class="toggle-track"></span><span>Dispositivo PAD</span><span class="help" title="Quem tiver ao menos um Item PAD ganha o botão Abrir PAD na própria ficha. Não precisa estar equipado.">?</span></label>
        </div>
      </div>
      {{/if}}
    </div>

    <div class="tab {{#unless (eq activeTab "weapon")}}hidden{{/unless}}">
      <div class="sec">
        <div class="sec-body">
          <label class="toggle"><input type="checkbox" name="system.weapon.enabled" {{#if system.weapon.enabled}}checked{{/if}}/><span class="toggle-track"></span><span>Este item é uma arma</span><span class="help" title="Põe o botão Atacar na ficha do dono, só enquanto o item estiver equipado.">?</span></label>
        </div>
      </div>
      {{#if system.weapon.enabled}}
      <div class="sec">
        <div class="sec-head">Dano</div>
        <div class="sec-body g2">
          <label class="fld"><span class="fld-label">Fórmula de Dano</span><input class="mono" type="text" name="system.weapon.damageFormula" value="{{system.weapon.damageFormula}}" placeholder="1d8+2"/></label>
          <label class="fld"><span class="fld-label">Atributo de Escala <span class="help" title="Multiplica o dano por (Atributo.Total)² ÷ divisor, igual às Skills. Sem escala, a fórmula vale como escrita.">?</span></span>
            <select name="system.weapon.scalingAttribute">
              {{#each weaponScalingOptions as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
            </select>
          </label>
          <label class="toggle span-all"><input type="checkbox" name="system.weapon.isMagicDamage" {{#if system.weapon.isMagicDamage}}checked{{/if}}/><span class="toggle-track"></span><span>Dano Mágico</span></label>
          <label class="toggle span-all"><input type="checkbox" name="system.weapon.isAbsoluteDamage" {{#if system.weapon.isAbsoluteDamage}}checked{{/if}}/><span class="toggle-track"></span><span>Dano Absoluto</span><span class="help" title="Não pode ser resistido (Defesa Mágica, Resistências, Imunidade, Escudo pessoal). Contra Nave, a Evasão ainda vale.">?</span></label>
          {{#if scaleEnabled}}
          <label class="fld"><span class="fld-label">Escala do golpe <span class="help" title="Uma bazuca anti-tanque pode ser Veículo mesmo na mão de uma pessoa.">?</span></span>
            <select name="system.weapon.damageScale">
              {{#each weaponScaleOptions as |opt|}}<option value="{{opt.id}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
            </select>
          </label>
          {{/if}}
          <div class="fld span-all"><span class="fld-label">Elemento(s)</span>{{> nihility.elementChips field=weaponElementField path="system.weapon.damageElements" editable=editable}}</div>
        </div>
      </div>
      <div class="sec">
        <div class="sec-head">Carregador<span class="sp"></span>{{#if weaponLoadedLabel}}<span class="sec-head-note">carregado: {{weaponLoadedLabel}}</span>{{/if}}</div>
        <div class="sec-body g2">
          <label class="fld"><span class="fld-label">Disparos por carga <span class="help" title="0 = sem carregador: ataca sem limite, como sempre. Com carregador, cada Atacar gasta 1; vazio, o botão Recarregar gasta 1 munição compatível do inventário e enche.">?</span></span><input class="num" type="number" min="0" name="system.weapon.magazineSize" value="{{system.weapon.magazineSize}}"/></label>
          {{#if system.weapon.magazineSize}}
          <label class="fld"><span class="fld-label">Disparos agora</span><input class="num" type="number" min="0" name="system.weapon.loaded" value="{{system.weapon.loaded}}"/></label>
          <div class="fld span-all"><span class="fld-label">Munição aceita <span class="help" title="Itens Gerais marcados como Munição (aba Geral) de um destes tipos. Nenhum marcado = aceita qualquer munição. A fórmula, os elementos e o Dano Absoluto da munição carregada valem nos disparos.">?</span></span>
            <span class="element-field">{{#each weaponAmmoChips as |chip|}}<a class="element-chip {{#if chip.checked}}checked{{/if}}" data-action="toggleWeaponAmmoType" data-ammo-type="{{chip.id}}">{{chip.label}}</a>{{else}}<span class="hint-inline">Nenhum tipo de munição no catálogo (Configurações Gerais › Munição).</span>{{/each}}</span></div>
          {{/if}}
        </div>
      </div>
      {{else}}
      <div class="strip dim">Desligado, o item não ataca. Os valores de arma já salvos continuam guardados.</div>
      {{/if}}
    </div>

    <div class="tab {{#unless (eq activeTab "consumable")}}hidden{{/unless}}">
      <div class="sec">
        <div class="sec-body">
          <label class="toggle"><input type="checkbox" name="system.consumable.enabled" {{#if system.consumable.enabled}}checked{{/if}}/><span class="toggle-track"></span><span>Este item é um consumível</span><span class="help" title="Põe o botão Usar na linha do inventário (não precisa estar equipado). Cada uso gasta 1 da pilha, ou 1 carga. A última unidade some da ficha.">?</span></label>
        </div>
      </div>
      {{#if system.consumable.enabled}}
      <div class="fld">
        <span class="fld-label">O que faz ao usar</span>
        <div class="seg" role="radiogroup" aria-label="O que faz ao usar">
          {{#each consumableEffectTypeSeg as |opt|}}
          <label class="seg-opt {{#if opt.checked}}on{{/if}}"><input type="radio" name="system.consumable.effectType" value="{{opt.value}}" {{#if opt.checked}}checked{{/if}}/>{{opt.label}}</label>
          {{/each}}
        </div>
      </div>
      <div class="sec">
        <div class="sec-head">Em quem</div>
        <div class="sec-body">
          <div class="seg" role="radiogroup" aria-label="Em quem">
            {{#each consumableTargetSeg as |opt|}}
            <label class="seg-opt {{#if opt.checked}}on{{/if}}" title="{{opt.title}}"><input type="radio" name="system.consumable.targetType" value="{{opt.value}}" {{#if opt.checked}}checked{{/if}}/>{{opt.label}}</label>
            {{/each}}
          </div>
          {{#if consumableIsArea}}
          <div class="area-box">
            <div class="fld area-shape">
              <span class="fld-label">Formato de Área</span>
              <div class="seg" role="radiogroup" aria-label="Formato de Área">
                {{#each consumableAreaSeg as |opt|}}
                <label class="seg-opt {{#if opt.checked}}on{{/if}}"><input type="radio" name="system.consumable.areaShape" value="{{opt.value}}" {{#if opt.checked}}checked{{/if}}/>{{opt.label}}</label>
                {{/each}}
              </div>
            </div>
            <label class="fld"><span class="fld-label">Distância <span class="help" title="Raio do Círculo, ou alcance do Cone/Linha, em unidades de grid. Sem mapa, vira um alvo só.">?</span></span><input class="num" type="number" name="system.consumable.areaDistance" value="{{system.consumable.areaDistance}}" min="0"/></label>
            {{#if (eq system.consumable.areaShape "cone")}}
            <label class="fld"><span class="fld-label">Ângulo (°)</span><input class="num" type="number" name="system.consumable.areaAngle" value="{{system.consumable.areaAngle}}" min="1" max="360"/></label>
            {{/if}}
          </div>
          {{/if}}
        </div>
      </div>
      {{#if consumableIsDamage}}
      <div class="sec">
        <div class="sec-head">Dano<span class="sp"></span><span class="depends">O que faz = Dano</span></div>
        <div class="sec-body g2">
          <label class="fld"><span class="fld-label">Fórmula de Dano</span><input class="mono" type="text" name="system.consumable.damageFormula" value="{{system.consumable.damageFormula}}" placeholder="3d6"/></label>
          <label class="fld"><span class="fld-label">Atributo de Escala <span class="help" title="Multiplica o dano por (Atributo de quem usa)² ÷ divisor, igual a arma e Skill — é o que faz uma granada continuar valendo em nível alto. Sem escala, a fórmula vale como escrita.">?</span></span>
            <select name="system.consumable.scalingAttribute">
              {{#each consumableScalingOptions as |opt|}}<option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
            </select>
          </label>
          <label class="toggle span-all"><input type="checkbox" name="system.consumable.isMagicDamage" {{#if system.consumable.isMagicDamage}}checked{{/if}}/><span class="toggle-track"></span><span>Dano Mágico</span><span class="help" title="Defesa Mágica reduz, e a Antimagia alcança.">?</span></label>
          <div class="fld span-all"><span class="fld-label">Elemento(s)</span>{{> nihility.elementChips field=consumableElementField path="system.consumable.damageElements" editable=editable}}</div>
        </div>
      </div>
      {{else}}
      {{> nihility.effectCards effects=consumableEffects hasUpkeep=false}}
      {{/if}}
      <div class="sec">
        <div class="sec-head">Usos</div>
        <div class="sec-body g2">
          <label class="fld"><span class="fld-label">Cargas por unidade <span class="help" title="Kit médico de 5 usos = 5. Cada Usar gasta 1 carga; ao zerar, sai 1 da pilha e a próxima começa cheia. 0 ou 1 = cada uso gasta uma unidade.">?</span></span><input class="num" type="number" min="0" name="system.consumable.charges" value="{{system.consumable.charges}}"/></label>
          {{#if (gt system.consumable.charges 1)}}
          <label class="fld"><span class="fld-label">Cargas gastas da unidade aberta</span><input class="num" type="number" min="0" name="system.consumable.chargesUsed" value="{{system.consumable.chargesUsed}}"/></label>
          {{/if}}
        </div>
      </div>
      {{else}}
      <div class="strip dim">Desligado, o item não tem botão Usar. Os valores já salvos continuam guardados.</div>
      {{/if}}
    </div>

    <div class="tab {{#unless (eq activeTab "implant")}}hidden{{/unless}}">
      <div class="sec">
        <div class="sec-body">
          <label class="toggle"><input type="checkbox" name="system.implant.enabled" {{#if system.implant.enabled}}checked{{/if}}/><span class="toggle-track"></span><span>Este Item é um implante ou prótese</span><span class="help" title="Arraste o Item para uma Parte do Corpo na aba Anatomia para instalar. Remover devolve o Item ao inventário.">?</span></label>
        </div>
      </div>
      {{#if system.implant.enabled}}
      <div class="fld"><span class="fld-label">Tipo</span>
        <div class="seg">
          <label class="seg-opt {{#if implantIsProsthesis}}on{{/if}}"><input type="radio" name="system.implant.kind" value="prosthesis" {{#if implantIsProsthesis}}checked{{/if}}/>Prótese · substitui a parte</label>
          <label class="seg-opt {{#unless implantIsProsthesis}}on{{/unless}}"><input type="radio" name="system.implant.kind" value="implant" {{#unless implantIsProsthesis}}checked{{/unless}}/>Implante · aprimora a parte</label>
        </div>
      </div>
      <div class="sec">
        <div class="sec-head">Onde encaixa</div>
        <div class="sec-body g2">
          <div class="fld span-all"><span class="fld-label">Serve nos slots <span class="help" title="Os slots vêm das partes de todas as Espécies (head, arm, leg, tail, wing…). Nenhum marcado = cabe em qualquer parte.">?</span></span>
            <span class="element-field">{{#each implantSlotChips as |chip|}}<a class="element-chip {{#if chip.checked}}checked{{/if}}" data-action="toggleImplantList" data-list="fitsSlots" data-value="{{chip.id}}">{{chip.id}}</a>{{/each}}</span></div>
          <label class="fld"><span class="fld-label">Onde, dentro da parte</span><input type="text" name="system.implant.location" value="{{system.implant.location}}" placeholder="Mão"/></label>
          {{#if implantIsProsthesis}}<label class="fld"><span class="fld-label">Vida da prótese <span class="help" title="Vira a Vida da parte enquanto instalada. Prótese não é curada nem regenerada: só Reparo (ou a Regeneração de uma Skill Única ou Ultimate).">?</span></span><input class="num" type="number" min="1" name="system.implant.hp" value="{{system.implant.hp}}"/></label>
          <div class="fld-row span-all">
            <span class="fld-label">Vida conta como <span class="help" title="% do portador: a Vida é esse % da Vida máxima de quem usa, e cresce com ele (padrão). Fixa: pontos que não crescem — uma perna de pau vira papel em nível alto, de propósito.">?</span></span>
            <div class="seg compact" role="radiogroup" aria-label="Vida conta como">
              <label class="seg-opt {{#unless implantHpFixed}}on{{/unless}}"><input type="radio" name="system.implant.hpMode" value="percent" {{#unless implantHpFixed}}checked{{/unless}}/>% da Vida do portador</label>
              <label class="seg-opt {{#if implantHpFixed}}on{{/if}}"><input type="radio" name="system.implant.hpMode" value="fixed" {{#if implantHpFixed}}checked{{/if}}/>Fixa</label>
            </div>
          </div>{{/if}}
        </div>
      </div>
      <div class="sec">
        <div class="sec-head">Funções <span class="depends">muda com Tipo</span></div>
        <div class="sec-body">
          <span class="element-field">{{#each implantFunctionChips as |chip|}}<a class="element-chip {{#if chip.checked}}checked{{/if}}" data-action="toggleImplantList" data-list="functions" data-value="{{chip.id}}">{{chip.label}}</a>{{/each}}</span>
          <p class="hint-inline">{{#if implantIsProsthesis}}Prótese: estas são as Funções da parte (as naturais saem).{{else}}Implante: estas se somam às da parte natural, e param se ela for destruída.{{/if}}</p>
        </div>
      </div>
      <div class="strip info">Bônus de atributo, Vida/Mana e Habilidade Concedida ficam na aba "Enquanto instalado".</div>
      {{else}}
      <div class="strip dim">Desligado, o Item não pode ser instalado numa Parte do Corpo.</div>
      {{/if}}
    </div>

    <div class="tab {{#unless (eq activeTab "equipped")}}hidden{{/unless}}">
      <div class="strip dim">{{#if system.implant.enabled}}Vale enquanto o implante estiver instalado numa Parte do Corpo. Instalar concede a Habilidade; remover tira.{{else}}Vale só enquanto o item estiver equipado. Equipar concede a Habilidade; desequipar remove.{{/if}}</div>
      <div class="sec">
        <div class="sec-head">Habilidade Concedida</div>
        <div class="sec-body">{{> nihility.grantedSkill grant=grantSummary editable=editable}}</div>
      </div>
      <div class="sec">
        <div class="sec-head">Modificador permanente</div>
        <div class="sec-body g2">
          <label class="fld"><span class="fld-label">HP Máximo</span><input class="num" type="number" name="system.statModifiers.hp" value="{{system.statModifiers.hp}}"/></label>
          <label class="fld"><span class="fld-label">{{energyLabel}} Máxima</span><input class="num" type="number" name="system.statModifiers.energy" value="{{system.statModifiers.energy}}"/></label>
        </div>
      </div>
      {{> nihility.regenBlock regen=system.regen energyLabel=energyLabel note="enquanto equipado"}}
      <div class="sec">
        <div class="sec-head">Bônus de atributo<span class="sp"></span><span class="sec-head-note">rolagem, nunca HP/{{energyLabel}}</span></div>
        <div class="sec-body tight">
          {{#if system.attributeBonuses.length}}<div class="col-head pair-cols"><span>Atributo</span><span>Valor</span><span></span></div>{{/if}}
          {{#each system.attributeBonuses as |bonus index|}}
          <div class="pair-row" data-index="{{index}}">
            <select name="system.attributeBonuses.{{index}}.attribute" aria-label="Atributo">
              {{#each ../visibleAttributes as |attr|}}<option value="{{attr.key}}" {{#if (eq attr.key bonus.attribute)}}selected{{/if}}>{{attr.label}}</option>{{/each}}
            </select>
            <input class="num" type="number" name="system.attributeBonuses.{{index}}.amount" value="{{bonus.amount}}" aria-label="Valor"/>
            <a class="row-delete" data-action="deleteItemAttrBonus" title="Remover" aria-label="Remover"><i class="fas fa-trash"></i></a>
          </div>
          {{/each}}
          {{#if editable}}<a class="link-add" data-action="addItemAttrBonus">+ Bônus de Atributo</a>{{/if}}
        </div>
      </div>
      <div class="sec">
        <div class="sec-head">Bônus condicionais<span class="sp"></span><span class="sec-head-note">Quando → Então</span></div>
        <div class="sec-body">{{> nihility.conditionalModifiers rows=conditionalRows editable=editable}}</div>
      </div>
    </div>
    {{/if}}

    {{!-- ============================== PARTE DO CORPO ============================== --}}
    {{#if (eq itemType "body_part")}}
    <div class="tab {{#unless (eq activeTab "details")}}hidden{{/unless}}">
      <div class="sec">
        <div class="sec-head">Identidade</div>
        <div class="sec-body g2">
          <label class="fld"><span class="fld-label">Slot</span><input type="text" name="system.slot" value="{{system.slot}}"/></label>
          <label class="fld"><span class="fld-label">Origem (Espécie)</span><input type="text" name="system.speciesOrigin" value="{{system.speciesOrigin}}"/></label>
        </div>
      </div>
      <div class="sec">
        <div class="sec-head">Vida</div>
        <div class="sec-body g3">
          <label class="fld"><span class="fld-label">% da Vida <span class="help" title="Vida da parte em % da Vida máxima do personagem (com buffs): cresce junto, e subir de nível ou ganhar um buff mantém a proporção. 0 = Vida fixa (o máximo ao lado).">?</span></span><input class="num" type="number" min="0" step="1" name="system.hpPercent" value="{{system.hpPercent}}"/></label>
          <div class="fld">
            <span class="fld-label">Vida</span>
            <span class="fld-row"><input class="num" type="number" name="system.hp.value" value="{{system.hp.value}}" aria-label="Vida atual"/><span class="of">/</span><input class="num" type="number" name="system.hp.max" value="{{system.hp.max}}" aria-label="Vida máxima" {{#if system.hpPercent}}readonly title="Calculada pelo % da Vida do personagem"{{/if}}/></span>
          </div>
          <div class="fld">
            <span class="fld-label">Prótese</span>
            <label class="toggle"><input type="checkbox" name="system.isProsthetic" {{#if system.isProsthetic}}checked{{/if}}/><span class="toggle-track"></span><span>{{#if system.isProsthetic}}Protética{{else}}Natural{{/if}}</span></label>
          </div>
          <div class="fld">
            <span class="fld-label">Perdida <span class="help" title="A parte não existe mais (decepada). Cura não traz de volta; só Regeneração. Com prótese instalada, vale a prótese.">?</span></span>
            <label class="toggle"><input type="checkbox" name="system.lost" {{#if system.lost}}checked{{/if}}/><span class="toggle-track"></span><span>{{#if system.lost}}Perdida{{else}}Presente{{/if}}</span></label>
          </div>
        </div>
      </div>
    </div>

    <div class="tab {{#unless (eq activeTab "mods")}}hidden{{/unless}}">
      {{#each system.installedMods as |mod index|}}
      <div class="sec mod-card" data-index="{{index}}">
        <div class="sec-head">
          <input class="sec-head-input" type="text" name="system.installedMods.{{index}}.name" value="{{mod.name}}" placeholder="Nome da modificação" aria-label="Nome da modificação"/>
          <span class="sp"></span>
          <a class="row-delete" data-action="deleteInstalledMod" title="Remover modificação" aria-label="Remover modificação"><i class="fas fa-trash"></i></a>
        </div>
        <div class="sec-body">
          <label class="fld"><span class="fld-label">Descrição</span><input type="text" name="system.installedMods.{{index}}.description" value="{{mod.description}}"/></label>
          <div class="fld">
            <span class="fld-label">Habilidade Concedida</span>
            {{> nihility.grantedSkill grant=(lookup ../modGrantSummaries index) editable=../editable}}
            <button type="button" class="btn" data-action="toggleModGrant" data-index="{{index}}">{{#if mod.skillGranted}}Remover Habilidade da ficha{{else}}Conceder Habilidade à ficha{{/if}}</button>
          </div>
          <div class="g2 inner-grid">
            <label class="fld"><span class="fld-label">HP Máximo</span><input class="num" type="number" name="system.installedMods.{{index}}.statModifiers.hp" value="{{mod.statModifiers.hp}}"/></label>
            <label class="fld"><span class="fld-label">{{../energyLabel}} Máxima</span><input class="num" type="number" name="system.installedMods.{{index}}.statModifiers.energy" value="{{mod.statModifiers.energy}}"/></label>
          </div>
          <div class="fld">
            <span class="fld-label">Bônus de atributo <span class="help" title="Soma na rolagem; nunca entra no HP/Mana.">?</span></span>
            {{#each mod.attributeBonuses as |bonus bIndex|}}
            <div class="pair-row" data-index="{{index}}" data-bonus-index="{{bIndex}}">
              <select name="system.installedMods.{{index}}.attributeBonuses.{{bIndex}}.attribute" aria-label="Atributo">
                {{#each ../../visibleAttributes as |attr|}}<option value="{{attr.key}}" {{#if (eq attr.key bonus.attribute)}}selected{{/if}}>{{attr.label}}</option>{{/each}}
              </select>
              <input class="num" type="number" name="system.installedMods.{{index}}.attributeBonuses.{{bIndex}}.amount" value="{{bonus.amount}}" aria-label="Valor"/>
              <a class="row-delete" data-action="deleteModAttrBonus" title="Remover" aria-label="Remover"><i class="fas fa-trash"></i></a>
            </div>
            {{/each}}
            {{#if ../editable}}<a class="link-add" data-action="addModAttrBonus" data-index="{{index}}">+ Bônus de Atributo</a>{{/if}}
          </div>
        </div>
      </div>
      {{else}}
      <p class="empty-note">Nenhuma modificação ou prótese instalada.</p>
      {{/each}}
      {{#if editable}}<a class="link-add" data-action="addInstalledMod">+ Modificação/Prótese</a>{{/if}}
    </div>
    {{/if}}

  </section>
</div>
