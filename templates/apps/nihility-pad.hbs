<div class="pad-device">

  <div class="pad-statusbar">
    <span class="pad-signal"><span class="pad-signal-bars"><i></i><i></i><i></i><i></i></span>{{actor.name}}</span>
    {{#if padClock}}<span class="pad-clock" title="Hora do mundo"><i class="fa-regular fa-clock"></i> {{padClock}}</span>{{/if}}
    <span class="pad-battery"><span class="pad-battery-icon"><span class="pad-battery-fill"></span></span></span>
  </div>

  <div class="pad-topbar {{#if (eq activeScreen "home")}}hidden{{/if}}">
    <a class="pad-back" data-action="goBack" title="Voltar"><i class="fas fa-chevron-left"></i></a>
    <h2>
      {{#if (eq activeScreen "nave")}}Nave{{/if}}
      {{#if (eq activeScreen "biblioteca")}}Biblioteca{{/if}}
      {{#if (eq activeScreen "mensagens")}}{{#if activeThread}}{{threadTitle}}{{else}}Mensagens{{/if}}{{/if}}
      {{#if (eq activeScreen "compras")}}Compras{{/if}}
    </h2>
    {{#if (and (eq activeScreen "mensagens") isGM)}}
    <button type="button" class="pad-gm-chip" data-action="togglePersonaPicker" title="Escolher com qual Personagem/NPC falar">
      <span>Só Mestre</span>
      Falando como: {{actor.name}} ▾
    </button>
    {{/if}}
  </div>

  {{#if isGM}}
  <div class="pad-persona-picker hidden">
    <div class="pad-persona-search-row">
      <input type="text" class="pad-persona-search" placeholder="Buscar personagem ou NPC…"/>
    </div>
    <div class="pad-persona-list">
      <p class="pad-persona-group-label">Personagens</p>
      {{#each personaPcs as |p|}}
      <button type="button" class="pad-persona-row" data-action="selectPersona" data-actor-uuid="{{p.uuid}}" data-search="{{p.searchName}}">
        <img src="{{p.img}}"/><span class="p-name">{{p.name}}</span>
      </button>
      {{/each}}
      <p class="pad-persona-group-label">NPCs</p>
      {{#each personaNpcs as |p|}}
      <button type="button" class="pad-persona-row is-npc" data-action="selectPersona" data-actor-uuid="{{p.uuid}}" data-search="{{p.searchName}}">
        <img src="{{p.img}}"/><span class="p-name">{{p.name}}</span>
      </button>
      {{/each}}
    </div>
  </div>
  {{/if}}

  <div class="pad-content">

    <section class="pad-screen pad-screen-home {{#unless (eq activeScreen "home")}}hidden{{/unless}}">
      {{!-- O nome em destaque só pro Mestre: pro jogador é redundante (já está na barra de
            status logo acima, e ele sabe de quem é o próprio PAD), enquanto pro Mestre é o
            aviso de QUAL persona está ativa antes de mandar mensagem como ela. --}}
      {{#if isGM}}<p class="pad-home-head">{{actor.name}}</p>{{/if}}
      {{#if padTime}}
      <div class="pad-time pad-time-{{padTime.state}}">
        <div class="pad-time-clock">{{padTime.text}}</div>
        {{#if padTime.dateText}}<div class="pad-time-date">{{padTime.dateText}}</div>{{/if}}
        <div class="pad-time-status">{{padTime.statusLine}}</div>
        {{#if padTime.canRequest}}<button type="button" class="pad-time-btn" data-action="requestTimeSync"><i class="fa-solid fa-rotate"></i> Atualizar</button>{{/if}}
      </div>
      {{/if}}
      <p class="pad-home-sub">{{#if selectedShip}}Vinculado à {{selectedShip.name}} · sinal estável{{else}}PAD Pessoal · sinal estável{{/if}}</p>
      <div class="pad-icon-grid">

        {{#if padShipEnabled}}
        {{#if crewedShips.length}}
        <button type="button" class="pad-icon" data-action="openApp" data-pad="nave">
          <span class="pad-icon-tile"><i class="fas fa-rocket"></i></span>
          Nave
        </button>
        {{else}}
        <button type="button" class="pad-icon disabled" data-action="openApp" data-pad="nave" title="Você não está tripulando nenhuma Nave/Veículo no momento">
          <span class="pad-icon-tile"><i class="fas fa-rocket"></i></span>
          Nave
        </button>
        {{/if}}
        {{/if}}

        {{#if padLibraryEnabled}}
        <button type="button" class="pad-icon" data-action="openApp" data-pad="biblioteca">
          <span class="pad-icon-tile"><i class="fas fa-book"></i></span>
          Biblioteca
        </button>
        {{/if}}

        {{#if padMessagingEnabled}}
        <button type="button" class="pad-icon" data-action="openApp" data-pad="mensagens">
          <span class="pad-icon-tile"><i class="fas fa-comment-dots"></i></span>
          Mensagens
        </button>
        {{/if}}

        {{#if padShop.available}}
        <button type="button" class="pad-icon {{#unless padShop.net.ok}}disabled{{/unless}}" data-action="openApp" data-pad="compras" {{#unless padShop.net.ok}}title="Sem conexão: {{padShop.net.reason}}"{{/unless}}>
          <span class="pad-icon-tile"><i class="fas fa-bag-shopping"></i></span>
          Compras
        </button>
        {{/if}}

      </div>
    </section>

    <section class="pad-screen {{#unless (eq activeScreen "nave")}}hidden{{/unless}}">
      {{#if selectedShip}}

      {{#if hasMultipleShips}}
      <div class="pad-ship-select" data-action="toggleShipMenu">
        <div>
          <div class="pad-ship-name">{{selectedShip.name}}</div>
          <div class="pad-ship-kind">{{#if shipIsVehicle}}Veículo{{else}}Nave Estelar{{/if}}</div>
        </div>
        <span class="pad-chev">▾</span>
      </div>
      {{#if shipMenuOpen}}
      <div class="pad-ship-menu">
        {{#each crewedShips as |s|}}
        <button type="button" data-action="selectShip" data-ship-id="{{s.id}}">{{s.name}}</button>
        {{/each}}
      </div>
      {{/if}}
      {{else}}
      <div class="pad-ship-select">
        <div>
          <div class="pad-ship-name">{{selectedShip.name}}</div>
          <div class="pad-ship-kind">{{#if shipIsVehicle}}Veículo{{else}}Nave Estelar{{/if}}</div>
        </div>
      </div>
      {{/if}}

      <div class="pad-hud-panel">
        <p class="pad-hud-label">Integridade</p>
        <div class="pad-vital-row">
          <div class="pad-vital-top"><span>Casco</span><span>{{selectedShip.system.casco.value}} / {{selectedShip.system.casco.max}}</span></div>
          <div class="pad-bar-track"><div class="pad-bar-fill" style="width:{{shipCascoPercent}}%"></div></div>
        </div>
        <div class="pad-vital-row">
          <div class="pad-vital-top"><span>Escudo</span><span>{{selectedShip.system.shields.value}} / {{selectedShip.system.shields.max}}</span></div>
          <div class="pad-bar-track"><div class="pad-bar-fill warn" style="width:{{shipShieldPercent}}%"></div></div>
        </div>
      </div>

      <div class="pad-hud-panel">
        <p class="pad-hud-label">Grid de Energia{{#if shipDeficit}} · déficit{{/if}}</p>
        <div class="pad-vital-row">
          <div class="pad-vital-top"><span>Reator</span><span>{{shipReactorOutput}}</span></div>
        </div>
        <div class="pad-vital-row">
          <div class="pad-vital-top"><span>Consumo</span><span>{{shipConsumption}}</span></div>
        </div>
        {{#if shipCanFocus}}
        <div class="pad-focus-row">
          {{#each shipFocusOptions as |opt|}}
          <button type="button" class="pad-focus-btn {{#if opt.active}}active{{/if}}" data-action="setShipFocus" data-focus="{{opt.id}}">{{opt.label}}</button>
          {{/each}}
        </div>
        {{/if}}
      </div>

      <div class="pad-hud-panel">
        <p class="pad-hud-label">Módulos</p>
        <div class="pad-module-list">
          {{#each shipModules as |m|}}
          <div class="pad-module-row">
            <span class="pad-status-dot {{#if (eq m.system.status "online")}}on{{else}}off{{/if}}"></span>
            <span class="pad-m-name">{{m.name}}</span>
            <span class="pad-m-state">{{m.system.status}}</span>
          </div>
          {{/each}}
        </div>
        {{#unless shipModules.length}}<p class="pad-hint">Nenhum módulo instalado.</p>{{/unless}}
      </div>

      <div class="pad-hud-panel">
        <p class="pad-hud-label">Tripulação</p>
        <div class="pad-crew-list">
          {{#each shipCrew as |entry|}}
          <div class="pad-crew-row">
            <img src="{{entry.actor.img}}"/>
            <span class="pad-c-name">{{entry.actor.name}}</span>
            {{#if entry.role}}<span class="pad-c-role">{{entry.role}}</span>{{/if}}
          </div>
          {{/each}}
        </div>
        {{#unless shipCrew.length}}<p class="pad-hint">Nenhum tripulante designado.</p>{{/unless}}
      </div>

      {{#if canViewShipSheet}}
      <button type="button" class="pad-ghost-btn" data-action="openShipSheet">Ver Ficha Completa da Nave</button>
      {{/if}}

      {{else}}
      <div class="pad-empty-state"><i class="fas fa-rocket"></i><p>Você não está tripulando nenhuma Nave/Veículo no momento.</p></div>
      {{/if}}
    </section>

    <section class="pad-screen {{#unless (eq activeScreen "biblioteca")}}hidden{{/unless}}">

      {{#if selectedShip}}
      <div class="pad-seg">
        <button type="button" class="{{#if (eq libraryTab "pessoal")}}active{{/if}}" data-action="selectLibraryTab" data-lib-tab="pessoal">Pessoal</button>
        <button type="button" class="{{#if (eq libraryTab "nave")}}active{{/if}}" data-action="selectLibraryTab" data-lib-tab="nave">Da {{selectedShip.name}}</button>
      </div>
      {{/if}}

      <div class="pad-lib-list {{#unless (eq libraryTab "pessoal")}}hidden{{/unless}}">
        {{#each personalLibrary as |entry|}}
        <div class="pad-lib-row {{#unless entry.resolvedDoc}}missing{{/unless}}">
          <span class="pad-lib-icon">
            {{#if (eq entry.resolvedDoc.documentName "Item")}}<i class="fas fa-suitcase"></i>
            {{else if (eq entry.resolvedDoc.documentName "JournalEntry")}}<i class="fas fa-book-open"></i>
            {{else if (eq entry.resolvedDoc.documentName "Actor")}}<i class="fas fa-user"></i>
            {{else}}<i class="fas fa-file"></i>{{/if}}
          </span>
          <span class="pad-lib-body" data-action="openLibraryEntry" data-uuid="{{entry.uuid}}">
            <span class="pad-lib-name">{{#if entry.resolvedDoc}}{{entry.resolvedDoc.name}}{{else}}{{entry.label}} (removido){{/if}}</span>
          </span>
          <a class="pad-lib-remove" data-action="removeLibraryEntry" data-entry-id="{{entry.id}}" data-lib-tab="pessoal" title="Remover"><i class="fas fa-times"></i></a>
        </div>
        {{/each}}
        {{#unless personalLibrary.length}}<p class="pad-hint">Nenhum favorito pessoal salvo ainda.</p>{{/unless}}
      </div>

      {{#if selectedShip}}
      <div class="pad-lib-list {{#unless (eq libraryTab "nave")}}hidden{{/unless}}">
        {{#each shipLibrary as |entry|}}
        <div class="pad-lib-row {{#unless entry.resolvedDoc}}missing{{/unless}}">
          <span class="pad-lib-icon">
            {{#if (eq entry.resolvedDoc.documentName "Item")}}<i class="fas fa-suitcase"></i>
            {{else if (eq entry.resolvedDoc.documentName "JournalEntry")}}<i class="fas fa-book-open"></i>
            {{else if (eq entry.resolvedDoc.documentName "Actor")}}<i class="fas fa-user"></i>
            {{else}}<i class="fas fa-file"></i>{{/if}}
          </span>
          <span class="pad-lib-body" data-action="openLibraryEntry" data-uuid="{{entry.uuid}}">
            <span class="pad-lib-name">{{#if entry.resolvedDoc}}{{entry.resolvedDoc.name}}{{else}}{{entry.label}} (removido){{/if}}</span>
          </span>
          <a class="pad-lib-remove" data-action="removeLibraryEntry" data-entry-id="{{entry.id}}" data-lib-tab="nave" title="Remover"><i class="fas fa-times"></i></a>
        </div>
        {{/each}}
        {{#unless shipLibrary.length}}<p class="pad-hint">Nenhum favorito da Nave salvo ainda.</p>{{/unless}}
      </div>
      {{/if}}

      <div class="pad-lib-dropzone">Arraste um Item, Registro ou Ator aqui pra salvar como favorito{{#if selectedShip}} (na aba selecionada){{/if}}.</div>
    </section>

    <section class="pad-screen {{#unless (eq activeScreen "mensagens")}}hidden{{/unless}}">

      {{#unless activeThread}}
      <div class="pad-thread-list">
        {{#each threads as |t|}}
        <div class="pad-thread-row {{#if t.unread}}has-unread{{/if}}" data-action="openThread" data-thread-type="{{t.conversationType}}" data-actor-uuid="{{t.otherActorUuid}}" data-group-id="{{t.groupId}}">
          <span class="pad-thread-avatar {{#if (eq t.conversationType "group")}}group{{/if}}">{{t.avatarInitials}}</span>
          <div class="pad-thread-info">
            <div class="pad-t-name">{{t.title}}{{#if (eq t.conversationType "group")}} <span class="pad-grp-tag">GRUPO</span>{{/if}}</div>
            <div class="pad-t-preview">{{t.preview}}</div>
          </div>
          {{#if t.unread}}<span class="pad-unread-badge" title="{{t.unread}} mensagem(ns) não lida(s)">{{t.unread}}</span>{{/if}}
        </div>
        {{/each}}
        {{#unless threads.length}}<p class="pad-hint">Nenhuma conversa ainda.</p>{{/unless}}
      </div>

      {{#if pendingContactShares.length}}
      <p class="pad-subhead">Contatos Compartilhados</p>
      <div class="pad-thread-list">
        {{#each pendingContactShares as |s|}}
        <div class="pad-thread-row pad-pending-contact">
          <span class="pad-thread-avatar">{{s.avatarInitials}}</span>
          <div class="pad-thread-info"><div class="pad-t-name">{{s.senderName}}</div></div>
          <button type="button" class="pad-add-contact-btn" data-action="addPendingContact" data-actor-uuid="{{s.senderActorUuid}}">+ Adicionar</button>
        </div>
        {{/each}}
      </div>
      {{/if}}

      {{#if contacts.length}}
      <p class="pad-subhead">Contatos</p>
      <div class="pad-thread-list">
        {{#each contacts as |c|}}
        <div class="pad-thread-row" data-action="openThread" data-thread-type="direct" data-actor-uuid="{{c.uuid}}">
          <span class="pad-thread-avatar">{{c.initials}}</span>
          <div class="pad-thread-info"><div class="pad-t-name">{{c.name}}</div></div>
        </div>
        {{/each}}
      </div>
      {{/if}}

      <div class="pad-thread-actions">
        <button type="button" class="pad-new-thread-btn" data-action="shareContact"><i class="fas fa-share-nodes"></i> Compartilhar Meu Contato</button>
        <button type="button" class="pad-new-thread-btn" data-action="toggleNewGroup">+ Novo Grupo</button>
      </div>
      {{#if newGroupMode}}
      <div class="pad-new-group">
        <input type="text" class="pad-new-group-name" placeholder="Nome do grupo"/>
        <div class="pad-new-group-members">
          {{#each contacts as |c|}}
          <label class="pad-new-group-member"><input type="checkbox" class="pad-new-group-check" value="{{c.uuid}}"/> {{c.name}}</label>
          {{/each}}
        </div>
        <button type="button" class="pad-ghost-btn" data-action="createGroup">Criar Grupo</button>
      </div>
      {{/if}}
      {{/unless}}

      {{#if activeThread}}
      <div class="pad-thread-view">
        <div class="pad-bubbles">
          {{#each threadMessages as |m|}}
          <div class="pad-bubble {{#if (eq m.senderActorUuid ../actor.uuid)}}mine{{else}}theirs{{/if}}">
            {{#if (eq ../threadConversationType "group")}}<span class="pad-bubble-who">{{m.senderName}}</span>{{/if}}
            {{m.body}}
          </div>
          {{/each}}
          {{#unless threadMessages.length}}<div class="pad-empty-state"><i class="fas fa-comment-dots"></i><p>Nenhuma mensagem ainda. Diga oi!</p></div>{{/unless}}
        </div>
        <div class="pad-composer">
          <input type="text" class="pad-compose-input" placeholder="Mensagem…"/>
          <button type="button" class="pad-send-btn" data-action="sendMessage" title="Enviar"><i class="fas fa-paper-plane"></i></button>
        </div>
      </div>
      {{/if}}
    </section>

    <section class="pad-screen pad-sp {{#unless (eq activeScreen "compras")}}hidden{{/unless}}">
      {{#if padShop}}
      {{#unless padShop.net.ok}}
      <div class="pad-sp-center">
        <i class="fa-solid {{#if (eq padShop.state "suppressed")}}fa-power-off{{else}}fa-signal{{/if}} pad-sp-bigicon"></i>
        <b>Sem conexão</b>
        <span class="pad-hint">{{#if (eq padShop.state "suppressed")}}O aparelho está sem energia (PEM ou campo de supressão).{{else}}Sem rede aqui. As compras voltam quando houver sinal.{{/if}}</span>
        <button type="button" class="pad-sp-btn" data-action="padShopRetry">Tentar de novo</button>
      </div>
      {{else}}
      {{#if padShop.notBuyer}}
      <div class="pad-sp-center"><i class="fa-solid fa-store pad-sp-bigicon"></i><b>Escolha um comprador</b><span class="pad-hint">Esta ficha é uma loja. Abra o PAD de um personagem para comprar.</span></div>
      {{else}}

      {{#if padShop.product}}
      <div class="pad-sp-product">
        <div class="pad-sp-hero-img" style="background: linear-gradient(160deg, {{padShop.product.color}}, var(--nihility-bg-panel-alt))">
          <img src="{{padShop.product.img}}" alt=""/>
          <span class="pad-sp-tag {{padShop.product.tagClass}}">{{#if padShop.product.digital}}software · na hora{{else}}{{padShop.product.deliveryLabel}}{{/if}}</span>
          <button type="button" class="pad-sp-close" data-action="padShopCloseProduct" title="Voltar"><i class="fa-solid fa-chevron-left"></i></button>
        </div>
        <div class="pad-sp-pbody">
          <span class="pad-hint">{{padShop.product.shopName}}</span>
          <b class="pad-sp-pname">{{padShop.product.name}}</b>
          <span class="pad-sp-price big">{{padShop.product.priceText}}</span>
          {{#if padShop.product.description}}<span class="pad-sp-desc">{{padShop.product.description}}</span>{{/if}}
          <div class="pad-sp-row"><span class="pad-sp-tag o">{{padShop.product.stockText}}</span><span class="pad-hint">Pagável em qualquer moeda</span></div>
          <div class="pad-sp-row between"><span>Quantidade</span>
            <span class="pad-sp-stepper"><button type="button" data-action="padShopQty" data-delta="-1">−</button><b>{{padShop.product.qty}}</b><button type="button" data-action="padShopQty" data-delta="1">+</button></span>
          </div>
        </div>
        <button type="button" class="pad-sp-cta" data-action="padShopAdd" {{#unless padShop.product.canBuy}}disabled{{/unless}}>{{#if padShop.product.canBuy}}Adicionar ao carrinho · {{padShop.product.totalText}}{{else}}Esgotado{{/if}}</button>
      </div>
      {{else}}

      {{#if padShop.isHome}}
      <label class="pad-sp-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" class="pad-sp-search-input" placeholder="Buscar produtos e lojas"/></label>
      {{#if padShop.shopFilter}}
      <div class="pad-sp-filter"><span>Loja: <b>{{padShop.shopFilter}}</b></span><button type="button" data-action="padShopClearShop" title="Mostrar tudo"><i class="fa-solid fa-xmark"></i></button></div>
      {{else}}
      <div class="pad-sp-banner"><span class="pad-sp-tag a">{{padShop.shopCount}} {{#if (eq padShop.shopCount 1)}}loja online{{else}}lojas online{{/if}}</span><b>O que você procura?</b><span class="pad-hint">{{#if padShop.hasDigital}}Software chega na hora, direto no inventário. {{/if}}O resto vai para o depósito do lugar onde você está.</span></div>
      {{/if}}
      <div class="pad-sp-cats">
        {{#each padShop.cats as |c|}}
        <button type="button" class="pad-sp-cat {{#if c.on}}on{{/if}}" data-action="padShopCat" data-cat="{{c.name}}"><i class="fa-solid {{c.icon}}"></i><span>{{c.name}}</span></button>
        {{/each}}
      </div>
      <div class="pad-sp-grid">
        {{#each padShop.products as |p|}}
        <button type="button" class="pad-sp-card" data-action="padShopProduct" data-key="{{p.key}}" data-search="{{p.searchName}}">
          <span class="pad-sp-cimg" style="background: {{p.color}}"><img src="{{p.img}}" alt=""/><span class="pad-sp-tag {{p.tagClass}}">{{#if p.digital}}na hora{{else}}{{p.deliveryLabel}}{{/if}}</span></span>
          <span class="pad-sp-cinfo"><span class="pad-sp-cname">{{p.name}}</span><span class="pad-sp-price">{{#if p.soldOut}}esgotado{{else}}{{p.priceText}}{{/if}}</span><span class="pad-hint">{{p.shopName}}</span></span>
        </button>
        {{/each}}
      </div>
      {{#unless padShop.products.length}}<p class="pad-hint">Nada nesta categoria.</p>{{/unless}}
      {{/if}}

      {{#if padShop.isShops}}
      <b class="pad-sp-title">Lojas</b>
      {{#each padShop.shops as |sh|}}
      <button type="button" class="pad-sp-shop" data-action="padShopOpenShop" data-shop-id="{{sh.id}}">
        <span class="pad-sp-shopbanner" style="background: linear-gradient(135deg, {{sh.color}}, var(--nihility-bg-panel-alt))"><span class="pad-sp-logo" style="background: {{sh.color}}">{{sh.initial}}</span></span>
        <span class="pad-sp-shopinfo"><b>{{sh.name}}</b><span class="pad-hint">{{sh.hint}}</span><span class="pad-sp-tags">{{#each sh.tags as |t|}}<span class="pad-sp-tag {{t.cls}}">{{t.text}}</span>{{/each}}</span></span>
      </button>
      {{/each}}
      {{/if}}

      {{#if padShop.isCart}}
      <b class="pad-sp-title">Carrinho</b>
      {{#if padShop.cart.empty}}
      <div class="pad-sp-center"><i class="fa-solid fa-cart-shopping pad-sp-bigicon"></i><span class="pad-hint">O carrinho está vazio.</span></div>
      {{else}}
      {{#each padShop.cart.lines as |l|}}
      <div class="pad-sp-line">
        <span class="pad-sp-thumb" style="background: {{l.color}}"><img src="{{l.img}}" alt=""/></span>
        <span class="pad-sp-linebody"><span class="pad-sp-cname">{{l.name}}</span><span class="pad-sp-tag {{l.tagClass}}">{{#if l.digital}}na hora{{else}}{{l.deliveryLabel}}{{/if}}</span></span>
        <span class="pad-sp-stepper"><button type="button" data-action="padShopStep" data-key="{{l.key}}" data-delta="-1">−</button><b>{{l.qty}}</b><button type="button" data-action="padShopStep" data-key="{{l.key}}" data-delta="1">+</button></span>
        <b class="pad-sp-linetotal">{{l.totalText}}</b>
      </div>
      {{/each}}
      {{#if padShop.cart.needsAddress}}
      <span class="pad-hint">Entregar o item físico em:</span>
      {{#each padShop.cart.destinations as |d|}}
      <label class="pad-sp-opt {{#if d.selected}}on{{/if}} {{#if d.disabled}}off{{/if}}"><input type="radio" name="pad-sp-dest" value="{{d.value}}" {{#if d.selected}}checked{{/if}} {{#if d.disabled}}disabled{{/if}}/><span><b>{{d.label}}</b><br/><span class="{{#if d.disabled}}pad-sp-warn{{else}}pad-hint{{/if}}">{{d.hint}}</span></span></label>
      {{/each}}
      {{#if padShop.cart.noAddress}}
      <div class="pad-sp-banner bad"><b>Sem endereço de entrega aqui</b><span class="pad-hint">Esta cena não aponta para um depósito, e não há nave atracada. Peça ao Mestre ou vá a outro lugar.</span></div>
      {{/if}}
      {{/if}}
      <span class="pad-hint">O software vai direto para o inventário. Se o carrinho só tiver software, a entrega física some.</span>
      <div class="pad-sp-row between pad-sp-total"><span>Total</span><b>{{padShop.cart.totalText}}</b></div>
      <span class="pad-hint">Pago das suas moedas, em qualquer moeda, convertida. Saldo: {{padShop.cart.balanceText}}</span>
      {{#unless padShop.cart.enough}}<div class="pad-sp-banner bad small">Saldo insuficiente para {{padShop.cart.totalText}} (faltam {{padShop.cart.shortText}})</div>{{/unless}}
      <button type="button" class="pad-sp-cta gold" data-action="padShopBuy" {{#unless padShop.cart.canBuy}}disabled{{/unless}}>Comprar</button>
      {{/if}}
      {{/if}}

      {{#if padShop.isOrders}}
      <b class="pad-sp-title">Entregas</b>
      {{#each padShop.orders as |o|}}
      <div class="pad-sp-order">
        <div class="pad-sp-row">
          <span class="pad-sp-thumb" style="background: {{o.color}}"><img src="{{o.img}}" alt=""/></span>
          <span class="pad-sp-linebody"><b>{{o.qtyText}}{{o.name}}</b><span class="pad-hint">{{o.shopName}}</span></span>
          <span class="pad-sp-tag {{#if (eq o.state "transit")}}g{{else}}o{{/if}}">{{o.stateText}}</span>
        </div>
        {{#if (eq o.state "transit")}}<div class="pad-sp-bar"><i style="width: {{o.progress}}%"></i></div>{{/if}}
        <div class="pad-sp-row between"><span class="pad-hint">{{o.note}}</span>{{#if o.showDest}}<span class="pad-hint">{{o.destName}}</span>{{/if}}</div>
      </div>
      {{/each}}
      {{#unless padShop.orders.length}}<div class="pad-sp-center"><i class="fa-solid fa-truck pad-sp-bigicon"></i><span class="pad-hint">Nenhum pedido ainda.</span></div>{{/unless}}
      {{/if}}

      {{/if}}

      <nav class="pad-sp-nav">
        {{#each padShop.tabs as |t|}}
        <button type="button" class="pad-sp-navbtn {{#if t.on}}on{{/if}}" data-action="padShopTab" data-tab="{{t.id}}"><i class="fa-solid {{t.icon}}"></i><span>{{t.label}}</span>{{#if t.badge}}<span class="pad-sp-badge">{{t.badge}}</span>{{/if}}</button>
        {{/each}}
      </nav>
      {{/if}}
      {{/unless}}
      {{/if}}
    </section>

  </div>
</div>
