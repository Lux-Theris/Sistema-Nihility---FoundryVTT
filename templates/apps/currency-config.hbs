<form class="nihility-config-app currency-config-app" autocomplete="off">
  <p class="hint">
    Configure as moedas usadas na aba Economia das fichas. O <strong>id</strong> é a chave interna
    (sem espaços, ex: <code>gold</code>) — os demais campos são livres.
  </p>

  <div class="config-list-header">
    <span>ID</span>
    <span>Nome</span>
    <span>Ícone</span>
    <span>Peso</span>
    <span></span>
  </div>

  <div class="currency-list">
    {{#each currencies as |c|}}
    <div class="currency-row">
      <input type="text" data-field="id" value="{{c.id}}" placeholder="id (ex: gold)"/>
      <input type="text" data-field="label" value="{{c.label}}" placeholder="Nome exibido"/>
      <input type="text" data-field="icon" value="{{c.icon}}" placeholder="Caminho do ícone"/>
      <a class="currency-icon-pick" title="Escolher ícone"><i class="fas fa-image"></i></a>
      <input type="number" step="0.01" data-field="weight" value="{{c.weight}}" placeholder="Peso"/>
      <a class="currency-delete" title="Remover"><i class="fas fa-trash"></i></a>
    </div>
    {{/each}}
  </div>

  <a class="config-add-row currency-add">+ Nova Moeda</a>

  <footer class="sheet-footer">
    <button type="submit"><i class="fas fa-save"></i> Salvar Moedas</button>
  </footer>
</form>
