<div class="config-editor-body">
  {{#if hint}}<p class="hint">{{{hint}}}</p>{{/if}}

  <div class="list-config-header" style="grid-template-columns: {{gridColumns}};">
    {{#each fieldLabels as |label|}}<span>{{label}}</span>{{/each}}
    <span></span>
  </div>

  <!-- As linhas nunca são renderizadas aqui — ver ListConfigApp#_onRender/#_appendRow em
       list-config-app-factory.js, que monta cada linha em JS (mesmo caminho usado por
       "+ Nova Linha") pra nunca ter duas implementações de layout de linha divergindo. -->
  <div class="list-config-list"></div>

  <a class="config-add-row" data-action="addRow">+ Nova Linha</a>

  <footer class="sheet-footer">
    <button type="submit"><i class="fas fa-save"></i> Salvar</button>
  </footer>
</div>
