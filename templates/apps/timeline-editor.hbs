<div class="tl-root wc-root">
  <section class="wc-sec">
    <label class="tl-field">Nome <input type="text" name="name" value="{{name}}"/></label>
  </section>

  <section class="wc-sec">
    <h4>Data agora nesta linha</h4>
    <div class="wc-row">
      <label>Dia <input type="number" name="day" min="1" step="1" value="{{fields.day}}"/></label>
      <label>Mês <select name="month">{{#each fields.months as |m|}}<option value="{{m.index}}" {{#if m.selected}}selected{{/if}}>{{m.name}}</option>{{/each}}</select></label>
      <label>Ano <input type="number" name="year" min="1" step="1" value="{{fields.year}}"/></label>
      {{#if fields.hasEras}}<label>Era <select name="era">{{#each fields.eras as |e|}}<option value="{{e.index}}" {{#if e.selected}}selected{{/if}}>{{e.name}}</option>{{/each}}</select></label>{{/if}}
      <label>Hora <input type="number" name="hour" min="0" step="1" value="{{fields.hour}}"/></label>
      <label>Min <input type="number" name="minute" min="0" step="1" value="{{fields.minute}}"/></label>
    </div>
    <p class="wc-note">Pode ir para o passado ou o futuro: muda só onde a linha está no calendário. Sono, superfícies e efeitos continuam certos.</p>
  </section>

  {{#unless isMain}}
  <section class="wc-sec">
    <h4>Ritmo do tempo</h4>
    <div class="wc-row tl-rate">
      <input type="number" name="insideValue" min="0" step="any" value="{{insideValue}}"/>
      <select name="insideUnit">{{#each insideUnits as |u|}}<option value="{{u.id}}" {{#if u.selected}}selected{{/if}}>{{u.label}}</option>{{/each}}</select>
      <span>dentro =</span>
      <input type="number" name="outsideValue" min="0" step="any" value="{{outsideValue}}"/>
      <select name="outsideUnit">{{#each outsideUnits as |u|}}<option value="{{u.id}}" {{#if u.selected}}selected{{/if}}>{{u.label}}</option>{{/each}}</select>
      <span>fora</span>
      <button type="button" class="wc-mini" data-action="setNormal">Normal</button>
    </div>
    <p class="wc-note tl-rate-hint">{{rateText}}</p>
  </section>

  <section class="wc-sec">
    <h4>Combate nesta linha</h4>
    <label class="tl-radio"><input type="radio" name="combatWorld" value="stop" {{#if combatStop}}checked{{/if}}/> O mundo para durante o combate</label>
    <label class="tl-radio"><input type="radio" name="combatWorld" value="atEnd" {{#if combatAtEnd}}checked{{/if}}/> O mundo anda no fim</label>
    <p class="wc-note tl-combat-hint"></p>
  </section>

  <section class="wc-sec">
    <h4>Cenas nesta linha</h4>
    <ul class="tl-scenes">
      {{#each scenes as |s|}}
      <li><label><input type="checkbox" name="scene" value="{{s.id}}" {{#if s.checked}}checked{{/if}}/> {{s.name}}{{#if s.elsewhere}} <em>(está em outra linha)</em>{{/if}}</label></li>
      {{/each}}
    </ul>
    <p class="wc-note">Também dá para escolher a linha na janela Ambiente da Cena.</p>
  </section>
  {{else}}
  <p class="wc-note">Na linha principal não há ritmo (é sempre normal) e ela não se apaga.</p>
  {{/unless}}

  <footer class="wc-row tl-footer">
    {{#if isNew}}{{else}}{{#unless isMain}}<button type="button" data-action="remove"><i class="fa-solid fa-trash"></i> Apagar linha</button>{{/unless}}{{/if}}
    <button type="button" data-action="save"><i class="fa-solid fa-floppy-disk"></i> Salvar</button>
  </footer>
</div>
