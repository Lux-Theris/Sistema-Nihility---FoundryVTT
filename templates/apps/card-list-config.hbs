<div class="config-editor-body card-config-body">
  {{#if hint}}<p class="hint">{{{hint}}}</p>{{/if}}

  <!-- Os cartões são montados em JS (ver card-list-config-factory.js), pela mesma função que
       desenha um cartão novo — nunca duas implementações do mesmo layout. -->
  <div class="card-config-list"></div>

  <a class="config-add-row" data-action="addCard">{{addLabel}}</a>

  <footer class="sheet-footer">
    <button type="submit"><i class="fas fa-save"></i> Salvar</button>
  </footer>
</div>
