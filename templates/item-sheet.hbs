<div class="nihility-sheet item-sheet type-{{itemType}}">

  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
    <input name="name" type="text" value="{{item.name}}" placeholder="Nome"/>
  </header>

  <nav class="sheet-tabs tabs">
    <a class="item {{#if (eq activeTab "description")}}active{{/if}}" data-action="selectTab" data-tab="description">Descrição</a>
    <a class="item {{#if (eq activeTab "details")}}active{{/if}}" data-action="selectTab" data-tab="details">Detalhes</a>
  </nav>

  <section class="sheet-body">

    <div class="tab {{#unless (eq activeTab "description")}}hidden{{/unless}}">
      {{editor system.description target="system.description" button=true engine="prosemirror" owner=owner}}
    </div>

    <div class="tab {{#unless (eq activeTab "details")}}hidden{{/unless}}">

      {{#if (eq itemType "skill")}}
      <label>Tier
        <select name="system.tier">
          {{#each visibleSkillTiers as |tier|}}
          <option value="{{tier}}" {{#if (eq tier system.tier)}}selected{{/if}}>{{lookup ../config.SKILL_TIER_LABELS tier}}</option>
          {{/each}}
        </select>
      </label>
      {{#unless (eq system.tier "ultimate")}}
      <p class="hint-inline">"Ultimate" só aparece pro jogador se o Ator já possuir uma Skill Ultimate — o Mestre sempre vê essa opção.</p>
      {{/unless}}
      <label>Nível
        <input type="number" name="system.level" value="{{system.level}}" {{#unless isGM}}readonly{{/unless}}/>
        {{#if isGM}}<button type="button" class="level-up-button" data-action="levelUpSkill" title="Level Up (Voz do Mundo avisa)">+</button>{{/if}}
      </label>

      <label>Categoria de Resistência <span class="hint-inline">(passiva — reduz dano recebido enquanto o Ator tiver essa Skill; Geral trava em nível 5/50%, Elemento vira Imunidade em nível 10/100%)</span>
        <select class="resistance-target-select" name="system.resistanceTarget">
          {{#each resistanceOptions as |opt|}}
          <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
          {{/each}}
        </select>
      </label>
      {{#if isResistanceSkill}}
      <p class="hint-inline">Redução atual: {{resistancePercent}}% (nível {{system.level}}/{{resistanceMaxLevel}}).</p>
      {{/if}}

      <label>Custo <input type="number" name="system.cost" value="{{system.cost}}"/></label>
      <label>Gatilho Emocional <input type="text" name="system.emotionTrigger" value="{{system.emotionTrigger}}"/></label>
      <label>Requer Item <span class="hint-inline">(livre, só pra RP — ex: "Revólver das Transmutações")</span>
        <input type="text" name="system.requiredItem" value="{{system.requiredItem}}"/>
      </label>

      {{#if system.isItemGranted}}
      <p class="hint-inline">⚙ Concedida automaticamente por um Item/Módulo — não pode ser fundida, e some se a fonte for desequipada/removida.</p>
      {{/if}}

      <h3>Sub-Skills</h3>
      <ol class="sub-list">
        {{#each system.subSkills as |sub index|}}
        <li data-index="{{index}}">
          <input type="text" name="system.subSkills.{{index}}.name" value="{{sub.name}}"/>
          <input type="text" name="system.subSkills.{{index}}.description" value="{{sub.description}}"/>
          <a class="sub-skill-delete" data-action="deleteSubSkill" title="Remover"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
      <a class="sub-skill-add" data-action="addSubSkill">+ Sub-Skill</a>

      {{#if system.fusionSources.length}}
      <h3>Linhagem de Fusão</h3>
      <p>{{#each system.fusionSources}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
      {{/if}}

      <h3>Mecânica ao "Usar"</h3>
      <label>Tipo de Efeito
        <select name="system.effectType">
          {{#each config.SKILL_EFFECT_TYPES as |t|}}
          <option value="{{t}}" {{#if (eq t system.effectType)}}selected{{/if}}>{{lookup ../config.SKILL_EFFECT_TYPE_LABELS t}}</option>
          {{/each}}
        </select>
      </label>

      {{#unless (eq system.effectType "none")}}
      <label>Tipo de Alvo
        <select name="system.targetType">
          {{#each config.SKILL_TARGET_TYPES as |t|}}
          <option value="{{t}}" {{#if (eq t system.targetType)}}selected{{/if}}>{{lookup ../config.SKILL_TARGET_TYPE_LABELS t}}</option>
          {{/each}}
        </select>
      </label>

      {{#if (eq system.targetType "emission")}}
      <label>Formato de Área
        <select name="system.areaShape">
          {{#each config.SKILL_AREA_SHAPES as |s|}}
          <option value="{{s}}" {{#if (eq s system.areaShape)}}selected{{/if}}>{{lookup ../config.SKILL_AREA_SHAPE_LABELS s}}</option>
          {{/each}}
        </select>
      </label>
      <label>Distância <span class="hint-inline">(raio do Círculo ou distância do Cone/Linha, em unidades de grid)</span>
        <input type="number" name="system.areaDistance" value="{{system.areaDistance}}" min="0"/>
      </label>
      {{#if (eq system.areaShape "cone")}}
      <label>Ângulo <span class="hint-inline">(graus)</span>
        <input type="number" name="system.areaAngle" value="{{system.areaAngle}}" min="1" max="360"/>
      </label>
      {{/if}}
      {{/if}}
      {{/unless}}

      {{#if (eq system.effectType "damage")}}
      <label>Fórmula de Dano <span class="hint-inline">(sintaxe de rolagem do Foundry, ex: "2d6+3")</span>
        <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" placeholder="2d6+3"/>
      </label>
      <label>Dano Mágico? <span class="hint-inline">(reduzido pela Defesa Mágica do alvo — independente dos elementos abaixo)</span>
        <input type="checkbox" name="system.isMagicDamage" {{#if system.isMagicDamage}}checked{{/if}}/>
      </label>
      <label>Elemento(s) <span class="hint-inline">(só flavor no chat — pode marcar vários ao mesmo tempo)</span></label>
      <ol class="damage-elements-list">
        {{#each damageElements as |el|}}
        <li>
          <label>
            <input type="checkbox" name="system.damageElements" value="{{el.id}}" {{#if el.selected}}checked{{/if}}/>
            {{el.label}}
          </label>
        </li>
        {{/each}}
      </ol>
      {{/if}}

      {{#if (eq system.effectType "temporary")}}
      <h4>Efeitos <span class="hint-inline">(buffs, debuffs, drawbacks e escudos — cada entrada vira um Active Effect com duração, exceto Escudo)</span></h4>
      <ol class="sub-list effect-list">
        {{#each system.effects as |effect index|}}
        <li data-index="{{index}}" class="effect-row">
          <select name="system.effects.{{index}}.target">
            {{#each ../config.EFFECT_TARGETS as |t|}}
            <option value="{{t}}" {{#if (eq t effect.target)}}selected{{/if}}>{{lookup ../../config.EFFECT_TARGET_LABELS t}}</option>
            {{/each}}
          </select>
          <input type="number" name="system.effects.{{index}}.amount" value="{{effect.amount}}" placeholder="Quantidade"/>
          <input type="number" name="system.effects.{{index}}.durationRounds" value="{{effect.durationRounds}}" placeholder="Rounds" min="0"/>
          <a class="effect-delete" data-action="deleteEffect" title="Remover"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
      <a class="effect-add" data-action="addEffect">+ Efeito</a>
      <p class="hint-inline">Quantidade negativa = debuff/drawback. Escudo ignora duração — some só quando gasto absorvendo dano.</p>
      {{/if}}

      <h4>Modificador Permanente <span class="hint-inline">(soma direto no HP/Mana Máximo enquanto a Skill estiver na ficha, sempre — sem duração)</span></h4>
      <label>HP <input type="number" name="system.statModifiers.hp" value="{{system.statModifiers.hp}}"/></label>
      <label>Mana/Energia <input type="number" name="system.statModifiers.energy" value="{{system.statModifiers.energy}}"/></label>
      {{/if}}

      {{#if (eq itemType "body_part")}}
      <label>Slot <input type="text" name="system.slot" value="{{system.slot}}"/></label>
      <label>Origem (Espécie) <input type="text" name="system.speciesOrigin" value="{{system.speciesOrigin}}"/></label>
      <label>HP
        <input type="number" name="system.hp.value" value="{{system.hp.value}}"/>
        <span>/</span>
        <input type="number" name="system.hp.max" value="{{system.hp.max}}"/>
      </label>
      <label>Protética? <input type="checkbox" name="system.isProsthetic" {{#if system.isProsthetic}}checked{{/if}}/></label>

      <h3>Modificações Instaladas</h3>
      <ol class="sub-list mod-list">
        {{#each system.installedMods as |mod index|}}
        <li data-index="{{index}}" class="mod-row">
          <div class="mod-row-main">
            <input type="text" name="system.installedMods.{{index}}.name" value="{{mod.name}}" placeholder="Nome da modificação"/>
            <input type="text" name="system.installedMods.{{index}}.description" value="{{mod.description}}" placeholder="Descrição"/>
            <a class="mod-delete" data-action="deleteInstalledMod" title="Remover"><i class="fas fa-trash"></i></a>
          </div>
          <div class="mod-grant-fields">
            <input type="text" name="system.installedMods.{{index}}.grantsSkill.name" value="{{mod.grantsSkill.name}}" placeholder="Habilidade Concedida (nome)"/>
            <input type="number" name="system.installedMods.{{index}}.grantsSkill.cost" value="{{mod.grantsSkill.cost}}" placeholder="Custo"/>
            <select name="system.installedMods.{{index}}.grantsSkill.tier">
              {{#each ../config.ITEM_GRANTABLE_SKILL_TIERS as |t|}}
              <option value="{{t}}" {{#if (eq t mod.grantsSkill.tier)}}selected{{/if}}>{{lookup ../../config.SKILL_TIER_LABELS t}}</option>
              {{/each}}
            </select>
            <button type="button" class="mod-grant-toggle" data-action="toggleModGrant" data-index="{{index}}">
              {{#if mod.skillGranted}}Remover Habilidade{{else}}Conceder Habilidade{{/if}}
            </button>
          </div>
          <div class="mod-grant-fields">
            <label class="hint-inline">Mod. Permanente HP
              <input type="number" name="system.installedMods.{{index}}.statModifiers.hp" value="{{mod.statModifiers.hp}}"/>
            </label>
            <label class="hint-inline">Mod. Permanente Mana
              <input type="number" name="system.installedMods.{{index}}.statModifiers.energy" value="{{mod.statModifiers.energy}}"/>
            </label>
          </div>
          <div class="mod-attr-bonuses">
            <span class="hint-inline">Bônus de Atributo (rolagem — nunca entra no HP/Mana)</span>
            <ol class="sub-list mod-attr-bonus-list">
              {{#each mod.attributeBonuses as |bonus bIndex|}}
              <li data-index="{{index}}" data-bonus-index="{{bIndex}}" class="effect-row">
                <select name="system.installedMods.{{index}}.attributeBonuses.{{bIndex}}.attribute">
                  {{#each ../../config.COMBAT_ATTRIBUTES as |attrKey|}}
                  <option value="{{attrKey}}" {{#if (eq attrKey bonus.attribute)}}selected{{/if}}>{{lookup ../../../config.COMBAT_ATTRIBUTE_LABELS attrKey}}</option>
                  {{/each}}
                </select>
                <input type="number" name="system.installedMods.{{index}}.attributeBonuses.{{bIndex}}.amount" value="{{bonus.amount}}"/>
                <a class="mod-attr-bonus-delete" data-action="deleteModAttrBonus" title="Remover"><i class="fas fa-trash"></i></a>
              </li>
              {{/each}}
            </ol>
            <a class="mod-attr-bonus-add" data-action="addModAttrBonus" data-index="{{index}}">+ Bônus de Atributo</a>
          </div>
        </li>
        {{/each}}
      </ol>
      <a class="mod-add" data-action="addInstalledMod">+ Modificação/Prótese</a>
      {{/if}}

      {{#if (eq itemType "title")}}
      <label>Concedido por <input type="text" name="system.grantedBy" value="{{system.grantedBy}}"/></label>
      <label>Raridade <input type="text" name="system.rarity" value="{{system.rarity}}"/></label>

      <h3>Bônus Permanentes <span class="hint-inline">(sempre ativos enquanto o Título estiver na ficha)</span></h3>
      <ol class="sub-list">
        {{#each system.bonuses as |bonus index|}}
        <li data-index="{{index}}">
          <select name="system.bonuses.{{index}}.attribute">
            {{#each ../config.TITLE_BONUS_TARGETS as |attrKey|}}
            <option value="{{attrKey}}" {{#if (eq attrKey bonus.attribute)}}selected{{/if}}>{{lookup ../../config.EFFECT_TARGET_LABELS attrKey}}</option>
            {{/each}}
          </select>
          <input type="number" name="system.bonuses.{{index}}.amount" value="{{bonus.amount}}"/>
          <a class="title-bonus-delete" data-action="deleteTitleBonus" title="Remover"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
      <a class="title-bonus-add" data-action="addTitleBonus">+ Bônus</a>

      <h3>Resistência a Dano <span class="hint-inline">(percentual fixo — não tem nível; soma com a Resistência de Skill do Ator pro mesmo alvo)</span></h3>
      <ol class="sub-list">
        {{#each titleResistances as |res index|}}
        <li data-index="{{index}}">
          <select name="system.resistances.{{index}}.target">
            {{#each res.targetOptions as |opt|}}
            <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
          <input type="number" name="system.resistances.{{index}}.amount" value="{{res.amount}}" min="0" max="100"/>%
          <a class="title-resistance-delete" data-action="deleteTitleResistance" title="Remover"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
      <a class="title-resistance-add" data-action="addTitleResistance">+ Resistência</a>
      {{/if}}

      {{#if (eq itemType "starship_module")}}
      <label>Categoria
        <select name="system.category">
          <option value="weapon" {{#if (eq system.category "weapon")}}selected{{/if}}>Arma</option>
          <option value="shield" {{#if (eq system.category "shield")}}selected{{/if}}>Escudo</option>
          <option value="engine" {{#if (eq system.category "engine")}}selected{{/if}}>Motor</option>
          <option value="utility" {{#if (eq system.category "utility")}}selected{{/if}}>Utilidade</option>
        </select>
      </label>
      <label>Consumo de Energia <input type="number" name="system.powerConsumption" value="{{system.powerConsumption}}"/></label>
      <label>Slot <input type="text" name="system.slot" value="{{system.slot}}"/></label>

      <h3>Habilidade Concedida <span class="hint-inline">(à Nave, enquanto o módulo estiver "online")</span></h3>
      <label>Nome <input type="text" name="system.grantsSkill.name" value="{{system.grantsSkill.name}}"/></label>
      <label>Descrição <input type="text" name="system.grantsSkill.description" value="{{system.grantsSkill.description}}"/></label>
      <label>Custo <input type="number" name="system.grantsSkill.cost" value="{{system.grantsSkill.cost}}"/></label>
      <label>Tier
        <select name="system.grantsSkill.tier">
          {{#each config.ITEM_GRANTABLE_SKILL_TIERS as |t|}}
          <option value="{{t}}" {{#if (eq t system.grantsSkill.tier)}}selected{{/if}}>{{lookup ../config.SKILL_TIER_LABELS t}}</option>
          {{/each}}
        </select>
      </label>
      <p class="hint-inline">Ligar/desligar o módulo na ficha da Nave concede/remove essa Habilidade automaticamente.</p>
      {{/if}}

      {{#if (eq itemType "item")}}
      <label>Quantidade <input type="number" name="system.quantity" value="{{system.quantity}}"/></label>
      <label>Peso <input type="number" name="system.weight" value="{{system.weight}}"/></label>
      <label>Equipado? <input type="checkbox" class="item-equip-toggle" name="system.equipped" {{#if system.equipped}}checked{{/if}}/></label>
      <label>Valor
        <input type="number" name="system.value.amount" value="{{system.value.amount}}"/>
        <input type="text" name="system.value.currency" value="{{system.value.currency}}"/>
      </label>

      <h3>Habilidade Concedida <span class="hint-inline">(ao dono, enquanto o item estiver equipado)</span></h3>
      <label>Nome <input type="text" name="system.grantsSkill.name" value="{{system.grantsSkill.name}}"/></label>
      <label>Descrição <input type="text" name="system.grantsSkill.description" value="{{system.grantsSkill.description}}"/></label>
      <label>Custo <input type="number" name="system.grantsSkill.cost" value="{{system.grantsSkill.cost}}"/></label>
      <label>Tier
        <select name="system.grantsSkill.tier">
          {{#each config.ITEM_GRANTABLE_SKILL_TIERS as |t|}}
          <option value="{{t}}" {{#if (eq t system.grantsSkill.tier)}}selected{{/if}}>{{lookup ../config.SKILL_TIER_LABELS t}}</option>
          {{/each}}
        </select>
      </label>
      <p class="hint-inline">Marcar/desmarcar "Equipado" concede/remove essa Habilidade automaticamente.</p>

      <h3>Modificador Permanente <span class="hint-inline">(soma direto no HP/Mana Máximo enquanto o item estiver equipado)</span></h3>
      <label>HP <input type="number" name="system.statModifiers.hp" value="{{system.statModifiers.hp}}"/></label>
      <label>Mana/Energia <input type="number" name="system.statModifiers.energy" value="{{system.statModifiers.energy}}"/></label>

      <h3>Bônus de Atributo <span class="hint-inline">(afeta a rolagem enquanto equipado — nunca entra no cálculo de HP/Mana)</span></h3>
      <ol class="sub-list">
        {{#each system.attributeBonuses as |bonus index|}}
        <li data-index="{{index}}" class="effect-row">
          <select name="system.attributeBonuses.{{index}}.attribute">
            {{#each ../config.COMBAT_ATTRIBUTES as |attrKey|}}
            <option value="{{attrKey}}" {{#if (eq attrKey bonus.attribute)}}selected{{/if}}>{{lookup ../../config.COMBAT_ATTRIBUTE_LABELS attrKey}}</option>
            {{/each}}
          </select>
          <input type="number" name="system.attributeBonuses.{{index}}.amount" value="{{bonus.amount}}"/>
          <a class="item-attr-bonus-delete" data-action="deleteItemAttrBonus" title="Remover"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
      <a class="item-attr-bonus-add" data-action="addItemAttrBonus">+ Bônus de Atributo</a>
      {{/if}}

    </div>
  </section>
</div>
