{{#*inline "nihilityInvRow"}}
<li class="item-row inventory-row {{#if row.equipped}}is-equipped{{/if}}" data-item-id="{{row.id}}" data-name="{{row.name}}" draggable="true">
  <img src="{{row.img}}" width="24" height="24"/>
  <span class="item-name">{{row.name}}</span>
  <span class="item-qty" title="{{row.stacks}} slot(s) — pilhas de {{row.stackSize}}">x{{row.quantity}}{{#if row.isContainer}} · contêiner{{/if}}{{#if row.isAmmo}} · munição{{#if row.ammoRounds}} aberta ({{row.ammoRounds}}){{/if}}{{/if}}</span>
  <span class="inv-weight" title="Peso total da pilha">{{row.weight}} kg</span>
  {{#if row.clock}}<span class="inv-clock" title="Hora do mundo"><i class="fa-regular fa-clock"></i> {{row.clock}}</span>{{#if row.clockAnalog}}<button type="button" class="skill-use-button" data-action="setItemClock" title="Acertar o relógio (data e hora que você quiser)">Acertar</button>{{/if}}{{/if}}
  {{#if row.isWeapon}}{{#if row.augmentsUnarmed}}{{#if row.equipped}}<span class="hint-inline" title="Equipado: a fórmula soma ao ataque desarmado">reforça o desarmado</span>{{/if}}{{else}}{{#if row.equipped}}<button type="button" class="skill-use-button" data-action="attackWithWeapon" title="Atacar com {{row.name}}">⚔</button><button type="button" class="skill-use-button" data-action="weaponAttackRoll" title="Rolar o ataque (atributo de escala + Maestria)">🎲</button>{{/if}}{{/if}}{{/if}}
  {{#if row.magazine.uses}}<span class="inv-mag {{#if row.magazine.empty}}is-empty{{/if}}" title="Disparos no carregador">🔋 {{row.magazine.loaded}}/{{row.magazine.max}}</span><button type="button" class="skill-use-button" data-action="reloadWeapon" title="Recarregar / trocar munição (o que estava dentro volta para o inventário)">⟳</button>{{/if}}
  {{#if row.isConsumable}}{{#if row.chargesText}}<span class="inv-charges" title="Cargas da unidade aberta">{{row.chargesText}}</span>{{/if}}<button type="button" class="skill-use-button" data-action="useConsumable" title="Usar {{row.name}}">Usar</button>{{/if}}
  {{#if row.hasContainers}}
  <select class="inventory-container-select" title="Guardar em">{{#each row.containerOptions as |opt|}}<option value="{{opt.id}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}</select>
  {{/if}}
  <a class="inv-equip {{#if row.equipped}}is-on{{/if}}" data-action="toggleEquip" title="{{#if row.equipped}}Desequipar{{else}}Equipar{{/if}}"><i class="fas fa-shirt"></i></a>
  {{#if row.canSplit}}<a data-action="splitStack" title="Dividir pilha"><i class="fas fa-code-branch"></i></a>{{/if}}
  <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
  <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
</li>
{{/inline}}
<section class="tab sheet-body {{tabs.inventory.cssClass}}" data-group="primary" data-tab="inventory">
  <div class="inventory-tab">
    <div class="block inventory-summary">
      <div class="inv-meter {{#if inventory.slotsOver}}is-over{{/if}}">
        <span class="inv-meter-label">Slots</span>
        <span class="inv-bar"><span style="width: {{inventory.slotsPercent}}%"></span></span>
        <span class="inv-meter-value">{{inventory.summary.usedSlots}} / {{inventory.summary.slots}}</span>
      </div>
      <div class="inv-meter {{#if inventory.summary.over}}is-over{{/if}}">
        <span class="inv-meter-label">Peso</span>
        <span class="inv-bar"><span style="width: {{inventory.weightPercent}}%"></span></span>
        <span class="inv-meter-value">{{inventory.summary.weight}} / {{inventory.summary.capacity}} kg</span>
      </div>
      {{#if inventory.summary.penalty}}<p class="inv-penalty"><i class="fas fa-weight-hanging"></i> Sobrecarga: −{{inventory.summary.penalty}}% de Deslocamento</p>{{/if}}
      <p class="hint-inline">Slots e carga base vêm da Espécie; Força e Defesa aumentam a carga. Contêineres ocupam 1 slot e guardam os próprios. Arraste um Item igual para somar na pilha.</p>
      {{#if isGM}}
      <div class="inv-gm">
        <label>Slots extras <input type="number" name="system.attributes.bonusSlots" value="{{system.attributes.bonusSlots}}"/></label>
        <label>Carga extra (kg) <input type="number" step="any" name="system.attributes.bonusCarry" value="{{system.attributes.bonusCarry}}"/></label>
      </div>
      {{/if}}
    </div>

    {{> nihility.setStrips}}

    {{#if devicePanel}}
    <div class="block device-panel">
      <p class="block-title"><i class="fas fa-microchip"></i> Placas <span class="hint-inline">arraste um programa sobre a placa para instalar</span></p>
      {{#each devicePanel.rows as |dev|}}
      <div class="device-row {{#if dev.stateTag}}is-down{{/if}}" data-device-ref="{{dev.ref}}">
        <div class="device-head">
          <strong class="device-name">{{dev.name}}</strong>
          <span class="hint-inline">{{dev.where}}</span>
          {{#if dev.technomagic}}<span class="device-tag tag-violet" title="Tecnomágica: sem Reserva, completa com {{dev.energyLabel}}; a Antimagia também a alcança">tecnomágica</span>{{/if}}
          {{#if dev.stateTag}}<span class="device-tag tag-bad" title="{{dev.blocked}}">{{dev.stateTag}}</span>{{/if}}
          <span class="sp"></span>
          <span class="device-pips" title="Reserva {{dev.reserveText}}">{{#each dev.pips as |pip|}}<span class="pip {{#unless pip.on}}off{{/unless}}"></span>{{/each}}</span>
          <span class="device-reserve">Reserva {{dev.reserveText}}</span>
          {{#if dev.canEdit}}{{#unless dev.infinite}}<button type="button" class="skill-use-button" data-action="deviceRecharge" {{#unless dev.canRecharge}}disabled title="{{dev.rechargeReason}}"{{else}}title="Recarregar a Reserva"{{/unless}}>Recarregar ▾</button>{{/unless}}{{/if}}
          {{#if dev.canShort}}<button type="button" class="skill-use-button" data-action="deviceShort" title="Mestre: rola um curto-circuito nesta placa">Curto</button>{{/if}}
          {{#if dev.canRepair}}<button type="button" class="skill-use-button" data-action="deviceRepair" title="Consertar a placa (precisa de uma Habilidade com Engenharia)">Consertar…</button>{{/if}}
        </div>
        {{#each dev.programs as |prog|}}
        <div class="device-slot on">
          <span class="device-slot-name">{{prog.name}}</span>
          {{#if (gt prog.slots 1)}}<span class="hint-inline">{{prog.slots}} encaixes</span>{{/if}}
          {{#if prog.passiveTag}}<span class="device-tag tag-accent" title="Bônus enquanto a placa funciona">{{prog.passiveTag}}</span>{{/if}}
          {{#if prog.costTag}}<span class="device-tag tag-gold" title="O que cada uso tira da Reserva">{{prog.costTag}}</span>{{/if}}
          <span class="sp"></span>
          {{#if dev.canEdit}}<button type="button" class="skill-use-button" data-action="deviceUninstall" data-uid="{{prog.uid}}" title="Tirar: o programa volta ao inventário">Tirar</button>{{/if}}
        </div>
        {{/each}}
        {{#each dev.freeSlots}}
        <div class="device-slot free"><span class="hint-inline">encaixe livre (arraste um programa)</span></div>
        {{/each}}
      </div>
      {{/each}}
      <p class="hint-inline">Uma placa só funciona equipada (ou instalada num implante), sem curto-circuito e sem PEM. Células de energia no inventário: {{devicePanel.cells}}.</p>
    </div>
    {{/if}}

    <div class="inventory-toolbar">
      <input type="search" class="inventory-search" placeholder="Buscar item…" aria-label="Buscar item"/>
      <select class="inventory-filter" aria-label="Filtrar">{{#each inventory.filters as |f|}}<option value="{{f.id}}" {{#if f.selected}}selected{{/if}}>{{f.label}}</option>{{/each}}</select>
      <select class="inventory-sort" aria-label="Ordenar">{{#each inventory.sorts as |f|}}<option value="{{f.id}}" {{#if f.selected}}selected{{/if}}>{{f.label}}</option>{{/each}}</select>
    </div>

    <div class="block inventory-drop" data-container-id="loose">
      <p class="block-title">Carregando <span class="hint-inline">(equipados primeiro)</span></p>
      <ol class="item-list inventory-list">
        {{#each inventory.loose as |row|}}{{> nihilityInvRow row=row}}{{else}}<li class="empty-note">Nada solto.</li>{{/each}}
      </ol>
      {{#if isGM}}<a class="item-create" data-action="createItem" data-type="item">+ Novo Item</a>{{/if}}
    </div>

    {{#each inventory.groups as |group|}}
    <div class="block inventory-container {{#if group.full}}is-over{{/if}}" data-container-id="{{group.id}}">
      <p class="block-title"><i class="fas {{#if group.isPocket}}fa-cube{{else if group.isSkill}}fa-hat-wizard{{else}}fa-box-open{{/if}}"></i> {{group.label}}
        <span class="hint-inline">{{group.used}}/{{#if group.unlimited}}∞{{else}}{{group.slots}}{{/if}} {{#if group.isPocket}}espaços · sem peso{{else}}slots{{#if group.weightReduction}} · −{{group.weightReduction}}% de peso{{/if}}{{/if}}</span></p>
      <ol class="item-list inventory-list">
        {{#each group.rows as |row|}}{{> nihilityInvRow row=row}}{{else}}<li class="empty-note">Vazio — arraste Itens pra cá.</li>{{/each}}
      </ol>
    </div>
    {{/each}}
  </div>
</section>
