<div class="nihility-sheet item-sheet type-{{itemType}}">

  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}"/>
    <input name="name" type="text" value="{{item.name}}" placeholder="Nome"/>
  </header>

  <nav class="sheet-tabs tabs">
    {{#unless (eq itemType "skill")}}
    <a class="item {{#if (eq activeTab "description")}}active{{/if}}" data-action="selectTab" data-tab="description">Descrição</a>
    {{/unless}}
    <a class="item {{#if (eq activeTab "details")}}active{{/if}}" data-action="selectTab" data-tab="details">Detalhes</a>
  </nav>

  <section class="sheet-body">

    <div class="tab {{#unless (eq activeTab "description")}}hidden{{/unless}}">
      {{#if owner}}
      <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
      {{else}}
      <div class="rich-text-readonly">{{{system.description}}}</div>
      {{/if}}
    </div>

    <div class="tab {{#unless (eq activeTab "details")}}hidden{{/unless}}">

      {{#if (eq itemType "skill")}}
      {{#if system.isItemGranted}}
      <p class="hint-inline">⚙ Concedida automaticamente por um Item/Módulo — não pode ser fundida, e some se a fonte for desequipada/removida.</p>
      {{/if}}
      {{#if system.evolvedFrom}}
      <p class="skill-summary-resist">Evoluiu de: {{system.evolvedFrom}}</p>
      {{/if}}

      <div class="skill-summary-row">
        {{#if isRacialSkill}}
        <span class="skill-summary-tier tier-racial" title="Tier travado: Racial">🔒 {{lookup config.SKILL_TIER_LABELS system.tier}}</span>
        {{else}}
        <label>Tier
          <select name="system.tier">
            {{#each skillTierOptions as |opt|}}
            <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
        </label>
        {{/if}}
        {{#if isGM}}<button type="button" class="level-up-button" data-action="levelUpSkill" title="Level Up (Voz do Mundo avisa)">+ Nível</button>{{/if}}
        {{#if item.parent}}
        <button type="button" class="skill-evolve-button" data-action="evolveSkill" title="Vira uma Skill nova, mantém só o registro histórico"><i class="fas fa-level-up-alt"></i> Evoluir</button>
        {{/if}}
      </div>
      {{#unless (eq system.tier "ultimate")}}
      <p class="hint-inline">"Ultimate" só aparece pro jogador se o Ator já possuir uma Skill Ultimate — o Mestre sempre vê essa opção.</p>
      {{/unless}}

      <label>Nível <input type="number" name="system.level" value="{{system.level}}" min="1" {{#unless isGM}}readonly{{/unless}}/></label>
      <label>Custo de {{energyLabel}} <input type="number" name="system.cost" value="{{system.cost}}" min="0"/></label>

      <label class="checkbox-line"><input type="checkbox" name="system.hasUpkeep" {{#if system.hasUpkeep}}checked{{/if}}/> Habilidade Ativa</label>
      {{#if system.hasUpkeep}}
      <label>Custo de {{energyLabel}} por Rodada <input type="number" name="system.upkeepCost" value="{{system.upkeepCost}}" min="0"/></label>
      {{/if}}

      <label>Animação <input type="text" name="system.animationPath" value="{{system.animationPath}}" placeholder="modules/jb2a_patreon/Library/.../explosion.webm"/></label>

      <h3>Descrição</h3>
      {{#if owner}}
      <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
      {{else}}
      <div class="rich-text-readonly">{{{system.description}}}</div>
      {{/if}}

      <label>Gatilho Emocional <input type="text" name="system.emotionTrigger" value="{{system.emotionTrigger}}"/></label>

      {{#if resistancesEnabled}}
      <h3>Resistência/Imunidade passiva <span class="hint-inline">(independente da Mecânica ao Usar abaixo — pode ter as duas)</span></h3>
      <label>Alvo
        <select name="system.resistanceTarget">
          {{#each skillResistanceOptions as |opt|}}
          <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
          {{/each}}
        </select>
      </label>
      {{#if isResistanceSkill}}
      <p class="skill-summary-resist">{{skillResistanceSummary}}</p>
      {{/if}}
      {{/if}}

      <h3>Mecânica ao Usar</h3>
      <label>Tipo
        <select name="system.effectType">
          {{#each skillEffectTypeOptions as |opt|}}
          <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
          {{/each}}
        </select>
      </label>

      {{#unless (eq system.effectType "none")}}
      <label>Tipo de Alvo
        <select name="system.targetType">
          {{#each skillTargetTypeOptions as |opt|}}
          <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
          {{/each}}
        </select>
      </label>

      {{#if (eq system.targetType "emission")}}
      <label>Formato de Área
        <select name="system.areaShape">
          {{#each skillAreaShapeOptions as |opt|}}
          <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
          {{/each}}
        </select>
      </label>
      <label>Distância <span class="hint-inline">(raio do Círculo ou distância do Cone/Linha, em unidades de grid)</span>
        <input type="number" name="system.areaDistance" value="{{system.areaDistance}}" min="0"/>
      </label>
      {{#if (eq system.areaShape "cone")}}
      <label>Ângulo <span class="hint-inline">(graus)</span>
        <input type="number" name="system.areaAngle" value="{{system.areaAngle}}" min="1" max="360"/>
      </label>
      {{/if}}
      {{/if}}
      {{/unless}}

      {{#if (eq system.effectType "damage")}}
      <label>Fórmula de Dano <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" placeholder="2d6+3"/></label>
      <label>Atributo de Escala
        <select name="system.scalingAttribute">
          {{#each skillScalingOptions as |opt|}}
          <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
          {{/each}}
        </select>
        <span class="hint-inline">Multiplica o dano por (Atributo.Total)² ÷ divisor. Sem escala, a fórmula vale como escrita.</span>
      </label>
      <label class="checkbox-line"><input type="checkbox" name="system.isMagicDamage" {{#if system.isMagicDamage}}checked{{/if}}/> Dano Mágico</label>
      <div class="field-hint-label">Elemento(s)</div>
      <div class="element-grid">
        {{#each skillElementChips as |el|}}
        <a class="element-chip {{#if el.checked}}checked{{/if}}" data-action="toggleSkillElement" data-element="{{el.id}}"><span class="dot" style="background:{{el.color}}"></span>{{el.label}}</a>
        {{else}}
        <span class="hint-inline">Nenhum elemento configurado.</span>
        {{/each}}
      </div>
      {{/if}}

      {{#if (eq system.effectType "temporary")}}
      <h4>Efeitos <span class="hint-inline">(pode combinar quantos alvos quiser)</span></h4>
      {{#if system.hasUpkeep}}
      <p class="hint-inline">Habilidade Ativa marcada: todo Efeito abaixo dura até desativar em vez da "Duração" configurada — Periódico continua tickando normalmente, só não conta pra expirar sozinho.</p>
      {{/if}}
      <ol class="sub-list">
        {{#each skillEffects as |eff|}}
        <li class="effect-row" data-index="{{eff.index}}">
          <div class="effect-row-main">
            <select class="skill-effect-input" data-effect-field="target" title="Alvo">
              {{#each eff.targetOptions as |opt|}}
              <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
              {{/each}}
            </select>
            <input type="number" class="skill-effect-input" data-effect-field="amount" value="{{eff.amount}}" placeholder="Qtd." title="Quantidade"/>
            <input type="number" class="skill-effect-input" data-effect-field="durationRounds" value="{{eff.durationRounds}}" min="0" placeholder="Rounds/Ticks" title="Duração (rounds, ou ticks se Periódico)"/>
            <a data-action="deleteSkillEffect" title="Remover"><i class="fas fa-trash"></i></a>
          </div>
          <div class="effect-row-extra">
            {{#if ../conditionsEnabled}}
            <select class="skill-effect-input" data-effect-field="conditionId" title="Condição nomeada (ícone de status no token — opcional)">
              {{#each eff.conditionOptions as |opt|}}
              <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
              {{/each}}
            </select>
            <input type="text" class="skill-effect-input" data-effect-field="icon" value="{{eff.icon}}" placeholder="herdar ícone" title="Em branco herda o da Condição (e, sem Condição, o da própria Skill)."/>
            {{/if}}
            {{#if eff.acceptsPeriodic}}
            <label class="checkbox-line small"><input type="checkbox" class="skill-effect-input" data-effect-field="periodic" {{#if eff.periodic}}checked{{/if}}/> Periódico</label>
            {{#if eff.periodic}}
            <select class="skill-effect-input" data-effect-field="tickUnit" title="Unidade de tick">
              {{#each eff.tickUnitOptions as |opt|}}
              <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
              {{/each}}
            </select>
            {{/if}}
            {{/if}}
            {{#if eff.isShipTarget}}
            <select class="skill-effect-input" data-effect-field="modifierType" title="Fixo soma direto no resultado; Multiplicador lê Quantidade como percentual (20 = ×1.20)">
              {{#each eff.modifierTypeOptions as |opt|}}
              <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
              {{/each}}
            </select>
            {{/if}}
          </div>
          {{#if eff.periodic}}
          {{#if eff.acceptsPeriodic}}
          <div class="effect-row-periodic-extra">
            <span class="hint-inline">Elemento(s) do tick de dano (ignorado se o tick for cura):</span>
            <div class="element-grid">
              {{#each eff.elementChips as |el|}}
              <a class="element-chip {{#if el.checked}}checked{{/if}}" data-action="toggleEffectElement" data-element="{{el.id}}"><span class="dot" style="background:{{el.color}}"></span>{{el.label}}</a>
              {{/each}}
            </div>
          </div>
          {{/if}}
          {{/if}}
        </li>
        {{/each}}
      </ol>
      <a class="sub-skill-add" data-action="addSkillEffect">+ Efeito</a>
      <p class="hint-inline">Quantidade negativa = debuff/drawback. Escudo ignora Duração (some só ao absorver dano). "Periódico" (só HP/{{energyLabel}}) aplica a Quantidade a CADA tick — Duração vira "quantos ticks". Reaplicar a MESMA Condição em quem já a tem apenas ESTENDE a duração.</p>
      {{/if}}

      <h4>Modificador Permanente <span class="hint-inline">(soma direto no HP/Mana Máximo enquanto a Skill estiver na ficha, sempre — sem duração)</span></h4>
      <label>HP <input type="number" name="system.statModifiers.hp" value="{{system.statModifiers.hp}}"/></label>
      <label>Mana/Energia <input type="number" name="system.statModifiers.energy" value="{{system.statModifiers.energy}}"/></label>

      <h4>Bônus de Atributo Passivo <span class="hint-inline">(sempre ativo enquanto a Skill estiver na ficha, sem usar nem escolher alvo — negativo = penalidade; soma na rolagem, nunca no HP/Mana)</span></h4>
      <ol class="sub-list">
        {{#each system.attributeBonuses as |bonus index|}}
        <li data-index="{{index}}" class="effect-row">
          <select name="system.attributeBonuses.{{index}}.attribute">
            {{#each ../visibleAttributes as |attr|}}
            <option value="{{attr.key}}" {{#if (eq attr.key bonus.attribute)}}selected{{/if}}>{{attr.label}}</option>
            {{/each}}
          </select>
          <input type="number" name="system.attributeBonuses.{{index}}.amount" value="{{bonus.amount}}"/>
          <a data-action="deleteItemAttrBonus" title="Remover"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
      <a class="item-attr-bonus-add" data-action="addItemAttrBonus">+ Bônus de Atributo</a>

      <h3>Sub-Skills</h3>
      <ol class="sub-list">
        {{#each system.subSkills as |sub index|}}
        <li data-index="{{index}}">
          <input type="text" name="system.subSkills.{{index}}.name" value="{{sub.name}}"/>
          <input type="text" name="system.subSkills.{{index}}.description" value="{{sub.description}}"/>
          <a class="sub-skill-delete" data-action="deleteSubSkill" title="Remover"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
      <a class="sub-skill-add" data-action="addSubSkill">+ Sub-Skill</a>

      {{#if system.fusionSources.length}}
      <h3>Linhagem de Fusão</h3>
      <p>{{#each system.fusionSources}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
      {{/if}}
      {{/if}}

      {{#if (eq itemType "body_part")}}
      <label>Slot <input type="text" name="system.slot" value="{{system.slot}}"/></label>
      <label>Origem (Espécie) <input type="text" name="system.speciesOrigin" value="{{system.speciesOrigin}}"/></label>
      <label>HP
        <input type="number" name="system.hp.value" value="{{system.hp.value}}"/>
        <span>/</span>
        <input type="number" name="system.hp.max" value="{{system.hp.max}}"/>
      </label>
      <label>Protética? <input type="checkbox" name="system.isProsthetic" {{#if system.isProsthetic}}checked{{/if}}/></label>

      <h3>Modificações Instaladas</h3>
      <ol class="sub-list mod-list">
        {{#each system.installedMods as |mod index|}}
        <li data-index="{{index}}" class="mod-row">
          <div class="mod-row-main">
            <input type="text" name="system.installedMods.{{index}}.name" value="{{mod.name}}" placeholder="Nome da modificação"/>
            <input type="text" name="system.installedMods.{{index}}.description" value="{{mod.description}}" placeholder="Descrição"/>
            <a class="mod-delete" data-action="deleteInstalledMod" title="Remover"><i class="fas fa-trash"></i></a>
          </div>
          <div class="mod-grant-fields">
            <input type="text" name="system.installedMods.{{index}}.grantsSkill.name" value="{{mod.grantsSkill.name}}" placeholder="Habilidade Concedida (nome)"/>
            <input type="number" name="system.installedMods.{{index}}.grantsSkill.cost" value="{{mod.grantsSkill.cost}}" placeholder="Custo"/>
            <select name="system.installedMods.{{index}}.grantsSkill.tier">
              {{#each ../config.ITEM_GRANTABLE_SKILL_TIERS as |t|}}
              <option value="{{t}}" {{#if (eq t mod.grantsSkill.tier)}}selected{{/if}}>{{lookup ../../config.SKILL_TIER_LABELS t}}</option>
              {{/each}}
            </select>
            <button type="button" class="mod-grant-toggle" data-action="toggleModGrant" data-index="{{index}}">
              {{#if mod.skillGranted}}Remover Habilidade{{else}}Conceder Habilidade{{/if}}
            </button>
          </div>
          <div class="mod-grant-fields">
            <label class="hint-inline">Mod. Permanente HP
              <input type="number" name="system.installedMods.{{index}}.statModifiers.hp" value="{{mod.statModifiers.hp}}"/>
            </label>
            <label class="hint-inline">Mod. Permanente Mana
              <input type="number" name="system.installedMods.{{index}}.statModifiers.energy" value="{{mod.statModifiers.energy}}"/>
            </label>
          </div>
          <div class="mod-attr-bonuses">
            <span class="hint-inline">Bônus de Atributo (rolagem — nunca entra no HP/Mana)</span>
            <ol class="sub-list mod-attr-bonus-list">
              {{#each mod.attributeBonuses as |bonus bIndex|}}
              <li data-index="{{index}}" data-bonus-index="{{bIndex}}" class="effect-row">
                <select name="system.installedMods.{{index}}.attributeBonuses.{{bIndex}}.attribute">
                  {{#each ../../visibleAttributes as |attr|}}
                  <option value="{{attr.key}}" {{#if (eq attr.key bonus.attribute)}}selected{{/if}}>{{attr.label}}</option>
                  {{/each}}
                </select>
                <input type="number" name="system.installedMods.{{index}}.attributeBonuses.{{bIndex}}.amount" value="{{bonus.amount}}"/>
                <a class="mod-attr-bonus-delete" data-action="deleteModAttrBonus" title="Remover"><i class="fas fa-trash"></i></a>
              </li>
              {{/each}}
            </ol>
            <a class="mod-attr-bonus-add" data-action="addModAttrBonus" data-index="{{index}}">+ Bônus de Atributo</a>
          </div>
        </li>
        {{/each}}
      </ol>
      <a class="mod-add" data-action="addInstalledMod">+ Modificação/Prótese</a>
      {{/if}}

      {{#if (eq itemType "title")}}
      <label>Concedido por <input type="text" name="system.grantedBy" value="{{system.grantedBy}}"/></label>
      <label>Raridade <input type="text" name="system.rarity" value="{{system.rarity}}"/></label>

      <h3>Bônus Permanentes <span class="hint-inline">(sempre ativos enquanto o Título estiver na ficha)</span></h3>
      <ol class="sub-list">
        {{#each system.bonuses as |bonus index|}}
        <li data-index="{{index}}">
          <select name="system.bonuses.{{index}}.attribute">
            {{#each ../titleBonusTargets as |attrKey|}}
            <option value="{{attrKey}}" {{#if (eq attrKey bonus.attribute)}}selected{{/if}}>{{lookup ../../effectTargetLabels attrKey}}</option>
            {{/each}}
          </select>
          <input type="number" name="system.bonuses.{{index}}.amount" value="{{bonus.amount}}"/>
          <a class="title-bonus-delete" data-action="deleteTitleBonus" title="Remover"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
      <a class="title-bonus-add" data-action="addTitleBonus">+ Bônus</a>

      {{#if resistancesEnabled}}
      <h3>Resistência a Dano <span class="hint-inline">(percentual fixo — não tem nível)</span></h3>
      <ol class="sub-list">
        {{#each titleResistances as |res index|}}
        <li data-index="{{index}}">
          <select name="system.resistances.{{index}}.target">
            {{#each res.targetOptions as |opt|}}
            <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
          <input type="number" name="system.resistances.{{index}}.amount" value="{{res.amount}}" min="0" max="100"/>%
          <a class="title-resistance-delete" data-action="deleteTitleResistance" title="Remover"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
      <a class="title-resistance-add" data-action="addTitleResistance">+ Resistência</a>
      {{/if}}
      {{/if}}

      {{#if (eq itemType "starship_module")}}
      <label>Categoria
        <select name="system.category">
          {{#each config.STARSHIP_MODULE_CATEGORIES as |cat|}}
          <option value="{{cat}}" {{#if (eq cat ../system.category)}}selected{{/if}}>{{lookup ../config.STARSHIP_MODULE_CATEGORY_LABELS cat}}</option>
          {{/each}}
        </select>
      </label>
      <label>Porte do Módulo
        <select name="system.moduleSize">
          {{#each config.MODULE_SIZES as |size|}}
          <option value="{{size}}" {{#if (eq size ../system.moduleSize)}}selected{{/if}}>{{lookup ../config.MODULE_SIZE_LABELS size}}</option>
          {{/each}}
        </select>
      </label>
      <p class="hint-inline module-spec-note">
        Este registro descreve o Módulo <strong>como ele é de fábrica</strong>. Vida atual,
        throttle, ligado/desligado e recarga são <strong>estado</strong> — mudam a cada rodada e
        se editam na ficha da Nave, não aqui.
      </p>
      <label>Consumo de Energia <input type="number" name="system.powerConsumption" value="{{system.powerConsumption}}"/></label>
      <label>Vida Máx.
        <input type="number" name="system.hp.max" value="{{system.hp.max}}" min="0"/>
      </label>
      <label>Slot <input type="text" name="system.slot" value="{{system.slot}}"/></label>
      {{#if (eq system.category "armor")}}
      <label>Redução de Dano (%) <span class="hint-inline" style="display:inline;">(reduz esse percentual de todo dano recebido pela Nave enquanto instalado no slot de Casco)</span>
        <input type="number" name="system.armorReduction" value="{{system.armorReduction}}" min="0" max="100"/>
      </label>
      {{/if}}


      {{#unless (or (eq system.category "reactor") (eq system.category "battery") (eq system.category "distributor"))}}
      <label>Prioridade de Energia <span class="hint-inline" style="display:inline;">(menor número = atendido primeiro pelo Distribuidor quando falta energia)</span>
        <input type="number" name="system.powerPriority" value="{{system.powerPriority}}" min="0"/>
      </label>
      {{/unless}}

      {{#if (eq system.category "reactor")}}
      <label>Output (a 100% de clock) <input type="number" name="system.reactorOutput" value="{{system.reactorOutput}}" min="0"/></label>
      {{/if}}

      {{#if (eq system.category "battery")}}
      <label>Capacidade de Armazenamento <input type="number" name="system.batteryCapacity" value="{{system.batteryCapacity}}" min="0"/></label>
      {{/if}}

      {{#if (eq system.category "distributor")}}
      <label>Fator de Distribuição <span class="hint-inline" style="display:inline;">(multiplica o baseline do Porte da Nave)</span>
        <input type="number" name="system.transferFactor" value="{{system.transferFactor}}" min="0" step="0.1"/>
      </label>
      {{#if distributorPreview}}
      <div class="factor-preview">
        <p class="factor-preview-title">Capacidade de Transferência que este Fator entrega</p>
        <table>
          <thead><tr><th>Porte da Nave</th><th>Baseline</th><th>Resultado</th></tr></thead>
          <tbody>
            {{#each distributorPreview.rows as |row|}}
            <tr class="{{#if row.current}}is-current{{/if}}">
              <td>{{row.label}}{{#if row.current}} <span class="factor-here">instalado aqui</span>{{/if}}</td>
              <td class="num">{{row.baseline}}</td>
              <td class="num strong">{{row.result}} {{../distributorPreview.abbr}}/rodada</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        <p class="hint-inline">Esse é o teto de energia que a Nave inteira consegue rotear por rodada — não por Módulo.</p>
      </div>
      {{/if}}
      {{/if}}

      {{#if (eq system.category "shield")}}
      <label>Vida Máxima (a 100% de throttle) <input type="number" name="system.shieldCapacity" value="{{system.shieldCapacity}}" min="0"/></label>
      <label>Regen por Rodada (a 100% de throttle) <input type="number" name="system.shieldRegen" value="{{system.shieldRegen}}" min="0"/></label>
      <label>Recarga (rodadas sem proteção após zerar) <input type="number" name="system.shieldRechargeRounds" value="{{system.shieldRechargeRounds}}" min="0"/></label>
      {{/if}}

      {{#if (eq system.category "engine")}}
      <label>Aceleração (a 100% de throttle) <input type="number" name="system.acceleration" value="{{system.acceleration}}" min="0"/></label>
      <label>Rotação (a 100% de throttle) <input type="number" name="system.rotation" value="{{system.rotation}}" min="0"/></label>
      {{/if}}

      {{#if (eq system.category "weapon")}}
      <label>Fórmula de Dano <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" placeholder="ex: 3d10"/></label>
      <label>Penetração (%, a 100% de throttle) <input type="number" name="system.penetration" value="{{system.penetration}}" min="0" max="100"/></label>
      <label>Recarga (rodadas, a 100% de throttle) <span class="hint-inline" style="display:inline;">(0 = sempre disponível pra disparar)</span>
        <input type="number" name="system.cooldownRounds" value="{{system.cooldownRounds}}" min="0"/>
      </label>
      {{/if}}

      {{#if (eq system.category "ftl")}}
      <label>Sub-tipo
        <select name="system.ftlType">
          <option value="warp" {{#if (eq system.ftlType "warp")}}selected{{/if}}>Dobra Espacial</option>
          <option value="jump" {{#if (eq system.ftlType "jump")}}selected{{/if}}>Salto</option>
        </select>
      </label>
      {{#if (eq system.ftlType "warp")}}
      <label>Fator de Dobra (a 100% de throttle) <input type="number" name="system.warpFactor" value="{{system.warpFactor}}" min="0" step="0.1"/></label>
      {{else}}
      <label>Alcance de Salto <input type="number" name="system.jumpRange" value="{{system.jumpRange}}" min="0"/></label>
      <label>Tempo de Carga (rodadas) <input type="number" name="system.chargeTime" value="{{system.chargeTime}}" min="0"/></label>
      {{/if}}
      {{/if}}

      <h3>Habilidade Concedida <span class="hint-inline">(à Nave, enquanto o módulo estiver "online")</span></h3>
      <label>Nome <input type="text" name="system.grantsSkill.name" value="{{system.grantsSkill.name}}"/></label>
      <label>Descrição <input type="text" name="system.grantsSkill.description" value="{{system.grantsSkill.description}}"/></label>
      <label>Custo <input type="number" name="system.grantsSkill.cost" value="{{system.grantsSkill.cost}}"/></label>
      <label>Tier
        <select name="system.grantsSkill.tier">
          {{#each config.ITEM_GRANTABLE_SKILL_TIERS as |t|}}
          <option value="{{t}}" {{#if (eq t ../system.grantsSkill.tier)}}selected{{/if}}>{{lookup ../config.SKILL_TIER_LABELS t}}</option>
          {{/each}}
        </select>
      </label>
      <p class="hint-inline">Ligar/desligar o módulo na ficha da Nave concede/remove essa Habilidade automaticamente.</p>
      {{/if}}

      {{#if (eq itemType "item")}}
      <label>Quantidade <input type="number" name="system.quantity" value="{{system.quantity}}"/></label>
      <label>Peso <input type="number" name="system.weight" value="{{system.weight}}"/></label>
      <label>Equipado? <input type="checkbox" class="item-equip-toggle" name="system.equipped" {{#if system.equipped}}checked{{/if}}/></label>
      <label>Valor
        <input type="number" name="system.value.amount" value="{{system.value.amount}}"/>
        <select name="system.value.currency">
          {{#each currencies as |currency|}}
          <option value="{{currency.id}}" {{#if (eq currency.id ../system.value.currency)}}selected{{/if}}>{{currency.label}}</option>
          {{/each}}
        </select>
      </label>
      {{#if isGM}}
      <label>Dispositivo PAD? <input type="checkbox" name="system.isPadDevice" {{#if system.isPadDevice}}checked{{/if}}/></label>
      <p class="hint-inline">Marca este Item como um PAD físico — quem possuir ao menos um ganha o botão "Abrir PAD" na própria ficha (não precisa estar equipado).</p>
      {{/if}}

      <h3>Habilidade Concedida <span class="hint-inline">(ao dono, enquanto o item estiver equipado)</span></h3>
      <label>Nome <input type="text" name="system.grantsSkill.name" value="{{system.grantsSkill.name}}"/></label>
      <label>Descrição <input type="text" name="system.grantsSkill.description" value="{{system.grantsSkill.description}}"/></label>
      <label>Custo <input type="number" name="system.grantsSkill.cost" value="{{system.grantsSkill.cost}}"/></label>
      <label>Tier
        <select name="system.grantsSkill.tier">
          {{#each config.ITEM_GRANTABLE_SKILL_TIERS as |t|}}
          <option value="{{t}}" {{#if (eq t ../system.grantsSkill.tier)}}selected{{/if}}>{{lookup ../config.SKILL_TIER_LABELS t}}</option>
          {{/each}}
        </select>
      </label>
      <p class="hint-inline">Marcar/desmarcar "Equipado" concede/remove essa Habilidade automaticamente.</p>

      <h3>Modificador Permanente <span class="hint-inline">(soma direto no HP/Mana Máximo enquanto o item estiver equipado)</span></h3>
      <label>HP <input type="number" name="system.statModifiers.hp" value="{{system.statModifiers.hp}}"/></label>
      <label>Mana/Energia <input type="number" name="system.statModifiers.energy" value="{{system.statModifiers.energy}}"/></label>

      <h3>Bônus de Atributo <span class="hint-inline">(afeta a rolagem enquanto equipado — nunca entra no cálculo de HP/Mana)</span></h3>
      <ol class="sub-list">
        {{#each system.attributeBonuses as |bonus index|}}
        <li data-index="{{index}}" class="effect-row">
          <select name="system.attributeBonuses.{{index}}.attribute">
            {{#each ../visibleAttributes as |attr|}}
            <option value="{{attr.key}}" {{#if (eq attr.key bonus.attribute)}}selected{{/if}}>{{attr.label}}</option>
            {{/each}}
          </select>
          <input type="number" name="system.attributeBonuses.{{index}}.amount" value="{{bonus.amount}}"/>
          <a class="item-attr-bonus-delete" data-action="deleteItemAttrBonus" title="Remover"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
      <a class="item-attr-bonus-add" data-action="addItemAttrBonus">+ Bônus de Atributo</a>
      {{/if}}

    </div>
  </section>
</div>
