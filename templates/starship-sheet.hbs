<div class="nihility-sheet starship-sheet">

  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editImage" title="{{actor.name}}"/>
    <div class="header-fields">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Nome"/>
      <div class="header-row">
        <span class="chip">{{#if isVehicle}}Veículo{{else}}Nave Espacial{{/if}}</span>
        <label class="ship-size-field">Porte
          <select name="system.shipSize" {{#unless isGM}}disabled{{/unless}}>
            {{#each shipSizeOptions as |opt|}}
            <option value="{{opt.id}}" {{#if (eq opt.id ../system.shipSize)}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
        </label>
        {{#unless isGM}}<span class="hint-inline" style="margin:0;">(só o Mestre edita)</span>{{/unless}}
      </div>
    </div>

    <div class="resources">
      <div class="vital-row">
        <span class="vital-label">Escudos</span>
        <span class="vital-track"><span class="vital-fill energy state-{{shieldState}}" style="width:{{shieldPercent}}%"></span></span>
        <span class="vital-value">
          <input type="number" name="system.shields.value" value="{{system.shields.value}}"/>/{{system.shields.max}}<span class="vital-percent">{{shieldPercent}}%</span>
        </span>
        {{#unless shieldModule}}<span class="hint-inline" style="margin-left:4px;">(sem Escudo instalado)</span>{{/unless}}
        {{#if system.shields.rechargeRemaining}}<span class="hint-inline" style="margin-left:4px;">(Recarga: {{system.shields.rechargeRemaining}})</span>{{/if}}
        {{#if isGM}}
        <a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="shields" title="Ajustar Escudos/Recarga"><i class="fas fa-plus"></i></a>
        {{/if}}
      </div>
      {{#if isGM}}
      <div class="vital-adjust-popover" data-key="shields">
        <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
        <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="actor" data-field="shields.value" data-max-field="shields.max" data-dir="-1">− Dano</button>
        <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="actor" data-field="shields.value" data-max-field="shields.max" data-dir="1">+ Reparo</button>
        <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="actor" data-field="shields.rechargeRemaining" data-dir="-1">− Recarga</button>
        <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="actor" data-field="shields.rechargeRemaining" data-dir="1">+ Recarga</button>
      </div>
      {{/if}}
      <div class="vital-row">
        <span class="vital-label">Casco</span>
        <span class="vital-track"><span class="vital-fill hp state-{{cascoState}}" style="width:{{cascoPercent}}%"></span></span>
        <span class="vital-value">
          <span class="vital-derived">{{system.casco.value}}</span>/{{system.casco.max}}<span class="vital-percent">{{cascoPercent}}%</span>
        </span>
        {{#unless armorModule}}<span class="hint-inline" style="margin-left:4px;">(sem Casco instalado)</span>{{/unless}}
        <span class="hint-inline vital-source" title="O Casco é a Vida do Módulo de armadura — ajuste na linha dele, logo abaixo em Módulos Especiais.">= Vida do Módulo de Casco</span>
      </div>
      <div class="vital-row">
        <span class="vital-label">Integridade Estrutural</span>
        <span class="vital-track"><span class="vital-fill hp state-{{structureState}}" style="width:{{structurePercent}}%"></span></span>
        <span class="vital-value">
          <span class="vital-derived">{{system.hull.value}}</span>/<span class="vital-derived">{{system.hull.max}}</span><span class="vital-percent">{{structurePercent}}%</span>
        </span>
        <span class="hint-inline vital-source" title="Soma da Vida dos Módulos estruturais (tudo menos Casco, Escudo e Armas) — ajuste na linha de cada Módulo.">= soma dos Módulos estruturais</span>
      </div>
            {{#if isVehicle}}
      <div class="vital-row">
        <span class="vital-label">Velocidade</span>
        <span class="vital-value">{{system.speed}}{{#unless engineModule}}<span class="hint-inline" style="margin-left:4px;">(sem Motor instalado)</span>{{/unless}}</span>
      </div>
      <div class="vital-row">
        <span class="vital-label">{{#if (eq system.fuel.type "battery")}}Bateria{{else}}Combustível{{/if}}</span>
        <span class="vital-track"><span class="vital-fill energy" style="width:{{fuelPercent}}%"></span></span>
        <span class="vital-value">
          <input type="number" name="system.fuel.value" value="{{system.fuel.value}}"/>/<input type="number" name="system.fuel.max" value="{{system.fuel.max}}"/>
        </span>
      </div>
      {{else}}
      <div class="vital-row">
        <span class="vital-label">Manobra</span>
        <span class="vital-value">{{system.maneuverability}}{{#unless engineModule}}<span class="hint-inline" style="margin-left:4px;">(sem Motor instalado)</span>{{/unless}}</span>
      </div>
      {{/if}}
    </div>
  </header>

  <nav class="sheet-tabs tabs">
    <a class="item {{#if (eq activeTab "sistemas")}}active{{/if}}" data-action="selectTab" data-tab="sistemas">Sistemas</a>
    <a class="item {{#if (eq activeTab "armas")}}active{{/if}}" data-action="selectTab" data-tab="armas">Armas</a>
    <a class="item {{#if (eq activeTab "skills")}}active{{/if}}" data-action="selectTab" data-tab="skills">Habilidades</a>
    {{#if padShipEnabled}}
    <a class="item {{#if (eq activeTab "tripulacao")}}active{{/if}}" data-action="selectTab" data-tab="tripulacao">Tripulação</a>
    {{/if}}
    <a class="item {{#if (eq activeTab "biography")}}active{{/if}}" data-action="selectTab" data-tab="biography">Registro</a>
  </nav>

  <section class="sheet-body">

    <div class="tab {{#unless (eq activeTab "sistemas")}}hidden{{/unless}}">
      <div class="block">
        <p class="block-title">Grid de Energia — {{energyLabel}}</p>
        <div class="power-chain {{#if isOverloaded}}overloaded{{/if}}">
          <div class="chain-node">
            <span class="chain-label">Reator · geração</span>
            <span class="chain-value">{{system.powerGrid.reactorOutput}}</span>
            <span class="chain-sub">{{#if reactorModule}}{{reactorModule.name}}{{else}}sem Reator instalado{{/if}}</span>
          </div>

          <div class="chain-node {{#if distributorIsBottleneck}}is-bottleneck{{/if}}">
            <span class="chain-label">Distribuidor · teto</span>
            <span class="chain-value">{{transferCapacity}}</span>
            <span class="chain-sub">
              {{#if distributorIsBottleneck}}limitando — o Reator gera mais{{else}}{{#if distributorModule}}{{distributorModule.name}}{{else}}sem Distribuidor instalado{{/if}}{{/if}}
            </span>
          </div>

          <div class="chain-node">
            <span class="chain-label">Capacitor · reserva</span>
            <span class="chain-value">
              <input type="number" name="system.powerGrid.capacitor.value" value="{{system.powerGrid.capacitor.value}}"/>
              <small>/ {{system.powerGrid.capacitor.max}}</small>
            </span>
            <span class="chain-sub">{{#if batteryModule}}{{batteryModule.name}}{{else}}conduítes do casco — sem Bateria{{/if}}</span>
          </div>
        </div>

        <div class="power-demand {{#if isOverloaded}}overloaded{{/if}}">
          <div class="demand-head">
            <span class="chain-label">Demanda</span>
            <span class="demand-figure">{{totalConsumption}} / {{powerCeiling}} {{energyAbbr}}</span>
          </div>
          <div class="demand-bar">
            <i class="demand-used" style="width:{{demandPercent}}%"></i>
          </div>
          <div class="demand-legend">
            <span><b class="swatch used"></b>consumo dos Módulos online</span>
            {{#if demandSlack}}<span><b class="swatch free"></b>folga de {{demandSlack}} {{energyAbbr}}</span>{{/if}}
            {{#if isOverloaded}}<span class="demand-over">⚠ demanda acima do que a Nave entrega</span>{{/if}}
          </div>
        </div>

        <button type="button" class="power-grid-tick" data-action="powerGridTick">Recalcular Grid de Energia</button>
      </div>

      <div class="block">
        <p class="block-title">Módulos Especiais <span class="hint-inline" style="margin:0">(slot único cada)</span></p>
        <div class="module-grid">
          <div class="module-grid-head">
            <span>Categoria</span><span>Módulo</span><span>Vida</span><span>Consumo</span><span>Throttle</span><span class="acts-head">Ações</span>
          </div>
          {{#each specialModuleRows as |row|}}
          <div class="module-grid-row {{#unless row.online}}is-offline{{/unless}} {{#if row.starved}}is-starved{{/if}}" data-item-id="{{row.id}}">
            <span class="cat-pill cat-{{row.category}}" title="{{row.categoryLabel}} · Porte {{row.sizeLabel}}">{{row.categoryLabel}}</span>

            <span class="module-name-cell">
              <span class="module-name">{{row.name}}</span>
              {{#if row.starved}}
              <small class="module-starved">⚠ recebendo {{row.powerRatio}}% da energia pedida</small>
              {{else}}
              <small class="module-detail">{{row.detail}}{{#unless row.online}} · desligado{{/unless}}</small>
              {{/if}}
            </span>

            <span class="module-hp-cell" title="A Vida escala o desempenho: um Módulo a 50% entrega 50%.">
              <span class="module-meter state-{{row.hpState}}"><span style="width:{{row.hpPercent}}%"></span></span>
              {{#if ../isGM}}
              <small class="module-hp-edit">
                <input type="number" class="module-hp-input" value="{{row.hpValue}}" min="0" max="{{row.hpMax}}"/>/{{row.hpMax}}
                <span class="module-hp-percent">{{row.hpPercent}}%</span>
              </small>
              {{else}}
              <small>{{row.hpValue}}/{{row.hpMax}} <span class="module-hp-percent">{{row.hpPercent}}%</span></small>
              {{/if}}
            </span>

            <span class="module-consumption">{{row.consumption}} {{../energyAbbr}}</span>

            <span class="throttle {{row.throttleState}}">
              {{#if ../canAdjustThrottle}}
              <button type="button" data-action="adjustThrottle" data-step="-20" title="−20%">⏬</button>
              <button type="button" data-action="adjustThrottle" data-step="-5" title="−5%">−</button>
              <input type="number" class="throttle-input" value="{{row.throttle}}" min="0" step="5" title="Throttle (%) — abaixo de 100 economiza, acima sobrecarrega"/>
              <button type="button" data-action="adjustThrottle" data-step="5" title="+5%">+</button>
              <button type="button" data-action="adjustThrottle" data-step="20" title="+20%">⏫</button>
              {{else}}
              <span class="throttle-readonly">{{row.throttle}}%</span>
              {{/if}}
            </span>

            <span class="module-acts">
              <a class="module-toggle-power" data-action="toggleModulePower" title="Ligar/Desligar"><i class="fas fa-power-off"></i></a>
              {{#if ../isGM}}<a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="module-hp-{{row.id}}" title="Ajustar Vida"><i class="fas fa-plus"></i></a>{{/if}}
              <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
              <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
            </span>
          </div>
          {{#if ../isGM}}
          <div class="vital-adjust-popover" data-key="module-hp-{{row.id}}">
            <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
            <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="-1">− Dano</button>
            <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="1">+ Reparo</button>
          </div>
          {{/if}}
          {{/each}}
        </div>
        {{#unless specialModules.length}}<p class="hint-inline">Nenhum módulo especial (Reator/Bateria/Distribuidor/Escudo/Motor/Casco/FTL) instalado.</p>{{/unless}}
      </div>

      <div class="block">
        <p class="block-title">Módulos</p>
        <div class="module-grid">
          <div class="module-grid-head">
            <span>Categoria</span><span>Módulo</span><span>Vida</span><span>Consumo</span><span>Throttle</span><span class="acts-head">Ações</span>
          </div>
          {{#each moduleRows as |row|}}
          <div class="module-grid-row {{#unless row.online}}is-offline{{/unless}} {{#if row.starved}}is-starved{{/if}}" data-item-id="{{row.id}}">
            <span class="cat-pill cat-{{row.category}}" title="{{row.categoryLabel}} · Porte {{row.sizeLabel}}">{{row.categoryLabel}}</span>

            <span class="module-name-cell">
              <span class="module-name">{{row.name}}</span>
              {{#if row.starved}}
              <small class="module-starved">⚠ recebendo {{row.powerRatio}}% da energia pedida</small>
              {{else}}
              <small class="module-detail">{{row.detail}}{{#unless row.online}} · desligado{{/unless}}</small>
              {{/if}}
            </span>

            <span class="module-hp-cell" title="A Vida escala o desempenho: um Módulo a 50% entrega 50%.">
              <span class="module-meter state-{{row.hpState}}"><span style="width:{{row.hpPercent}}%"></span></span>
              {{#if ../isGM}}
              <small class="module-hp-edit">
                <input type="number" class="module-hp-input" value="{{row.hpValue}}" min="0" max="{{row.hpMax}}"/>/{{row.hpMax}}
                <span class="module-hp-percent">{{row.hpPercent}}%</span>
              </small>
              {{else}}
              <small>{{row.hpValue}}/{{row.hpMax}} <span class="module-hp-percent">{{row.hpPercent}}%</span></small>
              {{/if}}
            </span>

            <span class="module-consumption">{{row.consumption}} {{../energyAbbr}}</span>

            <span class="throttle {{row.throttleState}}">
              {{#if ../canAdjustThrottle}}
              <button type="button" data-action="adjustThrottle" data-step="-20" title="−20%">⏬</button>
              <button type="button" data-action="adjustThrottle" data-step="-5" title="−5%">−</button>
              <input type="number" class="throttle-input" value="{{row.throttle}}" min="0" step="5" title="Throttle (%) — abaixo de 100 economiza, acima sobrecarrega"/>
              <button type="button" data-action="adjustThrottle" data-step="5" title="+5%">+</button>
              <button type="button" data-action="adjustThrottle" data-step="20" title="+20%">⏫</button>
              {{else}}
              <span class="throttle-readonly">{{row.throttle}}%</span>
              {{/if}}
            </span>

            <span class="module-acts">
              <a class="module-toggle-power" data-action="toggleModulePower" title="Ligar/Desligar"><i class="fas fa-power-off"></i></a>
              {{#if ../isGM}}<a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="module-hp-{{row.id}}" title="Ajustar Vida"><i class="fas fa-plus"></i></a>{{/if}}
              <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
              <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
            </span>
          </div>
          {{#if ../isGM}}
          <div class="vital-adjust-popover" data-key="module-hp-{{row.id}}">
            <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
            <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="-1">− Dano</button>
            <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="1">+ Reparo</button>
          </div>
          {{/if}}
          {{/each}}
        </div>
        <a class="item-create" data-action="createItem" data-type="starship_module">+ Novo Módulo</a>
      </div>

      {{#if isVehicle}}
      <div class="block">
        <p class="block-title">Peças Instaladas</p>
        <ol class="item-list">
          {{#each parts as |part|}}
          <li class="item-row" data-item-id="{{part.id}}">
            <img src="{{part.img}}" width="24" height="24"/>
            <span class="item-name">{{part.name}}</span>
            <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
            <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
          </li>
          {{/each}}
        </ol>
        <a class="item-create" data-action="createItem" data-type="item">+ Nova Peça</a>
      </div>
      {{/if}}
    </div>

    <div class="tab {{#unless (eq activeTab "armas")}}hidden{{/unless}}">
      <div class="block">
        <p class="block-title">Armas <span class="hint-inline" style="margin:0">({{weaponBudgetLabel}})</span></p>
        <div class="module-grid weapon-grid">
          <div class="module-grid-head weapon-grid-head">
            <span>Porte</span><span>Arma</span><span>Dano · Penetração</span><span>Throttle</span><span class="acts-head">Disparar · Ações</span>
          </div>
          {{#each weaponRows as |row|}}
          <div class="module-grid-row weapon-grid-row {{#unless row.online}}is-offline{{/unless}} {{#if row.starved}}is-starved{{/if}}" data-item-id="{{row.id}}">
            <span class="cat-pill cat-weapon" title="Porte {{row.sizeLabel}}">{{row.sizeLabel}}</span>

            <span class="module-name-cell">
              <span class="module-name">{{row.name}}</span>
              {{#if row.starved}}
              <small class="module-starved">⚠ recebendo {{row.powerRatio}}% da energia pedida</small>
              {{else}}
              <small class="module-detail">custo {{row.consumption}} {{../energyAbbr}} · Vida {{row.hpValue}}/{{row.hpMax}}{{#unless row.online}} · desligada{{/unless}}</small>
              {{/if}}
            </span>

            <span class="weapon-stat">
              {{#if row.damageFormula}}{{row.damageFormula}}{{else}}<span class="weapon-nodamage">sem fórmula</span>{{/if}}
              <small>penetra {{row.penetration}}%</small>
            </span>

            <span class="throttle {{row.throttleState}}">
              {{#if ../canAdjustThrottle}}
              <button type="button" data-action="adjustThrottle" data-step="-20" title="−20%">⏬</button>
              <button type="button" data-action="adjustThrottle" data-step="-5" title="−5%">−</button>
              <input type="number" class="throttle-input" value="{{row.throttle}}" min="0" step="5" title="Throttle (%) — em Arma, acima de 100 aumenta Dano e Penetração E alonga a Recarga na mesma proporção; nunca danifica o Módulo"/>
              <button type="button" data-action="adjustThrottle" data-step="5" title="+5%">+</button>
              <button type="button" data-action="adjustThrottle" data-step="20" title="+20%">⏫</button>
              {{else}}
              <span class="throttle-readonly">{{row.throttle}}%</span>
              {{/if}}
            </span>

            <span class="module-acts weapon-acts">
              {{#if row.cooldownRemaining}}
              <span class="cooldown-chip" title="Rodadas restantes de Recarga">⏳ {{row.cooldownRemaining}}</span>
              <button type="button" class="fire-btn" data-action="fireWeapon" disabled title="Em recarga">Disparar</button>
              {{else}}
              <button type="button" class="fire-btn" data-action="fireWeapon" title="Disparar">Disparar</button>
              {{/if}}
              <a class="module-toggle-power" data-action="toggleModulePower" title="Ligar/Desligar"><i class="fas fa-power-off"></i></a>
              {{#if ../isGM}}
              <a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="module-hp-{{row.id}}" title="Ajustar Vida"><i class="fas fa-plus"></i></a>
              <a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="module-cooldown-{{row.id}}" title="Ajustar Recarga"><i class="fas fa-clock"></i></a>
              {{/if}}
              <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
              <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
            </span>
          </div>
          {{#if ../isGM}}
          <div class="vital-adjust-popover" data-key="module-hp-{{row.id}}">
            <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
            <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="-1">− Dano</button>
            <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="1">+ Reparo</button>
          </div>
          <div class="vital-adjust-popover" data-key="module-cooldown-{{row.id}}">
            <input type="number" class="vital-adjust-input" min="0" placeholder="Rodadas"/>
            <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="cooldownRemaining" data-dir="-1">− Recarga</button>
            <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="cooldownRemaining" data-dir="1">+ Recarga</button>
          </div>
          {{/if}}
          {{/each}}
        </div>
        {{#unless weaponModules.length}}<p class="hint-inline">Nenhuma Arma instalada.</p>{{/unless}}
        <a class="item-create" data-action="createItem" data-type="starship_module" data-category="weapon">+ Nova Arma</a>
      </div>
    </div>

    <div class="tab {{#unless (eq activeTab "skills")}}hidden{{/unless}}">
      <div class="block">
        <p class="hint-inline">Concedidas automaticamente pelos Módulos "online" — sem pontos nem fusão.</p>
        <ol class="item-list">
          {{#each skills as |skill|}}
          <li class="item-row" data-item-id="{{skill.id}}">
            <img src="{{skill.img}}" width="24" height="24"/>
            <span class="item-name">{{skill.name}}</span>
            <span class="item-cost">Custo: {{skill.system.cost}}{{#if skill.system.hasUpkeep}} + {{skill.system.upkeepCost}}/rodada{{/if}}</span>
            {{#if skill.system.active}}
            <button type="button" class="skill-use-button active" data-action="useSkill" title="Desativar (drenando {{skill.system.upkeepCost}} de {{../energyLabel}} do Reator por rodada)">🔥 Desativar</button>
            {{else if (eq skill.system.effectType "damage")}}
            <button type="button" class="skill-use-button" data-action="useSkill" title="Usar Habilidade">🎲 Usar</button>
            {{else}}
            <button type="button" class="skill-use-button" data-action="useSkill" title="Usar Habilidade{{#if skill.system.hasUpkeep}} (Ativa — drena {{../energyLabel}} do Reator por rodada até desativar){{/if}}">✨ Usar</button>
            {{/if}}
            <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
          </li>
          {{/each}}
        </ol>
      </div>
    </div>

    {{#if padShipEnabled}}
    <div class="tab {{#unless (eq activeTab "tripulacao")}}hidden{{/unless}}">
      <div class="block">
        <p class="block-title">Tripulação</p>
        <ol class="item-list crew-list">
          {{#each crewActors as |entry|}}
          <li class="item-row crew-row">
            <img src="{{entry.actor.img}}" width="24" height="24"/>
            <span class="item-name">{{entry.actor.name}}</span>
            {{#if ../isGM}}
            <input type="text" class="crew-role-input" data-actor-uuid="{{entry.actorUuid}}" value="{{entry.role}}" placeholder="Cargo (ex: Piloto)"/>
            <a class="item-delete" data-action="removeCrew" data-actor-uuid="{{entry.actorUuid}}" title="Remover tripulante"><i class="fas fa-trash"></i></a>
            {{else}}
            {{#if entry.role}}<span class="cat-pill">{{entry.role}}</span>{{/if}}
            {{/if}}
          </li>
          {{/each}}
        </ol>
        {{#unless crewActors.length}}<p class="hint-inline">Nenhum tripulante designado.</p>{{/unless}}

        {{#if isGM}}
        <div class="crew-dropzone">Arraste um Personagem (PJ ou NPC) aqui pra designá-lo como tripulante.</div>
        {{/if}}
      </div>
    </div>
    {{/if}}

    <div class="tab {{#unless (eq activeTab "biography")}}hidden{{/unless}}">
      <div class="block">
        {{#if owner}}
      <prose-mirror name="system.biography" value="{{system.biography}}"></prose-mirror>
      {{else}}
      <div class="rich-text-readonly">{{{system.biography}}}</div>
      {{/if}}
      </div>
    </div>

  </section>
</div>
