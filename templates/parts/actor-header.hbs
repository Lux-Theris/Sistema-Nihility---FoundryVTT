<header class="sheet-header">
  <div class="profile-frame" data-edit="img" data-action="editImage" title="{{actor.name}} — clique para trocar a imagem">
    <img class="profile-frame-img" src="{{actor.img}}" style="{{portraitStyle actor}}"/>
    <button type="button" class="profile-frame-adjust" data-action="editPortraitFrame" title="Ajustar enquadramento (zoom e posição)"><i class="fas fa-crop-simple"></i></button>
  </div>
  <div class="header-fields">
    <input name="name" type="text" value="{{actor.name}}" placeholder="Nome"/>
    {{#if creation}}
    <label class="creation-concept"><span>Conceito · uma frase</span>
      <input type="text" class="creation-concept-input" name="system.concept" value="{{system.concept}}" placeholder="Quem você quer jogar? Ex.: Dragoide exilado que quer reconquistar a ilha do pai"/>
    </label>
    <div class="creation-upload">
      <button type="button" data-upload-button="portrait" {{#unless canUpload}}disabled title="Peça ao Mestre a permissão 'Enviar arquivos'"{{/unless}}>Enviar imagem…</button>
      <button type="button" data-upload-button="token" {{#unless canUpload}}disabled title="Peça ao Mestre a permissão 'Enviar arquivos'"{{/unless}}>Enviar imagem do Token…</button>
      {{#if canUseGallery}}
      <button type="button" data-gallery-button="portrait" title="Escolher uma imagem que você já enviou">Minhas imagens…</button>
      <button type="button" data-gallery-button="token" title="Escolher uma imagem que você já enviou para o Token">Minhas imagens (Token)…</button>
      {{/if}}
      <input type="file" accept="image/*" data-upload-input="portrait" hidden/>
      <input type="file" accept="image/*" data-upload-input="token" hidden/>
    </div>
    {{/if}}

    <div class="header-row">
      {{#if creation}}
      <a class="origin-pill" data-action="tab" data-group="primary" data-tab="origin" title="Escolher na aba Origem">
        <span>{{#if system.species}}{{origin.speciesLabel}}{{#if origin.lineageLabel}} · {{origin.lineageLabel}}{{/if}}{{else}}Sem Espécie: escolha na aba Origem{{/if}}</span>
      </a>
      {{else if origin.canChooseHere}}
      <label>Espécie
        <select class="species-select" {{#if speciesLocked}}disabled title="Definida: só o Mestre troca"{{/if}}>
          <option value="" {{#unless system.species}}selected{{/unless}}>—</option>
          {{#each speciesOptions as |option|}}
            <option value="{{option.key}}" {{#if (eq option.key ../system.species)}}selected{{/if}}>{{option.label}}</option>
          {{/each}}
        </select>
      </label>
      {{#if origin.hasLineages}}
      <label>Linhagem{{#if origin.lineageRequired}} <span class="origin-required">*</span>{{/if}}
        <select class="lineage-select">
          <option value="" {{#unless origin.lineageId}}selected{{/unless}}>—</option>
          {{#each origin.lineageOptions as |l|}}<option value="{{l.id}}" {{#if l.selected}}selected{{/if}}>{{l.label}}</option>{{/each}}
        </select>
      </label>
      {{/if}}
      {{else}}
      <a class="origin-pill" data-action="tab" data-group="primary" data-tab="origin" title="Ver a origem (aba Origem)">
        <span>{{origin.speciesLabel}}</span>{{#if origin.lineageLabel}}<span class="sep">·</span><span class="lin">{{origin.lineageLabel}}</span>{{/if}}
        {{#each origin.heritages as |h|}}<span class="sep">·</span><span class="origin-hchip">{{h.label}}</span>{{/each}}
        {{#if origin.locked}}<i class="fas fa-lock" title="Definida: só o Mestre troca"></i>{{/if}}
        {{#if origin.outdated}}<span class="origin-outdated">Espécie mudou</span>{{/if}}
      </a>
      {{/if}}

      <label>Nível
        <input type="number" name="system.attributes.level" value="{{system.attributes.level}}" {{#unless isGM}}readonly{{/unless}}/>
        {{#if isGM}}<button type="button" class="level-up-button" data-action="levelUpActor" title="Level Up (Voz do Mundo avisa)">+</button>{{/if}}
      </label>
      {{#if timePill}}<span class="time-pill {{#unless timePill.fast}}slow{{/unless}}" title="Ritmo do tempo: Acelerado tem uma reserva de tempo por turno (os números por turno passam de uma vez); Desacelerado vive o tempo mais devagar.">{{timePill.label}}{{#if timePill.reserve}} <span class="time-bar"><i style="width: {{timePill.reserve.percent}}%;"></i></span> <span class="time-num">{{timePill.reserve.value}} / {{timePill.reserve.max}}</span> de tempo{{/if}}</span>{{/if}}
      {{#if ageEnabled}}
      {{#if ageShown}}<span class="age-pill" title="Sobe com o tempo pessoal do personagem (não com o tempo do mundo).">Idade {{age}}</span>{{/if}}
      {{#if isGM}}
      <label class="age-start" title="Opcional. Vazio = a ficha não mostra idade. Preencha: a idade sobe com o tempo pessoal a partir deste momento (anos do calendário do mundo).">Idade ao começar
        <input type="number" min="0" step="1" name="system.ageStart" value="{{system.ageStart}}" placeholder="anos"/>
      </label>
      {{/if}}
      {{/if}}

      {{#if isGM}}
      <label class="pc-toggle" title="Desmarcado = NPC. Decide o grupo da ficha (Fichas, contatos do PAD, alvos) e a regra da Vida 0: NPC — ou ficha sem jogador dono — morre direto em 0, se a opção estiver ligada.">
        <input type="checkbox" name="system.isPlayerCharacter" {{#if system.isPlayerCharacter}}checked{{/if}}/> PJ
      </label>
      {{/if}}
      {{#if isGM}}
      <label class="pc-toggle" title="Molde de forma: esta ficha é o corpo de uma Habilidade de Forma (um personagem se transforma em uma cópia dela). Fica fora das listas dos jogadores e do Simulador de encontro.">
        <input type="checkbox" name="system.formTemplate" {{#if system.formTemplate}}checked{{/if}}/> Molde de forma
      </label>
      {{/if}}
      {{#if npcTierOptions}}
      <label class="npc-tier-select" title="Nível de NPC (só o Mestre vê). Lacaio: Vida 1. Elite e Chefe: a Vida máxima multiplica (Módulos do Sistema › Níveis de NPC).">NPC
        <select name="system.npcTier">
          {{#each npcTierOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      {{/if}}

      {{#if titlesEnabled}}{{#unless trim.titles.hide}}
      <span class="chip violet">{{titles.length}} Título(s) sempre ativo(s)</span>
      {{/unless}}{{/if}}

      {{#if showPadButton}}
      <button type="button" class="pad-open-button {{#if padUnread}}has-unread{{/if}}" data-action="openPad" title="Abrir PAD{{#if padUnread}} — {{padUnread}} mensagem(ns) não lida(s){{/if}}">
        <i class="fas fa-mobile-screen-button"></i> PAD
        {{#if padUnread}}<span class="pad-unread-badge">{{padUnread}}</span>{{/if}}
      </button>
      {{/if}}
    </div>
    {{> nihility.traits traits=traits isGM=isGM scaleOptions=scaleOptions}}
  </div>

  <div class="resources">
    <div class="vital-row" data-vital="hp">
      <span class="vital-label">HP</span>
      <span class="vital-track"><span class="vital-fill hp" style="width:{{hpPercent}}%"></span></span>
      <span class="vital-value">
        <input type="number" name="system.attributes.hp.value" value="{{system.attributes.hp.value}}"/>/<input type="number" name="system.attributes.hp.max" value="{{system.attributes.hp.max}}"/>
      </span>
      <a class="stat-explain" data-action="explainStat" data-stat="hp" title="De onde vem a Vida máxima"><i class="fas fa-circle-info"></i></a>
      <a class="vital-adjust-toggle" data-action="toggleVitalAdjust" title="Ajustar HP"><i class="fas fa-plus"></i></a>
    </div>
    <div class="vital-adjust-popover" data-vital="hp">
      <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
      <button type="button" class="vital-adjust-btn dmg" data-action="adjustVital" data-vital="hp" data-dir="-1">− Dano</button>
      <button type="button" class="vital-adjust-btn heal" data-action="adjustVital" data-vital="hp" data-dir="1">+ Cura</button>
    </div>

    {{#if energyPoolEnabled}}
    <div class="vital-row" data-vital="energy">
      <span class="vital-label">{{energyLabel}}</span>
      <span class="vital-track"><span class="vital-fill energy" style="width:{{energyPercent}}%"></span></span>
      <span class="vital-value">
        <input type="number" name="system.attributes.energy.value" value="{{system.attributes.energy.value}}"/>/<input type="number" name="system.attributes.energy.max" value="{{system.attributes.energy.max}}"/>
      </span>
      <a class="stat-explain" data-action="explainStat" data-stat="energy" title="De onde vem a {{energyLabel}} máxima"><i class="fas fa-circle-info"></i></a>
      <a class="vital-adjust-toggle" data-action="toggleVitalAdjust" title="Ajustar {{energyLabel}}"><i class="fas fa-plus"></i></a>
    </div>
    <div class="vital-adjust-popover" data-vital="energy">
      <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
      <button type="button" class="vital-adjust-btn dmg" data-action="adjustVital" data-vital="energy" data-dir="-1">− Gastar</button>
      <button type="button" class="vital-adjust-btn heal" data-action="adjustVital" data-vital="energy" data-dir="1">+ Restaurar</button>
    </div>
    {{/if}}

    {{#if shieldValue}}
    <div class="vital-row shield-row">
      <span class="vital-label">🛡 Escudo</span>
      <span class="vital-value shield-value">
        <input type="number" name="system.attributes.shield.value" value="{{system.attributes.shield.value}}"/>
      </span>
      {{#if shieldPoolsText}}<span class="shield-pools" title="Cada Skill de Escudo tem o seu pool; o mais recente apanha primeiro, e a Penetração age em cada um.">{{shieldPoolsText}}</span>{{/if}}
    </div>
    {{/if}}

    <button type="button" class="rest-button" data-action="restActor">
      <i class="fas fa-moon"></i> Descansar… <span class="hint-inline">(Curto ou Completo)</span>
    </button>
    {{#if canSeeEffects}}<button type="button" class="initiative-button effects-list-button" data-action="openEffectsList" title="Tudo o que está agindo sobre este personagem: efeitos, Escudos, Skills Ativas, Estruturas">✦ Efeitos{{#if effectsCount}} ({{effectsCount}}){{/if}}</button>{{/if}}
    <button type="button" class="initiative-button" data-action="rollInitiative" title="Rola {{initiativeLabel}} no pool de dados e lança no rastreador de combate">⚔ Iniciativa</button>
    {{#if movementDash}}
    <button type="button" class="initiative-button dash-button {{#if movementDash.active}}is-active{{/if}}" data-action="toggleDash" {{#unless movementDash.canToggle}}disabled{{/unless}} title="Dobra o deslocamento deste turno. Só no seu turno.">🏃 {{#if movementDash.active}}Correndo (×2){{else}}Correr{{/if}}</button>
    {{/if}}

    {{#if activeConditions.length}}
    <div class="active-conditions">
      {{#each activeConditions as |c|}}
      <div class="condition-chip" data-effect-id="{{c.id}}" title="{{c.name}}">
        <img src="{{c.img}}" width="18" height="18"/>
        <span class="condition-chip-name">{{c.name}}</span>
        {{#if c.periodic}}
          <span class="condition-chip-remaining">{{#if c.tiedToActive}}até desativar{{else}}{{c.ticksRemaining}} tick(s){{/if}}</span>
          {{#if c.manual}}
          <a class="condition-chip-tick" data-action="applyManualTick" title="Aplicar Tick"><i class="fas fa-hourglass-half"></i></a>
          {{/if}}
        {{else if c.tiedToActive}}
          <span class="condition-chip-remaining">até desativar</span>
        {{else if c.roundsRemaining}}
          <span class="condition-chip-remaining">{{c.roundsRemaining}} round(s)</span>
        {{/if}}
        <a class="condition-chip-delete" data-action="deleteCondition" title="Remover"><i class="fas fa-times"></i></a>
      </div>
      {{/each}}
    </div>
    {{/if}}
  </div>
</header>
