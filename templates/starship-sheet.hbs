<div class="nihility-sheet starship-sheet">

  <header class="sheet-header">
    <div class="profile-frame" data-edit="img" data-action="editImage" title="{{actor.name}} — clique para trocar a imagem">
      <img class="profile-frame-img" src="{{actor.img}}" style="{{portraitStyle actor}}"/>
      <button type="button" class="profile-frame-adjust" data-action="editPortraitFrame" title="Ajustar enquadramento (zoom e posição)"><i class="fas fa-crop-simple"></i></button>
    </div>
    <div class="header-fields">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Nome"/>
      <div class="header-row">
        <span class="chip">{{#if isVehicle}}Veículo{{else}}Nave Espacial{{/if}}</span>
        <label class="ship-size-field">Porte
          <select name="system.shipSize" {{#unless isGM}}disabled{{/unless}}>
            {{#each shipSizeOptions as |opt|}}
            <option value="{{opt.id}}" {{#if (eq opt.id ../system.shipSize)}}selected{{/if}}>{{opt.label}}{{#if opt.outOfRange}} (fora da faixa){{/if}}</option>
            {{/each}}
          </select>
        </label>
        <label class="ship-size-field">Classe
          <select name="system.shipClass" {{#unless isGM}}disabled{{/unless}}>
            {{#each classOptions as |opt|}}
            <option value="{{opt.id}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
        </label>
        {{#unless isGM}}<span class="hint-inline" style="margin:0;">(só o Mestre edita)</span>{{/unless}}
        <button type="button" class="effects-list-button" data-action="openEffectsList" title="Efeitos de sistema, efeitos ativos, Raio Trator, Escudo adaptativo, Skills Ativas">✦ Efeitos</button>
      </div>
      {{#if vesselClass.description}}<p class="hint-inline vessel-class-note">{{vesselClass.label}}: {{vesselClass.description}}</p>{{/if}}
      {{#if isGM}}{{#if classRangeWarning}}<p class="vessel-class-warning"><i class="fas fa-exclamation-triangle"></i> {{classRangeWarning}}</p>{{/if}}{{/if}}
      {{> nihility.traits traits=traits isGM=isGM}}
    </div>

    <div class="resources">
      <div class="vital-row">
        <span class="vital-label">Escudos</span>
        <span class="vital-track"><span class="vital-fill energy state-{{shieldState}}" style="width:{{shieldPercent}}%"></span></span>
        <span class="vital-value">
          <input type="number" name="system.shields.value" value="{{system.shields.value}}"/>/{{system.shields.max}}<span class="vital-percent">{{shieldPercent}}%</span>
        </span>
        {{#unless shieldModule}}<span class="hint-inline" style="margin-left:4px;">(sem Escudo instalado)</span>{{/unless}}
        {{#if system.shields.rechargeRemaining}}<span class="hint-inline" style="margin-left:4px;">(Recarga: {{system.shields.rechargeRemaining}})</span>{{/if}}
        {{#if isGM}}
        <a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="shields" title="Ajustar Escudos/Recarga"><i class="fas fa-plus"></i></a>
        {{/if}}
      </div>
      {{#if isGM}}
      <div class="vital-adjust-popover" data-key="shields">
        <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
        <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="actor" data-field="shields.value" data-max-field="shields.max" data-dir="-1">− Dano</button>
        <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="actor" data-field="shields.value" data-max-field="shields.max" data-dir="1">+ Reparo</button>
        <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="actor" data-field="shields.rechargeRemaining" data-dir="-1">− Recarga</button>
        <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="actor" data-field="shields.rechargeRemaining" data-dir="1">+ Recarga</button>
      </div>
      {{/if}}
      <div class="vital-row">
        <span class="vital-label">Casco</span>
        <span class="vital-track"><span class="vital-fill hp state-{{cascoState}}" style="width:{{cascoPercent}}%"></span></span>
        <span class="vital-value">
          <span class="vital-derived">{{system.casco.value}}</span>/{{system.casco.max}}<span class="vital-percent">{{cascoPercent}}%</span>
        </span>
        {{#unless armorModule}}<span class="hint-inline" style="margin-left:4px;">(sem Casco instalado)</span>{{/unless}}
        <span class="hint-inline vital-source" title="O Casco é a Vida do Módulo de armadura — ajuste na linha dele, logo abaixo em Módulos Especiais.">= Vida do Módulo de Casco</span>
      </div>
      <div class="vital-row">
        <span class="vital-label">Integridade Estrutural</span>
        <span class="vital-track"><span class="vital-fill hp state-{{structureState}}" style="width:{{structurePercent}}%"></span></span>
        <span class="vital-value">
          <span class="vital-derived">{{system.hull.value}}</span>/<span class="vital-derived">{{system.hull.max}}</span><span class="vital-percent">{{structurePercent}}%</span>
        </span>
        <span class="hint-inline vital-source" title="Soma da Vida dos Módulos estruturais (tudo menos Casco, Escudo e Armas) — ajuste na linha de cada Módulo.">= soma dos Módulos estruturais</span>
      </div>
      {{#if isVehicle}}
      {{#unless shipManeuverEnabled}}
      <div class="vital-row">
        <span class="vital-label">Velocidade</span>
        <span class="vital-value">{{system.speed}}{{#unless engineModule}}<span class="hint-inline" style="margin-left:4px;">(sem Motor instalado)</span>{{/unless}}</span>
      </div>
      {{/unless}}
      <div class="vital-row">
        <span class="vital-label">{{#if (eq system.fuel.type "battery")}}Bateria{{else}}Combustível{{/if}}</span>
        <span class="vital-track"><span class="vital-fill energy" style="width:{{fuelPercent}}%"></span></span>
        <span class="vital-value">
          <input type="number" name="system.fuel.value" value="{{system.fuel.value}}"/>/<input type="number" name="system.fuel.max" value="{{system.fuel.max}}"/>
        </span>
      </div>
      {{else}}
      {{#unless shipManeuverEnabled}}
      <div class="vital-row">
        <span class="vital-label">Manobra</span>
        <span class="vital-value">{{system.maneuverability}}{{#unless engineModule}}<span class="hint-inline" style="margin-left:4px;">(sem Motor instalado)</span>{{/unless}}</span>
      </div>
      {{/unless}}
      {{/if}}
      {{#if shipManeuverEnabled}}
      <div class="vital-row" title="Casas por rodada em combate: o Porte dá o ritmo, o Motor define quão perto disso a nave chega (throttle, energia e Vida do Motor contam).">
        <span class="vital-label">Movimento</span>
        <span class="vital-value">{{system.movementCells}} casas por rodada{{#unless engineModule}}<span class="hint-inline" style="margin-left:4px;">(sem Motor instalado)</span>{{/unless}}</span>
      </div>
      <div class="vital-row" title="Percentual do dano de cada tiro que a nave evita, antes do Escudo.">
        <span class="vital-label">Manobra</span>
        <span class="vital-value">Evasão {{evasionPercent}}%</span>
      </div>
      {{/if}}
    </div>
  </header>

  <nav class="sheet-tabs tabs">
    <a class="item {{#if (eq activeTab "sistemas")}}active{{/if}}" data-action="selectTab" data-tab="sistemas">Sistemas</a>
    <a class="item {{#if (eq activeTab "armas")}}active{{/if}}" data-action="selectTab" data-tab="armas">Armas</a>
    <a class="item {{#if (eq activeTab "prioridade")}}active{{/if}}" data-action="selectTab" data-tab="prioridade">Prioridade</a>
    <a class="item {{#if (eq activeTab "skills")}}active{{/if}}" data-action="selectTab" data-tab="skills">Habilidades</a>
    {{#if padShipEnabled}}
    <a class="item {{#if (eq activeTab "tripulacao")}}active{{/if}}" data-action="selectTab" data-tab="tripulacao">Tripulação</a>
    {{/if}}
    <a class="item {{#if (eq activeTab "biography")}}active{{/if}}" data-action="selectTab" data-tab="biography">Registro</a>
  </nav>

  <section class="sheet-body">

    <div class="tab {{#unless (eq activeTab "sistemas")}}hidden{{/unless}}">
      <div class="block">
        <p class="block-title">Grid de Energia — {{energyLabel}}</p>
        {{!-- Atalhos de energia (os "pips" do Elite): foco em um sistema, ver applyPowerFocus. --}}
        <div class="power-focus" role="group" aria-label="Foco de energia">
          {{#each powerFocusOptions as |opt|}}
          {{#if ../canAdjustThrottle}}
          <button type="button" class="power-focus-btn {{#if opt.active}}active{{/if}}" data-action="setPowerFocus" data-focus="{{opt.id}}" title="Foco em {{opt.label}}"><i class="fas {{opt.icon}}"></i> {{opt.label}}</button>
          {{else}}
          <span class="power-focus-btn {{#if opt.active}}active{{/if}}"><i class="fas {{opt.icon}}"></i> {{opt.label}}</span>
          {{/if}}
          {{/each}}
        </div>
        <div class="ship-power-block">
        <div class="power-chain">
          <div class="chain-node {{#if reactorNode.limiting}}is-bottleneck{{/if}}">
            <span class="chain-label">Reator · geração{{#if reactorNode.limiting}}<span class="chain-badge">gargalo</span>{{/if}}</span>
            <span class="chain-value">{{system.powerGrid.reactorOutput}}</span>
            {{#if reactorNode.damaged}}
            <span class="chain-health state-{{reactorNode.integrityState}}"><span class="chain-health-track"><span style="width:{{reactorNode.integrity}}%"></span></span>Vida {{reactorNode.integrity}}%</span>
            {{/if}}
            {{#if reactorNode.upkeep}}<span class="chain-cause">−{{reactorNode.upkeep}} reservados por Habilidades Ativas</span>{{/if}}
            <span class="chain-sub">{{#if reactorModule}}{{reactorModule.name}}{{else}}sem Reator instalado{{/if}}</span>
          </div>

          <div class="chain-node {{#if distributorNode.limiting}}is-bottleneck{{/if}}">
            <span class="chain-label">Distribuidor · teto{{#if distributorNode.limiting}}<span class="chain-badge">gargalo</span>{{/if}}</span>
            <span class="chain-value">{{transferCapacity}}{{#if distributorNode.damaged}}<small>de {{distributorNode.intact}}</small>{{/if}}</span>
            {{#if distributorNode.damaged}}
            <span class="chain-health state-{{distributorNode.integrityState}}"><span class="chain-health-track"><span style="width:{{distributorNode.integrity}}%"></span></span>Vida {{distributorNode.integrity}}%</span>
            <span class="chain-cause">Danificado: transfere só {{distributorNode.integrity}}% do que transferiria inteiro.</span>
            {{/if}}
            <span class="chain-sub">{{#if distributorModule}}{{distributorModule.name}}{{else}}sem Distribuidor instalado{{/if}}</span>
          </div>

          <div class="chain-node">
            <span class="chain-label">Capacitor · reserva</span>
            <span class="chain-value">
              <input type="number" name="system.powerGrid.capacitor.value" value="{{system.powerGrid.capacitor.value}}"/>
              <small>/ {{system.powerGrid.capacitor.max}}</small>
            </span>
            {{#if capacitorNode.damaged}}
            <span class="chain-health state-{{capacitorNode.integrityState}}"><span class="chain-health-track"><span style="width:{{capacitorNode.integrity}}%"></span></span>Vida {{capacitorNode.integrity}}%</span>
            <span class="chain-cause">O máximo cai com a Vida — inteira guardaria {{capacitorNode.intact}}.</span>
            {{/if}}
            <span class="chain-sub">{{#if batteryModule}}{{batteryModule.name}}{{else}}conduítes do casco — sem Bateria{{/if}}</span>
          </div>
        </div>

        <div class="power-demand {{#if powerBudget.shortage}}overloaded{{/if}}">
          <div class="demand-head">
            <span class="chain-label">Energia desta rodada</span>
            {{#if powerBudget.shortage}}
            <span class="demand-figure"><b class="is-short">{{powerBudget.delivered}}</b> entregues de <b>{{powerBudget.demand}}</b> pedidos · <b class="is-short">{{powerBudget.percent}}%</b></span>
            {{else}}
            <span class="demand-figure"><b>{{powerBudget.demand}}</b> pedidos de <b>{{powerBudget.generation}}</b> {{energyAbbr}} · <b class="is-full">100%</b> entregue</span>
            {{/if}}
          </div>
          <div class="demand-bar">
            {{#if powerBudget.shortage}}
            <i class="demand-reactor" style="width:{{powerBudget.reactorWidth}}%"></i>
            <i class="demand-reserve" style="width:{{powerBudget.reserveWidth}}%"></i>
            <i class="demand-missing" style="width:{{powerBudget.missingWidth}}%"></i>
            {{else}}
            <i class="demand-reactor" style="width:{{powerBudget.reactorWidth}}%"></i>
            <i class="demand-slack" style="width:{{powerBudget.slackWidth}}%"></i>
            {{/if}}
          </div>
          <div class="demand-legend">
            {{#if powerBudget.shortage}}
            <span><b class="swatch reactor"></b>{{#if distributorNode.limiting}}do Reator, pelo Distribuidor{{else}}do Reator{{/if}} <b class="num">{{powerBudget.fromReactor}}</b></span>
            {{#if powerBudget.fromReserve}}<span><b class="swatch reserve"></b>da reserva <b class="num">{{powerBudget.fromReserve}}</b></span>{{/if}}
            <span><b class="swatch missing"></b>faltando <b class="num is-short">{{powerBudget.missing}}</b></span>
            {{else}}
            <span><b class="swatch reactor"></b>consumo dos Módulos <b class="num">{{powerBudget.demand}}</b></span>
            {{#if powerBudget.slack}}<span><b class="swatch slack"></b>sobra, vai pra reserva <b class="num">{{powerBudget.slack}}</b></span>{{/if}}
            {{/if}}
          </div>
          <p class="power-forecast tone-{{powerForecast.tone}}">
            <i class="fas {{#if (eq powerForecast.tone "danger")}}fa-exclamation-triangle{{else}}fa-clock{{/if}}"></i>
            <span><strong>{{powerForecast.lead}}</strong> {{powerForecast.text}}</span>
          </p>
          <span class="demand-prio-note">Chip <b>P</b> em cada Módulo: clique pra escolher o grupo. A fila inteira fica na aba <b>Prioridade</b>.</span>
        </div>
        </div>

        {{#if isGM}}
        <div class="power-grid-tick-row">
          <button type="button" class="power-grid-tick" data-action="powerGridTick"><i class="fas fa-step-forward"></i> Passar uma rodada de energia</button>
          <span class="gm-tag"><i class="fas fa-lock"></i> Mestre</span>
          <span class="hint-inline">Carrega ou gasta a reserva. Em combate isso já acontece sozinho no turno da Nave.</span>
        </div>
        {{/if}}

      </div>

      <div class="block ship-actions-block">
        <p class="block-title">Ações da Nave <span class="hint-inline" style="margin:0">(o sistema aplica; quanto de ação gastam, a mesa decide)</span></p>
        {{#if canAdjustThrottle}}
        <div class="ship-actions">
          <button type="button" data-action="shipBrace" title="−X% de todo dano recebido até o próximo turno da Nave (não vale contra Dano Absoluto)"><i class="fas fa-shield-alt"></i> Preparar para impacto</button>
          <button type="button" data-action="shipAuxShields" title="Passa carga da Bateria para o Escudo, até o máximo"><i class="fas fa-bolt"></i> Energia auxiliar → Escudos</button>
          <button type="button" data-action="shipEmergencyRepair" title="Pedido de Reparo ao Mestre, já com esta Nave"><i class="fas fa-tools"></i> Reparo de emergência</button>
          <button type="button" data-action="shipRestartSystems" title="Encerra o primeiro efeito de sistema da lista (ou clique no ↺ de um específico)"><i class="fas fa-redo"></i> Reiniciar sistemas</button>
          <button type="button" data-action="shipModulateFrequency" title="As armas desta Nave mudam de frequência: Escudos adaptativos do inimigo recomeçam do zero contra elas"><i class="fas fa-wave-square"></i> Modular frequência{{#if weaponFrequency}} ({{weaponFrequency}}){{/if}}</button>
        </div>
        {{/if}}
        {{#if systemEffectRows.length}}
        <ul class="ship-effects">
          {{#each systemEffectRows as |row|}}
          <li>
            <span>{{row.text}}</span>
            {{#if row.rounds}}<span class="hint-inline">{{row.rounds}} rodada(s)</span>{{/if}}
            {{#if row.restartable}}{{#if ../canAdjustThrottle}}<a data-action="shipRestartSystems" data-effect-id="{{row.id}}" title="Reiniciar este sistema"><i class="fas fa-redo"></i></a>{{/if}}{{/if}}
          </li>
          {{/each}}
        </ul>
        {{else}}
        <p class="hint-inline">Nenhum efeito de sistema ativo.</p>
        {{/if}}
      </div>

      <div class="block">
        <p class="block-title">Módulos de Sistema <span class="hint-inline" style="margin:0">(vagas por Categoria e Classe)</span></p>
        <div class="module-grid">
          <div class="module-grid-head">
            <span>Categoria</span><span>Módulo</span><span>Vida</span><span>Consumo</span><span>Throttle</span><span class="acts-head">Ações</span>
          </div>
          {{#each specialModuleRows as |row|}}
          <div class="module-grid-row {{#unless row.online}}is-offline{{/unless}} {{#if row.starved}}is-starved{{/if}} {{#if row.unpowered}}is-offline is-unpowered{{/if}}" data-item-id="{{row.id}}">
            <span class="cat-pill cat-{{row.category}}" title="{{row.categoryLabel}} · Porte {{row.sizeLabel}}">{{row.categoryLabel}}</span>

            <span class="module-name-cell">
              <span class="module-name-line">
                {{#if row.hasDemand}}{{#if ../canAdjustThrottle}}<button type="button" class="prio-chip {{row.priorityTone}}" data-action="pickPowerGroup" aria-haspopup="menu" title="Prioridade de energia: P{{row.priority}} · {{row.priorityLabel}} — clique para escolher o grupo">P{{row.priority}}</button>{{else}}<span class="prio-chip {{row.priorityTone}}" title="Prioridade de energia: P{{row.priority}} · {{row.priorityLabel}}">P{{row.priority}}</span>{{/if}}{{/if}}
                <span class="module-name">{{row.name}}</span>
              </span>
              {{#if row.unpowered}}
              <small class="module-unpowered"><i class="fas fa-power-off"></i> desligado · sem energia (grupo P{{row.priority}} não recebe nada)</small>
              {{else if row.starved}}
              <small class="module-starved">⚠ recebendo {{row.powerRatio}}% da energia pedida</small>
              {{else}}
              <small class="module-detail">{{row.detail}}{{#unless row.online}} · desligado{{/unless}}{{#if row.tractorTargetName}} · prendendo {{row.tractorTargetName}}{{/if}}</small>
              {{/if}}
            </span>

            <span class="module-hp-cell" title="A Vida escala o desempenho: um Módulo a 50% entrega 50%.">
              <span class="module-meter state-{{row.hpState}}"><span style="width:{{row.hpPercent}}%"></span></span>
              {{#if ../isGM}}
              <small class="module-hp-edit">
                <input type="number" class="module-hp-input" value="{{row.hpValue}}" min="0" max="{{row.hpMax}}"/>/{{row.hpMax}}
                <span class="module-hp-percent">{{row.hpPercent}}%</span>
              </small>
              {{else}}
              <small>{{row.hpValue}}/{{row.hpMax}} <span class="module-hp-percent">{{row.hpPercent}}%</span></small>
              {{/if}}
            </span>

            <span class="module-consumption">{{row.consumption}} {{../energyAbbr}}</span>

            <span class="throttle {{row.throttleState}}">
              {{#if ../canAdjustThrottle}}
              <button type="button" data-action="adjustThrottle" data-step="-20" title="−20%">⏬</button>
              <button type="button" data-action="adjustThrottle" data-step="-5" title="−5%">−</button>
              <input type="number" class="throttle-input" value="{{row.throttle}}" min="0" step="5" title="Throttle (%) — abaixo de 100 economiza, acima sobrecarrega"/>
              <button type="button" data-action="adjustThrottle" data-step="5" title="+5%">+</button>
              <button type="button" data-action="adjustThrottle" data-step="20" title="+20%">⏫</button>
              {{else}}
              <span class="throttle-readonly">{{row.throttle}}%</span>
              {{/if}}
            </span>

            <span class="module-acts">
              {{#if row.isTractor}}{{#if ../canAdjustThrottle}}{{#if row.tractorTargetName}}<a data-action="releaseTractor" title="Soltar {{row.tractorTargetName}}"><i class="fas fa-unlink"></i></a>{{else}}<a data-action="engageTractor" title="Prender alvo (Raio Trator)"><i class="fas fa-magnet"></i></a>{{/if}}{{/if}}{{/if}}
              <a class="module-toggle-power" data-action="toggleModulePower" title="Ligar/Desligar"><i class="fas fa-power-off"></i></a>
              {{#if ../isGM}}<a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="module-hp-{{row.id}}" title="Ajustar Vida"><i class="fas fa-plus"></i></a>{{/if}}
              <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
              <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
            </span>
          </div>
          {{#if ../isGM}}
          <div class="vital-adjust-popover" data-key="module-hp-{{row.id}}">
            <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
            <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="-1">− Dano</button>
            <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="1">+ Reparo</button>
          </div>
          {{/if}}
          {{/each}}
        </div>
        {{#unless specialModules.length}}<p class="hint-inline">Nenhum módulo especial (Reator/Bateria/Distribuidor/Escudo/Motor/Casco/FTL) instalado.</p>{{/unless}}
      </div>

      <div class="block">
        <p class="block-title">Módulos</p>
        <div class="module-grid">
          <div class="module-grid-head">
            <span>Categoria</span><span>Módulo</span><span>Vida</span><span>Consumo</span><span>Throttle</span><span class="acts-head">Ações</span>
          </div>
          {{#each moduleRows as |row|}}
          <div class="module-grid-row {{#unless row.online}}is-offline{{/unless}} {{#if row.starved}}is-starved{{/if}} {{#if row.unpowered}}is-offline is-unpowered{{/if}}" data-item-id="{{row.id}}">
            <span class="cat-pill cat-{{row.category}}" title="{{row.categoryLabel}} · Porte {{row.sizeLabel}}">{{row.categoryLabel}}</span>

            <span class="module-name-cell">
              <span class="module-name-line">
                {{#if row.hasDemand}}{{#if ../canAdjustThrottle}}<button type="button" class="prio-chip {{row.priorityTone}}" data-action="pickPowerGroup" aria-haspopup="menu" title="Prioridade de energia: P{{row.priority}} · {{row.priorityLabel}} — clique para escolher o grupo">P{{row.priority}}</button>{{else}}<span class="prio-chip {{row.priorityTone}}" title="Prioridade de energia: P{{row.priority}} · {{row.priorityLabel}}">P{{row.priority}}</span>{{/if}}{{/if}}
                <span class="module-name">{{row.name}}</span>
              </span>
              {{#if row.unpowered}}
              <small class="module-unpowered"><i class="fas fa-power-off"></i> desligado · sem energia (grupo P{{row.priority}} não recebe nada)</small>
              {{else if row.starved}}
              <small class="module-starved">⚠ recebendo {{row.powerRatio}}% da energia pedida</small>
              {{else}}
              <small class="module-detail">{{row.detail}}{{#unless row.online}} · desligado{{/unless}}{{#if row.tractorTargetName}} · prendendo {{row.tractorTargetName}}{{/if}}</small>
              {{/if}}
            </span>

            <span class="module-hp-cell" title="A Vida escala o desempenho: um Módulo a 50% entrega 50%.">
              <span class="module-meter state-{{row.hpState}}"><span style="width:{{row.hpPercent}}%"></span></span>
              {{#if ../isGM}}
              <small class="module-hp-edit">
                <input type="number" class="module-hp-input" value="{{row.hpValue}}" min="0" max="{{row.hpMax}}"/>/{{row.hpMax}}
                <span class="module-hp-percent">{{row.hpPercent}}%</span>
              </small>
              {{else}}
              <small>{{row.hpValue}}/{{row.hpMax}} <span class="module-hp-percent">{{row.hpPercent}}%</span></small>
              {{/if}}
            </span>

            <span class="module-consumption">{{row.consumption}} {{../energyAbbr}}</span>

            <span class="throttle {{row.throttleState}}">
              {{#if ../canAdjustThrottle}}
              <button type="button" data-action="adjustThrottle" data-step="-20" title="−20%">⏬</button>
              <button type="button" data-action="adjustThrottle" data-step="-5" title="−5%">−</button>
              <input type="number" class="throttle-input" value="{{row.throttle}}" min="0" step="5" title="Throttle (%) — abaixo de 100 economiza, acima sobrecarrega"/>
              <button type="button" data-action="adjustThrottle" data-step="5" title="+5%">+</button>
              <button type="button" data-action="adjustThrottle" data-step="20" title="+20%">⏫</button>
              {{else}}
              <span class="throttle-readonly">{{row.throttle}}%</span>
              {{/if}}
            </span>

            <span class="module-acts">
              {{#if row.isTractor}}{{#if ../canAdjustThrottle}}{{#if row.tractorTargetName}}<a data-action="releaseTractor" title="Soltar {{row.tractorTargetName}}"><i class="fas fa-unlink"></i></a>{{else}}<a data-action="engageTractor" title="Prender alvo (Raio Trator)"><i class="fas fa-magnet"></i></a>{{/if}}{{/if}}{{/if}}
              <a class="module-toggle-power" data-action="toggleModulePower" title="Ligar/Desligar"><i class="fas fa-power-off"></i></a>
              {{#if ../isGM}}<a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="module-hp-{{row.id}}" title="Ajustar Vida"><i class="fas fa-plus"></i></a>{{/if}}
              <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
              <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
            </span>
          </div>
          {{#if ../isGM}}
          <div class="vital-adjust-popover" data-key="module-hp-{{row.id}}">
            <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
            <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="-1">− Dano</button>
            <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="1">+ Reparo</button>
          </div>
          {{/if}}
          {{/each}}
        </div>
        <a class="item-create" data-action="createItem" data-type="starship_module">+ Novo Módulo</a>
      </div>

      {{#if inventoryEnabled}}
      <div class="block cargo-block {{#if cargo.full}}is-over{{/if}}" data-container-id="loose">
        <p class="block-title">{{#if isVehicle}}Porão / Peças{{else}}Porão{{/if}}
          <span class="hint-inline">{{cargo.used}}/{{cargo.slots}} slots · {{cargo.weight}} kg{{#if cargo.massFactor}} · massa ×{{cargo.massFactor}} (Motor −{{cargo.enginePenalty}}%){{/if}}</span></p>
        {{#unless cargo.slots}}<p class="hint-inline">Sem Módulo de Porão: instale um (Função Porão de Carga) para ter slots. Arraste Itens de uma ficha para cá para carregar.</p>{{/unless}}
        <ol class="item-list">
          {{#each cargo.rows as |row|}}
          <li class="item-row cargo-row" data-item-id="{{row.id}}" draggable="true">
            <img src="{{row.img}}" width="24" height="24"/>
            <span class="item-name">{{row.name}}</span>
            <span class="item-qty" title="{{row.stacks}} slot(s) — pilhas de {{row.stackSize}}">x{{row.quantity}}{{#if row.isAmmo}} · munição{{/if}}</span>
            <span class="inv-weight">{{row.weight}} kg</span>
            {{#if row.canSplit}}<a data-action="splitStack" title="Dividir pilha"><i class="fas fa-code-branch"></i></a>{{/if}}
            <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
            <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
          </li>
          {{else}}<li class="empty-note">Porão vazio.</li>
          {{/each}}
        </ol>
        <a class="item-create" data-action="createItem" data-type="item">+ Novo Item</a>
      </div>
      {{else}}{{#if isVehicle}}
      <div class="block">
        <p class="block-title">Peças Instaladas</p>
        <ol class="item-list">
          {{#each parts as |part|}}
          <li class="item-row" data-item-id="{{part.id}}">
            <img src="{{part.img}}" width="24" height="24"/>
            <span class="item-name">{{part.name}}</span>
            <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
            <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
          </li>
          {{/each}}
        </ol>
        <a class="item-create" data-action="createItem" data-type="item">+ Nova Peça</a>
      </div>
      {{/if}}{{/if}}
    </div>

    <div class="tab {{#unless (eq activeTab "armas")}}hidden{{/unless}}">
      <div class="block">
        <p class="block-title">Armas <span class="hint-inline" style="margin:0">({{weaponBudgetLabel}})</span></p>
        <div class="module-grid weapon-grid">
          <div class="module-grid-head weapon-grid-head">
            <span>Porte</span><span>Arma</span><span>Dano · Penetração</span><span>Throttle</span><span class="acts-head">Disparar · Ações</span>
          </div>
          {{#each weaponRows as |row|}}
          <div class="module-grid-row weapon-grid-row {{#unless row.online}}is-offline{{/unless}} {{#if row.starved}}is-starved{{/if}} {{#if row.unpowered}}is-offline is-unpowered{{/if}}" data-item-id="{{row.id}}">
            <span class="cat-pill cat-weapon" title="Porte {{row.sizeLabel}}">{{row.sizeLabel}}</span>

            <span class="module-name-cell">
              <span class="module-name-line">
                {{#if row.hasDemand}}{{#if ../canAdjustThrottle}}<button type="button" class="prio-chip {{row.priorityTone}}" data-action="pickPowerGroup" aria-haspopup="menu" title="Prioridade de energia: P{{row.priority}} · {{row.priorityLabel}} — clique para escolher o grupo">P{{row.priority}}</button>{{else}}<span class="prio-chip {{row.priorityTone}}" title="Prioridade de energia: P{{row.priority}} · {{row.priorityLabel}}">P{{row.priority}}</span>{{/if}}{{/if}}
                <span class="module-name">{{row.name}}</span>
              </span>
              {{#if row.unpowered}}
              <small class="module-unpowered"><i class="fas fa-power-off"></i> desligada · sem energia (grupo P{{row.priority}} não recebe nada)</small>
              {{else if row.starved}}
              <small class="module-starved">⚠ recebendo {{row.powerRatio}}% da energia pedida</small>
              {{else}}
              <small class="module-detail">custo {{row.consumption}} {{../energyAbbr}} · Vida {{row.hpValue}}/{{row.hpMax}}{{#unless row.online}} · desligada{{/unless}}</small>
              {{/if}}
            </span>

            <span class="weapon-stat">
              {{#if row.damageFormula}}{{row.damageFormula}}{{else}}<span class="weapon-nodamage">sem fórmula</span>{{/if}}
              <small>penetra {{row.penetration}}%</small>
            </span>

            <span class="throttle {{row.throttleState}}">
              {{#if ../canAdjustThrottle}}
              <button type="button" data-action="adjustThrottle" data-step="-20" title="−20%">⏬</button>
              <button type="button" data-action="adjustThrottle" data-step="-5" title="−5%">−</button>
              <input type="number" class="throttle-input" value="{{row.throttle}}" min="0" step="5" title="Throttle (%) — em Arma, acima de 100 aumenta Dano e Penetração E alonga a Recarga na mesma proporção; nunca danifica o Módulo"/>
              <button type="button" data-action="adjustThrottle" data-step="5" title="+5%">+</button>
              <button type="button" data-action="adjustThrottle" data-step="20" title="+20%">⏫</button>
              {{else}}
              <span class="throttle-readonly">{{row.throttle}}%</span>
              {{/if}}
            </span>

            <span class="module-acts weapon-acts">
              {{#if row.cooldownRemaining}}
              <span class="cooldown-chip" title="Rodadas restantes de Recarga">⏳ {{row.cooldownRemaining}}</span>
              <button type="button" class="fire-btn" data-action="fireWeapon" disabled title="Em recarga">Disparar</button>
              {{else if row.unpowered}}
              <button type="button" class="fire-btn" data-action="fireWeapon" disabled title="Sem energia — o grupo desta Arma não recebe nada (aba Prioridade)">Disparar</button>
              {{else}}
              <button type="button" class="fire-btn" data-action="fireWeapon" title="Disparar">Disparar</button>
              {{/if}}
              <a class="module-toggle-power" data-action="toggleModulePower" title="Ligar/Desligar"><i class="fas fa-power-off"></i></a>
              {{#if ../isGM}}
              <a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="module-hp-{{row.id}}" title="Ajustar Vida"><i class="fas fa-plus"></i></a>
              <a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="module-cooldown-{{row.id}}" title="Ajustar Recarga"><i class="fas fa-clock"></i></a>
              {{/if}}
              <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
              <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
            </span>
          </div>
          {{#if ../isGM}}
          <div class="vital-adjust-popover" data-key="module-hp-{{row.id}}">
            <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
            <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="-1">− Dano</button>
            <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="1">+ Reparo</button>
          </div>
          <div class="vital-adjust-popover" data-key="module-cooldown-{{row.id}}">
            <input type="number" class="vital-adjust-input" min="0" placeholder="Rodadas"/>
            <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="cooldownRemaining" data-dir="-1">− Recarga</button>
            <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="item" data-item-id="{{row.id}}" data-field="cooldownRemaining" data-dir="1">+ Recarga</button>
          </div>
          {{/if}}
          {{/each}}
        </div>
        {{#unless weaponModules.length}}<p class="hint-inline">Nenhuma Arma instalada.</p>{{/unless}}
        <a class="item-create" data-action="createItem" data-type="starship_module" data-category="weapon">+ Nova Arma</a>
      </div>
    </div>

    {{!-- Fila de prioridade de energia: um card por grupo, a energia desce do primeiro pro último. --}}
    <div class="tab {{#unless (eq activeTab "prioridade")}}hidden{{/unless}}">
      <div class="power-queue-summary">
        <div class="power-queue-figure">
          <span class="chain-label">Energia desta rodada</span>
          <span>
            {{#if powerBudget.shortage}}<b class="num is-short">{{powerBudget.delivered}}</b>{{else}}<b class="num">{{powerBudget.demand}}</b>{{/if}}
            de <b class="num">{{powerBudget.demand}} {{energyAbbr}}</b> — desce de P1 para baixo; o grupo que não recebe nada fica desligado.
          </span>
        </div>
        {{#if canAdjustThrottle}}
        <button type="button" class="power-queue-add" data-action="addPowerGroup"><i class="fas fa-plus"></i> Nova prioridade</button>
        {{/if}}
      </div>

      <div class="power-queue">
        {{#each powerGroupCards as |card|}}
        <section class="power-group-card state-{{card.state}}" data-group-id="{{card.id}}" aria-label="P{{card.number}} {{card.label}}">
          <div class="power-group-bar" role="img" aria-label="{{#if (eq card.state "empty")}}sem demanda{{else}}alimentação {{card.percent}}%{{/if}}">
            {{#if (eq card.state "partial")}}
            <span class="bar-fed" style="width:{{card.fillWidth}}%"></span><span class="bar-missing"></span>
            {{else}}
            <span class="bar-fed" style="width:100%"></span>
            {{/if}}
          </div>
          <header class="power-group-head">
            <div class="power-group-title">
              <span class="prio-chip {{card.tone}}">P{{card.number}}</span>
              <span class="power-group-name">{{card.label}}</span>
              {{#if ../canAdjustThrottle}}
              <span class="power-group-tools">
                <button type="button" data-action="movePowerGroup" data-step="-1" title="Subir (recebe antes)" aria-label="Subir prioridade" {{#if card.isFirst}}disabled{{/if}}><i class="fas fa-chevron-up"></i></button>
                <button type="button" data-action="movePowerGroup" data-step="1" title="Descer (recebe depois)" aria-label="Descer prioridade" {{#if card.isLast}}disabled{{/if}}><i class="fas fa-chevron-down"></i></button>
                <button type="button" data-action="renamePowerGroup" title="Renomear" aria-label="Renomear"><i class="fas fa-pen"></i></button>
                <button type="button" data-action="deletePowerGroup" title="Apagar (os Módulos vão pro grupo seguinte)" aria-label="Apagar prioridade" {{#if (and card.isFirst card.isLast)}}disabled{{/if}}><i class="fas fa-trash"></i></button>
              </span>
              {{/if}}
            </div>
            <span class="power-group-figure">
              {{#if (eq card.state "empty")}}{{#if card.rows.length}}nenhum Módulo ligado{{else}}nenhum Módulo{{/if}}
              {{else if (eq card.state "none")}}<b>0</b> de {{card.demand}} {{../energyAbbr}} · sem energia — Módulos desligados
              {{else if (eq card.state "partial")}}<b>{{card.delivered}}</b> de {{card.demand}} {{../energyAbbr}} · {{card.percent}}% — cada Módulo daqui recebe {{card.percent}}%
              {{else}}<b>{{card.delivered}}</b> de {{card.demand}} {{../energyAbbr}} · 100%{{/if}}
            </span>
          </header>
          <div class="power-group-modules">
            {{#each card.rows as |row|}}
            <div class="power-group-module {{#unless row.online}}is-offline{{/unless}} {{#if row.unpowered}}is-unpowered{{/if}}" data-item-id="{{row.id}}" {{#if ../../canAdjustThrottle}}draggable="true"{{/if}}>
              {{#if ../../canAdjustThrottle}}<span class="drag-grip" title="Arraste para outro grupo"><i class="fas fa-grip-vertical"></i></span>{{/if}}
              <span class="cat-pill cat-{{row.category}}">{{row.categoryLabel}}</span>
              <span class="power-group-module-name" title="{{row.name}}">{{row.name}}</span>
              {{#if row.unpowered}}<span class="power-group-module-state is-off"><i class="fas fa-power-off"></i> desligado</span>
              {{else if row.starved}}<span class="power-group-module-state is-partial">{{row.powerRatio}}% · {{row.consumption}}</span>
              {{else if row.online}}<span class="power-group-module-state">{{row.consumption}} {{../../energyAbbr}}</span>
              {{else}}<span class="power-group-module-state">desligado</span>{{/if}}
            </div>
            {{else}}
            <div class="power-group-empty">{{#if ../canAdjustThrottle}}Arraste um Módulo pra cá{{else}}Nenhum Módulo neste grupo{{/if}}</div>
            {{/each}}
          </div>
        </section>
        {{/each}}
      </div>
      {{#if powerGroupOutside}}<p class="hint-inline power-queue-outside">Fora da fila (não consomem energia): {{powerGroupOutside}}.</p>{{/if}}
    </div>

    <div class="tab {{#unless (eq activeTab "skills")}}hidden{{/unless}}">
      <div class="block">
        <p class="hint-inline">Concedidas automaticamente pelos Módulos "online" — sem pontos nem fusão.</p>
        <ol class="item-list">
          {{#each skills as |skill|}}
          <li class="item-row" data-item-id="{{skill.id}}">
            <img src="{{skill.img}}" width="24" height="24"/>
            <span class="item-name">{{skill.name}}<span class="skill-summary">{{lookup ../skillSummaries skill.id}}</span></span>
            {{#if skill.system.active}}
            <button type="button" class="skill-use-button active" data-action="useSkill" title="Desativar (drenando {{skill.system.upkeepCost}} de {{../energyLabel}} do Reator por rodada)">🔥 Desativar</button>
            {{else if (eq skill.system.effectType "damage")}}
            <button type="button" class="skill-use-button" data-action="useSkill" title="Usar Habilidade">🎲 Usar</button>
            {{else}}
            <button type="button" class="skill-use-button" data-action="useSkill" title="Usar Habilidade{{#if skill.system.hasUpkeep}} (Ativa — drena {{../energyLabel}} do Reator por rodada até desativar){{/if}}">✨ Usar</button>
            {{/if}}
            <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
          </li>
          {{/each}}
        </ol>
      </div>
    </div>

    {{#if padShipEnabled}}
    <div class="tab {{#unless (eq activeTab "tripulacao")}}hidden{{/unless}}">
      <div class="block">
        <p class="block-title">Tripulação</p>
        <ol class="item-list crew-list">
          {{#each crewRows as |entry|}}
          <li class="item-row crew-row">
            <img src="{{entry.actor.img}}" width="24" height="24"/>
            <span class="item-name">{{entry.actor.name}}</span>
            {{#if entry.canChangeRole}}
            <select class="crew-role-input" data-actor-uuid="{{entry.actorUuid}}" title="Posto atual — qualquer tripulante troca o próprio">
              <option value="">— sem posto —</option>
              {{#each entry.roleOptions as |opt|}}<option value="{{opt.id}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>{{/each}}
            </select>
            {{else}}
            {{#if entry.roleLabel}}<span class="cat-pill">{{entry.roleLabel}}</span>{{/if}}
            {{/if}}
            {{#if ../isGM}}
            <a class="item-delete" data-action="removeCrew" data-actor-uuid="{{entry.actorUuid}}" title="Remover tripulante"><i class="fas fa-trash"></i></a>
            {{/if}}
          </li>
          {{/each}}
        </ol>
        {{#unless crewActors.length}}<p class="hint-inline">Nenhum tripulante designado.</p>{{/unless}}
        <p class="hint-inline">O posto só diz quem está onde. Qualquer tripulante opera a Nave inteira (move, dispara, ajusta a energia) e troca o próprio posto na hora.</p>

        {{#if isGM}}
        <div class="crew-dropzone">Arraste um Personagem (PJ ou NPC) aqui pra designá-lo como tripulante.</div>
        {{/if}}
      </div>
    </div>
    {{/if}}

    <div class="tab {{#unless (eq activeTab "biography")}}hidden{{/unless}}">
      <div class="block">
        {{#if owner}}
      <prose-mirror name="system.biography" value="{{system.biography}}"></prose-mirror>
      {{else}}
      <div class="rich-text-readonly">{{{system.biography}}}</div>
      {{/if}}
      </div>
    </div>

  </section>
</div>
