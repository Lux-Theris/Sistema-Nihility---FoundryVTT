<div class="nihility-sheet starship-sheet">

  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editImage" title="{{actor.name}}"/>
    <div class="header-fields">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Nome"/>
      <div class="header-row">
        <span class="chip">{{#if isVehicle}}Veículo{{else}}Nave Espacial{{/if}}</span>
        <label class="ship-size-field">Porte
          <select name="system.shipSize" {{#unless isGM}}disabled{{/unless}}>
            {{#each shipSizeOptions as |opt|}}
            <option value="{{opt.id}}" {{#if (eq opt.id ../system.shipSize)}}selected{{/if}}>{{opt.label}}</option>
            {{/each}}
          </select>
        </label>
        {{#unless isGM}}<span class="hint-inline" style="margin:0;">(só o Mestre edita)</span>{{/unless}}
      </div>
    </div>

    <div class="resources">
      <div class="vital-row">
        <span class="vital-label">Escudos</span>
        <span class="vital-track"><span class="vital-fill energy" style="width:{{shieldPercent}}%"></span></span>
        <span class="vital-value">
          <input type="number" name="system.shields.value" value="{{system.shields.value}}"/>/{{system.shields.max}}
        </span>
        {{#unless shieldModule}}<span class="hint-inline" style="margin-left:4px;">(sem Escudo instalado)</span>{{/unless}}
        {{#if system.shields.rechargeRemaining}}<span class="hint-inline" style="margin-left:4px;">(Recarga: {{system.shields.rechargeRemaining}})</span>{{/if}}
        {{#if isGM}}
        <a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="shields" title="Ajustar Escudos/Recarga"><i class="fas fa-plus"></i></a>
        {{/if}}
      </div>
      {{#if isGM}}
      <div class="vital-adjust-popover" data-key="shields">
        <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
        <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="actor" data-field="shields.value" data-max-field="shields.max" data-dir="-1">− Dano</button>
        <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="actor" data-field="shields.value" data-max-field="shields.max" data-dir="1">+ Reparo</button>
        <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="actor" data-field="shields.rechargeRemaining" data-dir="-1">− Recarga</button>
        <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="actor" data-field="shields.rechargeRemaining" data-dir="1">+ Recarga</button>
      </div>
      {{/if}}
      <div class="vital-row">
        <span class="vital-label">Casco</span>
        <span class="vital-track"><span class="vital-fill hp" style="width:{{cascoPercent}}%"></span></span>
        <span class="vital-value">
          <input type="number" name="system.casco.value" value="{{system.casco.value}}"/>/{{system.casco.max}}
        </span>
        {{#unless armorModule}}<span class="hint-inline" style="margin-left:4px;">(sem Casco instalado)</span>{{/unless}}
        {{#if isGM}}
        <a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="casco" title="Ajustar Casco"><i class="fas fa-plus"></i></a>
        {{/if}}
      </div>
      {{#if isGM}}
      <div class="vital-adjust-popover" data-key="casco">
        <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
        <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="actor" data-field="casco.value" data-max-field="casco.max" data-dir="-1">− Dano</button>
        <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="actor" data-field="casco.value" data-max-field="casco.max" data-dir="1">+ Reparo</button>
      </div>
      {{/if}}
      <div class="vital-row">
        <span class="vital-label">Integridade Estrutural</span>
        <span class="vital-track"><span class="vital-fill hp" style="width:{{structurePercent}}%"></span></span>
        <span class="vital-value">
          <input type="number" name="system.hull.value" value="{{system.hull.value}}"/>/<input type="number" name="system.hull.max" value="{{system.hull.max}}"/>
        </span>
        {{#if isGM}}
        <a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="hull" title="Ajustar Integridade Estrutural"><i class="fas fa-plus"></i></a>
        {{/if}}
      </div>
      {{#if isGM}}
      <div class="vital-adjust-popover" data-key="hull">
        <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
        <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="actor" data-field="hull.value" data-max-field="hull.max" data-dir="-1">− Dano</button>
        <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="actor" data-field="hull.value" data-max-field="hull.max" data-dir="1">+ Reparo</button>
      </div>
      {{/if}}
      {{#if isVehicle}}
      <div class="vital-row">
        <span class="vital-label">Velocidade</span>
        <span class="vital-value">{{system.speed}}{{#unless engineModule}}<span class="hint-inline" style="margin-left:4px;">(sem Motor instalado)</span>{{/unless}}</span>
      </div>
      <div class="vital-row">
        <span class="vital-label">{{#if (eq system.fuel.type "battery")}}Bateria{{else}}Combustível{{/if}}</span>
        <span class="vital-track"><span class="vital-fill energy" style="width:{{fuelPercent}}%"></span></span>
        <span class="vital-value">
          <input type="number" name="system.fuel.value" value="{{system.fuel.value}}"/>/<input type="number" name="system.fuel.max" value="{{system.fuel.max}}"/>
        </span>
      </div>
      {{else}}
      <div class="vital-row">
        <span class="vital-label">Manobra</span>
        <span class="vital-value">{{system.maneuverability}}{{#unless engineModule}}<span class="hint-inline" style="margin-left:4px;">(sem Motor instalado)</span>{{/unless}}</span>
      </div>
      {{/if}}
    </div>
  </header>

  <nav class="sheet-tabs tabs">
    <a class="item {{#if (eq activeTab "sistemas")}}active{{/if}}" data-action="selectTab" data-tab="sistemas">Sistemas</a>
    <a class="item {{#if (eq activeTab "armas")}}active{{/if}}" data-action="selectTab" data-tab="armas">Armas</a>
    <a class="item {{#if (eq activeTab "skills")}}active{{/if}}" data-action="selectTab" data-tab="skills">Habilidades</a>
    <a class="item {{#if (eq activeTab "biography")}}active{{/if}}" data-action="selectTab" data-tab="biography">Registro</a>
  </nav>

  <section class="sheet-body">

    <div class="tab {{#unless (eq activeTab "sistemas")}}hidden{{/unless}}">
      <div class="block">
        <p class="block-title">Grid de Energia — {{energyLabel}}</p>
        <div class="power-grid-summary {{#if isOverloaded}}overloaded{{/if}}">
          <div class="power-stat">
            <label>Reator</label>
            <span>{{system.powerGrid.reactorOutput}} EPS</span>
            {{#unless reactorModule}}<span class="hint-inline" style="margin:0;">(sem Reator instalado)</span>{{/unless}}
          </div>
          <div class="power-stat">
            <label>Capacidade de Transferência</label>
            <span>{{transferCapacityLabel}}</span>
            {{#unless distributorModule}}<span class="hint-inline" style="margin:0;">(sem Distribuidor instalado)</span>{{/unless}}
          </div>
          <div class="power-stat">
            <label>Capacitores</label>
            <input type="number" name="system.powerGrid.capacitor.value" value="{{system.powerGrid.capacitor.value}}"/>
            <span>/</span>
            <span>{{system.powerGrid.capacitor.max}}</span>
            {{#unless batteryModule}}<span class="hint-inline" style="margin:0;">(sem Bateria instalada)</span>{{/unless}}
          </div>
          <div class="power-stat">
            <label>Consumo Total</label>
            <span>{{totalConsumption}} EPS</span>
          </div>
          <div class="power-stat">
            <label>Energia Disponível</label>
            <span>{{availableEnergy}} EPS</span>
          </div>
          {{#if isOverloaded}}<p class="overload-alert">⚠ GRID SOBRECARREGADO</p>{{/if}}
        </div>
        <button type="button" class="power-grid-tick" data-action="powerGridTick">Recalcular Grid de Energia</button>
      </div>

      <div class="block">
        <p class="block-title">Módulos Especiais <span class="hint-inline" style="margin:0">(slot único cada)</span></p>
        <ol class="item-list">
          {{#each specialModules as |module|}}
          <li class="item-row-wrap">
            <div class="item-row module-{{module.system.status}}" data-item-id="{{module.id}}">
              <span class="cat-pill cat-{{module.system.category}}">{{lookup ../config.STARSHIP_MODULE_CATEGORY_LABELS module.system.category}}</span>
              <img src="{{module.img}}" width="24" height="24"/>
              <span class="item-name">{{module.name}}</span>
              <span class="item-consumption">
                {{module.system.powerConsumption}} EPS &middot; Throttle {{module.system.powerAllocationPercent}}% &middot; {{module.system.status}} &middot; {{module.system.hp.value}}/{{module.system.hp.max}} HP
                {{#if (eq module.system.category "armor")}} &middot; Redução {{module.system.armorReduction}}%{{/if}}
                {{#if (eq module.system.category "engine")}} &middot; Rotação {{../system.maneuverability}}{{/if}}
                {{#if (eq module.system.category "ftl")}} &middot; Fator ×{{module.system.warpFactor}}{{#if (eq module.system.ftlType "jump")}} &middot; Carga {{module.system.chargeRemaining}}/{{module.system.chargeTime}}{{/if}}{{/if}}
              </span>
              {{#if (lt (lookup ../powerRatios module.id) 100)}}<span class="power-shortage-badge" title="Recebendo só {{lookup ../powerRatios module.id}}% da energia pedida">⚠ Energia insuficiente</span>{{/if}}
              <a class="module-toggle-power" data-action="toggleModulePower" title="Ligar/Desligar"><i class="fas fa-power-off"></i></a>
              {{#if ../isGM}}<a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="module-hp-{{module.id}}" title="Ajustar Vida do Módulo"><i class="fas fa-plus"></i></a>{{/if}}
              <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
              <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
            </div>
            {{#if ../isGM}}
            <div class="vital-adjust-popover" data-key="module-hp-{{module.id}}">
              <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
              <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="item" data-item-id="{{module.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="-1">− Dano</button>
              <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="item" data-item-id="{{module.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="1">+ Reparo</button>
            </div>
            {{/if}}
          </li>
          {{/each}}
        </ol>
        {{#unless specialModules.length}}<p class="hint-inline">Nenhum módulo especial (Reator/Bateria/Distribuidor/Escudo/Motor/Casco/FTL) instalado.</p>{{/unless}}
      </div>

      <div class="block">
        <p class="block-title">Módulos</p>
        <ol class="item-list">
          {{#each modules as |module|}}
          <li class="item-row-wrap">
            <div class="item-row module-{{module.system.status}}" data-item-id="{{module.id}}">
              <span class="cat-pill cat-{{module.system.category}}">{{lookup ../config.STARSHIP_MODULE_CATEGORY_LABELS module.system.category}}</span>
              <img src="{{module.img}}" width="24" height="24"/>
              <span class="item-name">{{module.name}}</span>
              <span class="item-consumption">{{module.system.powerConsumption}} EPS &middot; Throttle {{module.system.powerAllocationPercent}}% &middot; {{module.system.status}} &middot; {{module.system.hp.value}}/{{module.system.hp.max}} HP</span>
              {{#if (lt (lookup ../powerRatios module.id) 100)}}<span class="power-shortage-badge" title="Recebendo só {{lookup ../powerRatios module.id}}% da energia pedida">⚠ Energia insuficiente</span>{{/if}}
              <a class="module-toggle-power" data-action="toggleModulePower" title="Ligar/Desligar"><i class="fas fa-power-off"></i></a>
              {{#if ../isGM}}<a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="module-hp-{{module.id}}" title="Ajustar Vida do Módulo"><i class="fas fa-plus"></i></a>{{/if}}
              <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
              <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
            </div>
            {{#if ../isGM}}
            <div class="vital-adjust-popover" data-key="module-hp-{{module.id}}">
              <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
              <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="item" data-item-id="{{module.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="-1">− Dano</button>
              <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="item" data-item-id="{{module.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="1">+ Reparo</button>
            </div>
            {{/if}}
          </li>
          {{/each}}
        </ol>
        <a class="item-create" data-action="createItem" data-type="starship_module">+ Novo Módulo</a>
      </div>

      {{#if isVehicle}}
      <div class="block">
        <p class="block-title">Peças Instaladas</p>
        <ol class="item-list">
          {{#each parts as |part|}}
          <li class="item-row" data-item-id="{{part.id}}">
            <img src="{{part.img}}" width="24" height="24"/>
            <span class="item-name">{{part.name}}</span>
            <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
            <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
          </li>
          {{/each}}
        </ol>
        <a class="item-create" data-action="createItem" data-type="item">+ Nova Peça</a>
      </div>
      {{/if}}
    </div>

    <div class="tab {{#unless (eq activeTab "armas")}}hidden{{/unless}}">
      <div class="block">
        <p class="block-title">Armas <span class="hint-inline" style="margin:0">({{weaponBudgetLabel}})</span></p>
        <ol class="item-list weapon-list">
          {{#each weaponModules as |module|}}
          <li class="item-row-wrap">
            <div class="weapon-row item-row module-{{module.system.status}}" data-item-id="{{module.id}}">
              <span class="cat-pill cat-weapon">{{lookup ../config.MODULE_SIZE_LABELS module.system.moduleSize}}</span>
              <img src="{{module.img}}" width="24" height="24"/>
              <span class="item-name">{{module.name}}</span>
              <span class="item-consumption">
                Custo {{module.system.powerConsumption}} EPS &middot; Throttle {{module.system.powerAllocationPercent}}% &middot; {{module.system.status}} &middot; {{module.system.hp.value}}/{{module.system.hp.max}} HP
                &middot; Dano {{module.system.damageFormula}} &middot; Penetração {{module.system.penetration}}%
                {{#if module.system.cooldownRounds}} &middot; Recarga {{module.system.cooldownRounds}} rodada(s){{/if}}
              </span>
              {{#if (lt (lookup ../powerRatios module.id) 100)}}<span class="power-shortage-badge" title="Recebendo só {{lookup ../powerRatios module.id}}% da energia pedida">⚠ Energia insuficiente</span>{{/if}}
              {{#if module.system.cooldownRemaining}}<span class="cooldown-note">⏳ Em recarga — {{module.system.cooldownRemaining}} rodada(s) restantes</span>{{/if}}
              <button type="button" class="fire-btn" data-action="fireWeapon" {{#if module.system.cooldownRemaining}}disabled{{/if}} title="Disparar">🎯 Disparar</button>
              <a class="module-toggle-power" data-action="toggleModulePower" title="Ligar/Desligar"><i class="fas fa-power-off"></i></a>
              {{#if ../isGM}}
              <a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="module-hp-{{module.id}}" title="Ajustar Vida da Arma"><i class="fas fa-plus"></i></a>
              <a class="vital-adjust-toggle" data-action="toggleModuleVitalAdjust" data-key="module-cooldown-{{module.id}}" title="Ajustar Recarga"><i class="fas fa-clock"></i></a>
              {{/if}}
              <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
              <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
            </div>
            {{#if ../isGM}}
            <div class="vital-adjust-popover" data-key="module-hp-{{module.id}}">
              <input type="number" class="vital-adjust-input" min="0" placeholder="Valor"/>
              <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="item" data-item-id="{{module.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="-1">− Dano</button>
              <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="item" data-item-id="{{module.id}}" data-field="hp.value" data-max-field="hp.max" data-dir="1">+ Reparo</button>
            </div>
            <div class="vital-adjust-popover" data-key="module-cooldown-{{module.id}}">
              <input type="number" class="vital-adjust-input" min="0" placeholder="Rodadas"/>
              <button type="button" class="vital-adjust-btn dmg" data-action="adjustModuleVital" data-scope="item" data-item-id="{{module.id}}" data-field="cooldownRemaining" data-dir="-1">− Recarga</button>
              <button type="button" class="vital-adjust-btn heal" data-action="adjustModuleVital" data-scope="item" data-item-id="{{module.id}}" data-field="cooldownRemaining" data-dir="1">+ Recarga</button>
            </div>
            {{/if}}
          </li>
          {{/each}}
        </ol>
        {{#unless weaponModules.length}}<p class="hint-inline">Nenhuma Arma instalada.</p>{{/unless}}
        <a class="item-create" data-action="createItem" data-type="starship_module" data-category="weapon">+ Nova Arma</a>
      </div>
    </div>

    <div class="tab {{#unless (eq activeTab "skills")}}hidden{{/unless}}">
      <div class="block">
        <p class="hint-inline">Concedidas automaticamente pelos Módulos "online" — sem pontos nem fusão.</p>
        <ol class="item-list">
          {{#each skills as |skill|}}
          <li class="item-row" data-item-id="{{skill.id}}">
            <img src="{{skill.img}}" width="24" height="24"/>
            <span class="item-name">{{skill.name}}</span>
            <span class="item-cost">Custo: {{skill.system.cost}}{{#if skill.system.hasUpkeep}} + {{skill.system.upkeepCost}}/rodada{{/if}}</span>
            {{#if skill.system.active}}
            <button type="button" class="skill-use-button active" data-action="useSkill" title="Desativar (drenando {{skill.system.upkeepCost}} de {{../energyLabel}} do Reator por rodada)">🔥 Desativar</button>
            {{else if (eq skill.system.effectType "damage")}}
            <button type="button" class="skill-use-button" data-action="useSkill" title="Usar Habilidade">🎲 Usar</button>
            {{else}}
            <button type="button" class="skill-use-button" data-action="useSkill" title="Usar Habilidade{{#if skill.system.hasUpkeep}} (Ativa — drena {{../energyLabel}} do Reator por rodada até desativar){{/if}}">✨ Usar</button>
            {{/if}}
            <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
          </li>
          {{/each}}
        </ol>
      </div>
    </div>

    <div class="tab {{#unless (eq activeTab "biography")}}hidden{{/unless}}">
      <div class="block">
        {{editor system.biography target="system.biography" button=true engine="prosemirror" owner=owner}}
      </div>
    </div>

  </section>
</div>
