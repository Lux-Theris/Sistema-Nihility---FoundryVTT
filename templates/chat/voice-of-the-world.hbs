<div class="nihility-voice-of-the-world kind-{{kind}}">
  <header class="votw-header">
    <i class="fas fa-eye"></i>
    <span class="votw-label">Voz do Mundo</span>
    <span class="votw-timestamp">{{timestamp}}</span>
  </header>

  {{#if actorName}}<p class="votw-actor">{{actorName}}</p>{{/if}}

  <h4 class="votw-title">{{title}}</h4>
  <div class="votw-body">{{{body}}}</div>

  <footer class="votw-footer">
    <em>Mensagem privada — visível apenas para o Mestre e o(s) dono(s) deste personagem.</em>
  </footer>
</div>
