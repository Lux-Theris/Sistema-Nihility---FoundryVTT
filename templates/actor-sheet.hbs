<div class="nihility-sheet actor-sheet">

  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
    <div class="header-fields">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Nome"/>

      <div class="header-row">
        <label>Espécie
          <select class="species-select" name="system.species">
            {{#each speciesPresets as |preset key|}}
              <option value="{{key}}" {{#if (eq key system.species)}}selected{{/if}}>{{preset.label}}</option>
            {{/each}}
          </select>
        </label>

        <label>Nível
          <input type="number" name="system.attributes.level" value="{{system.attributes.level}}" {{#unless isGM}}readonly{{/unless}}/>
          {{#if isGM}}<button type="button" class="level-up-button" data-action="levelUpActor" title="Level Up (Voz do Mundo avisa)">+</button>{{/if}}
        </label>

        {{#if titlesEnabled}}
        <span class="chip violet">{{titles.length}} Título(s) sempre ativo(s)</span>
        {{/if}}
      </div>
    </div>

    <div class="resources">
      <div class="vital-row">
        <span class="vital-label">HP</span>
        <span class="vital-track"><span class="vital-fill hp" style="width:{{hpPercent}}%"></span></span>
        <span class="vital-value">
          <input type="number" name="system.attributes.hp.value" value="{{system.attributes.hp.value}}"/>/<input type="number" name="system.attributes.hp.max" value="{{system.attributes.hp.max}}"/>
        </span>
      </div>
      <div class="vital-row">
        <span class="vital-label">{{energyLabel}}</span>
        <span class="vital-track"><span class="vital-fill energy" style="width:{{energyPercent}}%"></span></span>
        <span class="vital-value">
          <input type="number" name="system.attributes.energy.value" value="{{system.attributes.energy.value}}"/>/<input type="number" name="system.attributes.energy.max" value="{{system.attributes.energy.max}}"/>
        </span>
      </div>
      <div class="vital-row">
        <span class="vital-label">XP</span>
        <span class="vital-track"><span class="vital-fill xp" style="width:100%"></span></span>
        <span class="vital-value"><input type="number" name="system.attributes.xp" value="{{system.attributes.xp}}"/></span>
      </div>
      {{#if shieldValue}}
      <div class="vital-row shield-row">
        <span class="vital-label">🛡 Escudo</span>
        <span class="vital-value shield-value">
          <input type="number" name="system.attributes.shield.value" value="{{system.attributes.shield.value}}"/>
        </span>
      </div>
      {{/if}}
    </div>
  </header>

  <nav class="sheet-tabs tabs">
    <a class="item {{#if (eq activeTab "ficha")}}active{{/if}}" data-action="selectTab" data-tab="ficha">Ficha</a>
    {{#if anatomyEnabled}}<a class="item {{#if (eq activeTab "anatomy")}}active{{/if}}" data-action="selectTab" data-tab="anatomy">Anatomia</a>{{/if}}
    <a class="item {{#if (eq activeTab "biography")}}active{{/if}}" data-action="selectTab" data-tab="biography">Biografia</a>
  </nav>

  <section class="sheet-body">

    <div class="tab {{#unless (eq activeTab "ficha")}}hidden{{/unless}}">
      <div class="ficha-grid">

        <!-- Rail esquerda: Atributos + Títulos -->
        <div class="rail">
          <div class="block">
            <p class="block-title">Atributos</p>
            <p class="hint-inline">
              A cada +10 de Bônus a rolagem ganha +1d20 (todos somados). Arma/equipamento nunca
              entram nessa conta — somam por fora, na hora da rolagem.
            </p>
            <p class="chip-inline">{{system.attributePointsPool.spent}} / {{system.attributePointsPool.total}} investidos ({{system.attributePointsPool.remaining}} livres)</p>
            <table class="attr-table">
              <tr><th>Atributo</th><th>Pontos</th><th>Bônus</th><th></th></tr>
              {{#each attributeLabels as |attr|}}
              <tr data-attribute="{{attr.key}}">
                <td>{{attr.label}}</td>
                <td><input type="number" name="system.attributes.combat.{{attr.key}}.points" value="{{attr.data.points}}"/></td>
                <td class="attr-bonus">
                  +{{attr.data.bonus}}
                  {{#if attr.data.itemBonus}}<span class="attr-item-bonus" title="Bônus de Item/Modificação — soma por fora na rolagem, não entra no Pool de d20">+{{attr.data.itemBonus}} item</span>{{/if}}
                </td>
                <td><button type="button" class="attribute-roll" data-action="rollAttribute" title="Rolar (Bônus de Item incluso como número fixo)">🎲</button></td>
              </tr>
              {{/each}}
            </table>
          </div>

          {{#if titlesEnabled}}
          <div class="block">
            <p class="block-title">Títulos <span class="hint-inline" style="margin:0">sempre ativos</span></p>
            <ol class="item-list title-list">
              {{#each titles as |title|}}
              <li class="item-row" data-item-id="{{title.id}}">
                <img src="{{title.img}}" width="24" height="24"/>
                <span class="item-name">{{title.name}}</span>
                <span class="item-rarity">{{title.system.rarity}}</span>
                <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
                <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
              </li>
              {{/each}}
            </ol>
            <a class="item-create" data-action="createItem" data-type="title">+ Novo Título</a>
          </div>
          {{/if}}
        </div>

        <!-- Coluna direita: Pontos de Habilidade, Habilidades, Itens, Economia -->
        <div class="col-right">

          <div class="block">
            <p class="block-title">Pontos de Habilidade</p>
            <div class="sp-ledger">
              {{#each config.SKILL_POINT_TIERS as |tier|}}
              <div class="sp-item" data-tier="{{tier}}">
                <span class="sp-label">{{lookup ../tierLabels tier}}</span>
                <span class="sp-value">{{lookup ../system.skillPoints tier}}</span>
                <div class="sp-actions">
                  <button type="button" class="sp-break" data-action="breakSkillPoints" title="Quebrar 1 em 3 do tier abaixo">▼</button>
                  <button type="button" class="sp-merge" data-action="mergeSkillPoints" title="Fundir 3 em 1 do tier acima">▲</button>
                </div>
              </div>
              {{/each}}
            </div>
          </div>

          <div class="block">
            <div class="row-between">
              <p class="block-title" style="margin:0">Habilidades</p>
              <button type="button" class="skill-fuse-button" data-action="fuseSkills">⚡ Fundir Selecionadas</button>
            </div>

            {{#each visibleTiers as |tier|}}
            <fieldset class="skill-tier-group tier-{{tier}}">
              <legend>{{lookup ../tierLabels tier}}</legend>
              <ol class="item-list">
                {{#each (lookup ../skillsByTier tier) as |skill|}}
                <li class="item-row" data-item-id="{{skill.id}}">
                  {{#if skill.system.isItemGranted}}
                  <span class="item-granted-badge" title="Concedida por Item/Módulo — não pode ser fundida">⚙</span>
                  {{else}}
                  <input type="checkbox" class="skill-fuse-checkbox" data-item-id="{{skill.id}}"/>
                  {{/if}}
                  <img src="{{skill.img}}" width="24" height="24"/>
                  <span class="item-name">{{skill.name}}</span>
                  <span class="item-cost">Custo: {{skill.system.cost}}</span>
                  {{#unless (eq skill.system.effectType "none")}}
                  <button type="button" class="skill-use-button" data-action="useSkill" title="Usar Habilidade">
                    {{#if (eq skill.system.effectType "damage")}}🎲 Usar{{else}}✨ Usar{{/if}}
                  </button>
                  {{/unless}}
                  <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
                  <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
                </li>
                {{/each}}
              </ol>
            </fieldset>
            {{/each}}

            <a class="item-create" data-action="createItem" data-type="skill">+ Nova Habilidade (direto)</a>
            <button type="button" class="skill-request-button" data-action="requestSkillCreation">+ Pedir Criação com Pontos</button>
          </div>

          <div class="block">
            <p class="block-title">Itens Gerais</p>
            <ol class="item-list">
              {{#each gear as |item|}}
              <li class="item-row" data-item-id="{{item.id}}">
                <img src="{{item.img}}" width="24" height="24"/>
                <span class="item-name">{{item.name}}</span>
                <span class="item-qty">x{{item.system.quantity}}</span>
                <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
                <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
              </li>
              {{/each}}
            </ol>
            <a class="item-create" data-action="createItem" data-type="item">+ Novo Item</a>
          </div>

          {{#if economyEnabled}}
          <div class="block">
            <p class="block-title">Economia</p>
            <ol class="currency-list">
              {{#each currencies as |currency|}}
              <li class="currency-row">
                <img src="{{currency.icon}}" width="20" height="20"/>
                <label>{{currency.label}}</label>
                <input type="number" name="system.currencies.{{currency.id}}" value="{{lookup ../system.currencies currency.id}}" {{#unless ../isGM}}readonly{{/unless}}/>
              </li>
              {{/each}}
            </ol>
            <button type="button" class="currency-convert" data-action="convertCurrency">🔄 Converter</button>
            <button type="button" class="currency-send" data-action="sendCurrency">📤 Enviar Dinheiro</button>
            {{#unless isGM}}<p class="hint-inline">Valores só editáveis pelo Mestre — use Converter/Enviar.</p>{{/unless}}
          </div>
          {{/if}}

        </div>
      </div>
    </div>

    {{#if anatomyEnabled}}
    <div class="tab {{#unless (eq activeTab "anatomy")}}hidden{{/unless}}">
      <ol class="item-list body-parts-list">
        {{#each bodyParts as |part|}}
        <li class="item-row body-part {{part.system.status}}" data-item-id="{{part.id}}">
          <span class="item-name">{{part.name}}</span>
          <span class="item-hp">{{part.system.hp.value}} / {{part.system.hp.max}} HP</span>
          <span class="item-status">{{lookup ../statusLabels part.system.status}}</span>
          <a class="item-edit" data-action="editItem" title="Editar"><i class="fas fa-edit"></i></a>
          <a class="item-delete" data-action="deleteItem" title="Excluir"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ol>
      <a class="item-create" data-action="createItem" data-type="body_part">+ Nova Parte do Corpo</a>
    </div>
    {{/if}}

    <div class="tab {{#unless (eq activeTab "biography")}}hidden{{/unless}}">
      <h3>Personalidade <span class="hint-inline" style="margin:0">(insumo para Skills Únicas/Ultimate)</span></h3>
      <label>Traços
        <input type="text" name="system.personality.traits" value="{{system.personality.traits}}"/>
      </label>
      <label>Desejos
        <input type="text" name="system.personality.desires" value="{{system.personality.desires}}"/>
      </label>
      <label>Estado Emocional
        <input type="text" name="system.personality.emotionalState" value="{{system.personality.emotionalState}}"/>
      </label>

      <h3>Biografia</h3>
      {{editor system.biography target="system.biography" button=true engine="prosemirror" owner=owner}}
    </div>

  </section>
</div>
