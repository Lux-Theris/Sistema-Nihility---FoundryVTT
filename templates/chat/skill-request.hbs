<div class="nihility-skill-request status-{{status}}">
  <header class="votw-header">
    <i class="fas fa-hand-sparkles"></i>
    <span class="votw-label">Pedido de Skill · {{actorName}}{{#if ownerName}} ({{ownerName}}){{/if}}</span>
  </header>

  <h4 class="sr-name"><a data-sr="view" title="Ver a Skill completa (só leitura)">{{name}}</a> <span class="sr-tier">{{tierLabel}} · 1 ponto</span></h4>
  {{#if sentence}}<p class="sr-sentence">{{sentence}}</p>{{/if}}
  {{#if assistEnabled}}
  <p class="sr-check">
    <span class="sr-lab">Custo</span> {{cost}}
    {{#if suggested}} · <span class="{{#if costClose}}sr-ok{{else}}sr-far{{/if}}">sugerido {{suggested}}</span>{{/if}}
    · {{#if warnings}}<span class="{{#if hardWarnings}}sr-far{{else}}sr-soft{{/if}}">{{warnings}} aviso(s)</span>{{else}}<span class="sr-ok">sem avisos</span>{{/if}}
  </p>
  {{else}}{{#if cost}}<p class="sr-cost">Custo de energia para usar: {{cost}}</p>{{/if}}{{/if}}
  {{#if description}}<div class="sr-description">{{{description}}}</div>{{/if}}
  {{#if gmNote}}<p class="sr-note"><i class="fas fa-comment"></i> Mestre: "{{gmNote}}"</p>{{/if}}

  {{#if open}}
  <div class="sr-actions sr-gm-actions">
    <button type="button" class="skill-request-approve" data-sr="approve"><i class="fas fa-check"></i> Aprovar</button>
    <button type="button" data-sr="adjust"><i class="fas fa-pen"></i> Ajustar e aprovar…</button>
    <button type="button" data-sr="changes"><i class="fas fa-comment"></i> Pedir mudança…</button>
    <button type="button" class="skill-request-reject" data-sr="reject"><i class="fas fa-times"></i> Rejeitar</button>
  </div>
  <div class="sr-actions sr-owner-actions">
    <button type="button" data-sr="edit"><i class="fas fa-pen"></i> Editar pedido</button>
  </div>
  <p class="sr-hint">{{#if (eq status "changes")}}Devolvido para ajuste.{{else}}Aguardando o Mestre.{{/if}} Custa 1 Ponto de Habilidade {{tierLabel}}, só descontado se aprovado.</p>
  {{/if}}

  {{#if (eq status "approved")}}<p class="sr-status sr-approved">✅ Aprovado: a Habilidade foi criada.</p>{{/if}}
  {{#if (eq status "rejected")}}<p class="sr-status sr-rejected">❌ Rejeitado.</p>{{/if}}
  {{#if (eq status "insufficient")}}<p class="sr-status sr-rejected">⚠ Pontos insuficientes no momento da aprovação.</p>{{/if}}
</div>
